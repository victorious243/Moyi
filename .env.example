APP_NAME="Moyi AI CMO"
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/moyi
MONGODB_DB=moyi

# Atlas alternative: use these instead of MONGODB_URI when the password has special characters.
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_USER=moyi_user
# MONGODB_PASSWORD=raw-password-here
# MONGODB_QUERY=retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_SECRET=replace-with-a-long-random-secret

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=auto
CONTENT_IMAGE_STORAGE_PROVIDER=machine
CONTENT_IMAGE_STORAGE_PATH=/var/lib/moyi/content-images
# S3-compatible storage for generated images, uploaded images, and project logos.
# Set CONTENT_IMAGE_STORAGE_PROVIDER=s3 to use these.
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
CONTENT_AI_TIMEOUT_MS=60000
CONTENT_PIPELINE_CONCURRENCY=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# One-click social connections. Configure matching callback URLs in each provider app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/integrations/social/linkedin/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/integrations/social/x/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/integrations/social/meta/callback

APP_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
COOKIE_DOMAIN=
RELEASE_SHA=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring EUR prices: Starter 49, Pro 129, Agency 299.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
# Yearly recurring EUR prices: Starter 490, Pro 1290, Agency 2990.
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=

DISABLE_QUEUE=true
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
CRAWL_TIMEOUT_MS=12000
CRAWL_DELAY_MS=150
MAX_PAGES_PER_SCAN=50


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM=""
EMAIL_TEST_TO=
SUPPORT_EMAIL=
