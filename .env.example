APP_NAME="Moyi AI CMO"
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/moyi
MONGODB_DB=moyi

# Atlas alternative: use these instead of MONGODB_URI when the password has special characters.
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_USER=moyi_user
# MONGODB_PASSWORD=raw-password-here
# MONGODB_QUERY=retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_SECRET=replace-with-a-long-random-secret

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=auto
CONTENT_IMAGE_STORAGE_PROVIDER=machine
CONTENT_IMAGE_STORAGE_PATH=/var/lib/moyi/content-images
# S3-compatible storage for generated images, uploaded images, and project logos.
# Set CONTENT_IMAGE_STORAGE_PROVIDER=s3 to use these.
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Phase 2 social media originals and generated variants. S3_ENDPOINT may be an R2 endpoint.
MEDIA_STORAGE_PROVIDER=machine
MEDIA_STORAGE_PATH=./storage/social-media
MEDIA_UPLOAD_TEMP_PATH=./storage/media-uploads
MEDIA_MAX_UPLOAD_MB=512
MEDIA_PUBLIC_URL_TTL_SECONDS=86400
MEDIA_WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CONTENT_AI_TIMEOUT_MS=60000
CONTENT_PIPELINE_CONCURRENCY=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# Paid acquisition. Google Ads may reuse the same OAuth web client, but it uses
# a separate callback and consent grant because the adwords scope is different.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/projects/paid-ads/google_ads/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# One-click social connections. Configure matching callback URLs in each provider app.
BLUESKY_REDIRECT_URI=http://localhost:3000/integrations/social/bluesky/callback
# Required outside localhost. Generate with: npm run generate:bluesky-key
BLUESKY_PRIVATE_JWK=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/integrations/social/linkedin/callback
LINKEDIN_API_VERSION=202607
LINKEDIN_SCOPES=openid profile email w_member_social
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/integrations/social/x/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/integrations/social/meta/callback
META_GRAPH_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-meta-webhook-token
SOCIAL_ENABLE_META=false
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_REDIRECT_URI=http://localhost:3000/projects/paid-ads/meta_ads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/integrations/social/threads/callback
THREADS_GRAPH_VERSION=v1.0
SOCIAL_ENABLE_THREADS=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/integrations/social/tiktok/callback
TIKTOK_APP_AUDITED=false
SOCIAL_ENABLE_TIKTOK=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/integrations/social/youtube/callback
YOUTUBE_API_AUDITED=false
SOCIAL_ENABLE_YOUTUBE=false

APP_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
COOKIE_DOMAIN=
RELEASE_SHA=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring EUR prices: Starter 49, Pro 129, Agency 299.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
# Yearly recurring EUR prices: Starter 490, Pro 1290, Agency 2990.
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=

DISABLE_QUEUE=true
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
CRAWL_TIMEOUT_MS=12000
CRAWL_DELAY_MS=150
MAX_PAGES_PER_SCAN=50


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM="Moyi-CMO <no_reply@moyi-cmo.com>"
EMAIL_TEST_TO=customersupport@moyi-cmo.com
SUPPORT_EMAIL=customersupport@moyi-cmo.com
