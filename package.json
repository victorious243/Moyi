{
  "name": "moyi",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:distribution": "tsc -p tsconfig.distribution.json",
    "typecheck": "tsc -p tsconfig.distribution.json --noEmit",
    "prestart": "npm run build:distribution",
    "start": "node ./bin/supervisor",
    "preweb": "npm run build:distribution",
    "web": "node ./bin/www",
    "predev": "npm run build:distribution",
    "dev": "DISABLE_QUEUE=true nodemon --ext js,mts,ejs ./bin/www",
    "preworker": "npm run build:distribution",
    "worker": "node ./workers/scanWorker.js",
    "check:social": "node ./scripts/check-social-readiness.js",
    "migrate:distribution": "node ./scripts/migrate-content-distribution.js",
    "generate:bluesky-key": "node ./scripts/generate-bluesky-key.mjs",
    "pretest": "npm run build:distribution",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@atproto/api": "^0.20.39",
    "@atproto/oauth-client-node": "^0.5.3",
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/lib-storage": "^3.1109.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "http-errors": "~1.6.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^15.0.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.42.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
