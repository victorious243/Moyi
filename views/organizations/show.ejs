<%- include('../partials/header') %>

<%
  const agency = typeof agencyDashboard !== 'undefined' ? agencyDashboard : { usagePool: {}, totals: {}, clients: [], roleCapabilities: [] };
  const pool = agency.usagePool || {};
  const socialPool = pool.socialPosts || { used: 0, allowed: 0, remaining: 0, extraCredits: 0 };
  const agencyTotals = agency.totals || {};
  const formatNumber = (value) => Number(value || 0).toLocaleString();
  const formatPool = (item) => item && item.allowed ? `${formatNumber(item.used)} / ${formatNumber(item.allowed)}` : 'Unavailable';
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong><%= organization.name %></strong>
    <a href="/organizations">Agency Workspaces</a>
    <a class="active" href="/organizations/<%= organization._id %>">Clients & Team</a>
    <a href="/projects">All Projects</a>
  </aside>

  <section class="app-main">
    <div class="row-actions" style="margin-bottom: 18px;"><a class="button button-primary" href="/organizations/<%= organization._id %>/calendar">Open Portfolio Calendar</a></div>
    <div class="page-heading">
      <div><p class="eyebrow"><%= organizationRole %> access</p><h1><%= organization.name %></h1><p>Client workspaces, social destinations, and publishing permissions stay separated inside this portfolio.</p></div>
    </div>

    <% if (message) { %><div class="image-success-message"><%= message %></div><% } %>
    <% if (errorMessage) { %><div class="form-error"><%= errorMessage %></div><% } %>

    <section class="studio-summary" aria-label="Agency summary">
      <div><span>Clients</span><strong><%= projects.length %></strong></div>
      <div><span>Team</span><strong><%= members.length %></strong></div>
      <div><span>Connected Accounts</span><strong><%= formatNumber(agencyTotals.connectedAccounts) %></strong></div>
      <div><span>Waiting review</span><strong><%= formatNumber(agencyTotals.pendingReview) %></strong></div>
      <div><span>Changes requested</span><strong><%= formatNumber(agencyTotals.changesRequested) %></strong></div>
      <div><span>Scheduled this week</span><strong><%= formatNumber(agencyTotals.scheduledPosts) %></strong></div>
      <div><span>Blocked posts</span><strong><%= formatNumber(agencyTotals.calendarFailures) %></strong></div>
      <div><span>Clients needing attention</span><strong><%= formatNumber(agencyTotals.attentionClients) %></strong></div>
      <div><span>Failed publications (30d)</span><strong><%= formatNumber(agencyTotals.failedJobs) %></strong></div>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Agency usage pool</h2>
          <p>Usage is pooled under the agency owner plan for this workspace.</p>
        </div>
        <span class="status"><%= pool.planName || 'Free' %></span>
      </div>
      <div class="studio-summary" aria-label="Agency usage pool">
        <div><span>Social posts</span><strong><%= formatPool(socialPool) %></strong></div>
        <div><span>Remaining</span><strong><%= formatNumber(socialPool.remaining) %></strong></div>
        <div><span>Content drafts</span><strong><%= formatPool(pool.contentDrafts) %></strong></div>
        <div><span>AI reports</span><strong><%= formatPool(pool.aiReports) %></strong></div>
      </div>
      <p class="empty">Owner: <%= pool.owner ? `${pool.owner.name || pool.owner.email} (${pool.owner.email})` : 'Unknown' %><% if (socialPool.extraCredits) { %> - includes <%= formatNumber(socialPool.extraCredits) %> extra social post credit<%= socialPool.extraCredits === 1 ? '' : 's' %><% } %></p>
    </section>

    <% if (canManageOrganization && assignableProjects.length) { %>
      <section class="panel">
        <div class="panel-title"><div><h2>Add client project</h2><p>Only projects you own and that are not already assigned can be added.</p></div></div>
        <form class="form" action="/organizations/<%= organization._id %>/projects" method="post">
          <label>Project
            <select name="projectId" required>
              <% assignableProjects.forEach((project) => { %><option value="<%= project._id %>"><%= project.name %> - <%= project.websiteUrl %></option><% }) %>
            </select>
          </label>
          <button class="button button-primary" type="submit">Add Client Project</button>
        </form>
      </section>
    <% } %>

    <section class="panel">
      <div class="panel-title"><div><h2>Client workspaces</h2><p>Connected accounts and engagement data remain attached to each client project.</p></div><span class="status"><%= projects.length %></span></div>
      <% if (!projects.length) { %>
        <p class="empty">No client projects are assigned yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Client</th><th>Website</th><th>Publishing</th><th>Performance</th><% if (canManageOrganization) { %><th></th><% } %></tr></thead>
            <tbody>
              <% projects.forEach((project) => { %>
                <tr>
                  <td><strong><a href="/projects/<%= project._id %>"><%= project.name %></a></strong></td>
                  <td><%= project.websiteUrl %></td>
                  <td><a class="button button-small" href="/projects/<%= project._id %>/calendar">Calendar</a></td>
                  <td><a class="button button-small" href="/projects/<%= project._id %>/social-performance">Analytics</a></td>
                  <% if (canManageOrganization) { %>
                    <td>
                      <% if (String(project.owner) === String(currentUserId)) { %>
                        <form action="/organizations/<%= organization._id %>/projects/<%= project._id %>/remove" method="post" onsubmit="return confirm('Remove this client project from the agency workspace?');">
                          <button class="button button-small" type="submit">Remove</button>
                        </form>
                      <% } %>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Client reporting dashboard</h2>
          <p>Portfolio health across approvals, publishing, connected accounts, and engagement collection.</p>
        </div>
        <span class="status"><%= formatNumber(agencyTotals.measuredPosts) %> measured</span>
      </div>
      <% if (!agency.clients.length) { %>
        <p class="empty">Client reporting appears after projects are added to this agency workspace.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Client</th><th>Accounts</th><th>Approval Queue</th><th>Published 30d</th><th>Measured</th><th>Issues</th><th>Reports</th></tr></thead>
            <tbody>
              <% agency.clients.forEach((client) => { %>
                <tr>
                  <td><strong><a href="/projects/<%= client.projectId %>"><%= client.name %></a></strong><br><small><%= client.websiteUrl %></small></td>
                  <td>
                    <%= formatNumber(client.connectedAccounts) %>
                    <% if (client.platforms.length) { %><br><small><%= client.platforms.join(', ') %></small><% } %>
                  </td>
                  <td><%= formatNumber(client.approvedDrafts) %></td>
                  <td><%= formatNumber(client.publishedPosts) %></td>
                  <td><%= formatNumber(client.measuredPosts) %></td>
                  <td>
                    <% if (client.reconnectRequired || client.failedJobs) { %>
                      <span class="status publish-status-failed"><%= formatNumber(client.reconnectRequired + client.failedJobs) %> issue<%= client.reconnectRequired + client.failedJobs === 1 ? '' : 's' %></span>
                    <% } else { %>
                      <span class="status status-success">Clear</span>
                    <% } %>
                  </td>
                  <td><a class="button button-small" href="/projects/<%= client.projectId %>/social-performance">Dashboard</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <% if (canManageOrganization) { %>
      <section class="panel">
        <div class="panel-title"><div><h2>Add team member</h2><p>Reviewers approve work, publishers send approved posts, and analysts have read-only access.</p></div></div>
        <form class="form" action="/organizations/<%= organization._id %>/members" method="post">
          <label>Email <input type="email" name="email" autocomplete="email" required></label>
          <label>Role
            <select name="role" required>
              <option value="analyst">Analyst - read only</option>
              <option value="reviewer">Reviewer - comment and approve</option>
              <option value="publisher">Publisher - publish approved drafts</option>
              <option value="admin">Admin - manage clients and team</option>
            </select>
          </label>
          <button class="button button-primary" type="submit">Add Team Member</button>
        </form>
      </section>
    <% } %>

    <section class="panel">
      <div class="panel-title"><div><h2>Portfolio team</h2><p>These roles apply to every client project in this agency workspace.</p></div><span class="status"><%= members.length %></span></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>User</th><th>Role</th><th>Joined</th><% if (canManageOrganization) { %><th></th><% } %></tr></thead>
          <tbody>
            <% members.forEach((member) => { %>
              <tr>
                <td><%= member.userId ? `${member.userId.name} (${member.userId.email})` : 'Unknown user' %></td>
                <td><span class="status"><%= member.role %></span></td>
                <td><%= member.joinedAt ? new Date(member.joinedAt).toLocaleString() : '' %></td>
                <% if (canManageOrganization) { %>
                  <td>
                    <% if (member.role !== 'owner') { %>
                      <form action="/organizations/<%= organization._id %>/members/<%= member._id %>/remove" method="post" onsubmit="return confirm('Remove this person from the agency workspace?');">
                        <button class="button button-small" type="submit">Remove</button>
                      </form>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-title"><div><h2>Approval and access roles</h2><p>Use roles to separate client reporting, approval, publishing, account management, and billing access.</p></div></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Role</th><th>Approve</th><th>Publish</th><th>Accounts</th><th>Reports</th><th>Billing pool</th></tr></thead>
          <tbody>
            <% agency.roleCapabilities.forEach((role) => { %>
              <tr>
                <td><strong><%= role.role %></strong></td>
                <td><%= role.approval ? 'Yes' : 'No' %></td>
                <td><%= role.publishing ? 'Yes' : 'No' %></td>
                <td><%= role.accounts ? 'Yes' : 'No' %></td>
                <td><%= role.reporting ? 'Yes' : 'No' %></td>
                <td><%= role.billing ? 'Owner only' : 'No' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
