<%- include('../partials/header') %>

<section class="auth-panel">
  <h1>Reset password</h1>
  <% if (errorMessage) { %>
    <section class="panel notice-panel auth-notice">
      <h2>Password reset issue</h2>
      <p class="empty"><%= errorMessage %></p>
    </section>
  <% } %>
  <form class="form" action="/forgot-password" method="post">
    <label>Email <input type="email" name="email" autocomplete="email" required></label>
    <button class="button button-primary" type="submit">Send reset link</button>
  </form>
  <p class="empty"><a href="/login">Return to sign in</a></p>
</section>

<%- include('../partials/footer') %>
