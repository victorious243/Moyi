<%- include('../partials/header') %>

<section class="auth-panel">
  <h1>Check your email</h1>
  <p class="empty">If an account exists for that email, a password reset link has been sent. The link expires in one hour.</p>
  <% if (resetUrl) { %>
    <section class="panel notice-panel auth-notice">
      <h2>Development reset link</h2>
      <p class="empty"><a href="<%= resetUrl %>"><%= resetUrl %></a></p>
      <% if (typeof resetPin !== 'undefined' && resetPin) { %>
        <p class="empty">Development PIN: <strong><%= resetPin %></strong></p>
      <% } %>
    </section>
  <% } %>
  <a class="button" href="/login">Back to sign in</a>
</section>

<%- include('../partials/footer') %>
