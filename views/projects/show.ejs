<%- include('../partials/header') %>

<%
  const hasScan = Boolean(latestScan);
  const hasReport = Boolean(latestReport && latestReport.status !== 'failed');
  const primaryAction = workspace.primaryAction;
  const queueCount = workspace.recommendationCounts.open + workspace.draftCounts.awaitingReview + workspace.draftCounts.needsRevision + workspace.draftCounts.approved;
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a class="active" href="/projects/<%= project._id %>">CMO Workspace</a>
    <span class="sidebar-divider"></span>
    <a href="/projects/<%= project._id %>/ai-report/latest">Strategy brief</a>
    <a href="/projects/<%= project._id %>/recommendations">Recommendations</a>
    <a href="/projects/<%= project._id %>/content">Content Studio</a>
    <a href="/projects/<%= project._id %>/calendar">Content Calendar</a>
    <a href="/projects/<%= project._id %>/campaigns">Campaigns</a>
    <a href="/projects/<%= project._id %>/search-console/performance">Search performance</a>
    <a href="/projects/<%= project._id %>/tracking/setup">Tracking setup</a>
    <a href="/projects/<%= project._id %>/analytics">Analytics</a>
    <a href="/projects/<%= project._id %>/reports">Reports</a>
    <a href="/projects/<%= project._id %>/competitors">Competitors</a>
    <a href="/projects/<%= project._id %>/team">Team</a>
  </aside>

  <section class="app-main project-detail-main">
    <section class="project-main-card project-workspace-card">
      <div class="project-hero-content workspace-hero-copy">
        <p class="eyebrow project-badge"><%= project.industry || 'CMO workspace' %></p>
        <h1><%= project.name %></h1>
        <a class="project-url" href="<%= project.websiteUrl %>" target="_blank" rel="noreferrer"><%= project.websiteUrl %></a>
        <p class="project-hero-summary"><%= project.mainGoal || project.targetAudience || 'Set a clear growth goal so the workspace can prioritize the right work.' %></p>

        <div class="workspace-hero-signals">
          <article>
            <span>Main business risk</span>
            <strong><%= workspace.businessRisk %></strong>
          </article>
          <article>
            <span>Main growth opportunity</span>
            <strong><%= workspace.growthOpportunity %></strong>
          </article>
        </div>
      </div>

      <div class="project-card-aside workspace-hero-aside">
        <div class="coverage-cup" style="--score:<%= workspace.overallScore %>%">
          <div class="coverage-cup-vessel" aria-hidden="true">
            <span class="coverage-cup-fill"></span>
            <strong><%= workspace.overallScore %></strong>
          </div>
          <span>Coverage</span>
        </div>
        <p><%= hasReport ? 'The workspace has strategy context. Keep moving the right work through review and measurement.' : (hasScan ? 'The evidence exists, but strategy still needs to be generated from it.' : 'The workspace is still missing factual website evidence.') %></p>
        <dl class="workspace-mini-facts">
          <div><dt>Queue</dt><dd><%= queueCount %> active items</dd></div>
          <div><dt>Telemetry</dt><dd><%= telemetry.score %>% checklist</dd></div>
          <div><dt>Search Console</dt><dd><%= connectedProperty ? 'Connected' : 'Not connected' %></dd></div>
          <div><dt>Competitors</dt><dd><%= workspace.competitorCount %> tracked</dd></div>
        </dl>
      </div>

      <div class="project-next-step workspace-next-step">
        <div>
          <p class="eyebrow"><%= primaryAction.eyebrow %></p>
          <h2><%= primaryAction.title %></h2>
          <p><%= primaryAction.body %></p>
        </div>
        <div class="project-next-actions">
          <% if (primaryAction.action.method === 'post') { %>
            <form action="<%= primaryAction.action.href %>" method="post" data-loading-state="<%= primaryAction.action.loadingState %>">
              <button class="button button-primary" type="submit"><%= primaryAction.action.label %></button>
            </form>
          <% } else { %>
            <a class="button button-primary" href="<%= primaryAction.action.href %>"><%= primaryAction.action.label %></a>
          <% } %>
          <a class="button" href="/projects/<%= project._id %>/content">Content Studio</a>
          <a class="button" href="/projects/<%= project._id %>/calendar">Calendar</a>
          <a class="button" href="/projects/<%= project._id %>/edit">Edit project</a>
        </div>
      </div>
    </section>

    <% if (aiError) { %>
      <section class="panel notice-panel">
        <h2>AI CMO plan unavailable</h2>
        <p class="empty"><%= aiError %></p>
      </section>
    <% } %>

    <% if (limitMessage) { %>
      <section class="panel notice-panel">
        <h2>Plan limit reached</h2>
        <p class="empty"><%= limitMessage %></p>
        <a class="button button-primary" href="/pricing">Upgrade</a>
      </section>
    <% } %>

    <% if (telemetry.autonomousActionsBlocked) { %>
      <section class="panel notice-panel">
        <h2>Measurement caution</h2>
        <p class="empty">Telemetry health is still below the review threshold, so measurement-driven recommendations should be checked carefully before acting on them.</p>
      </section>
    <% } %>

    <section class="metrics project-info-grid workspace-scorecard-grid">
      <% workspace.scorecards.forEach((card) => { %>
        <article class="project-info-card workspace-score-card">
          <span><%= card.label %></span>
          <strong><%= card.score %>%</strong>
          <p><%= card.detail %></p>
        </article>
      <% }) %>
    </section>

    <section class="section-label">
      <p class="eyebrow">CMO Workspace</p>
      <h2>What matters this week</h2>
    </section>

    <div class="workspace-grid">
      <section class="panel workspace-panel">
        <div class="panel-title">
          <h2>Top priorities</h2>
          <a href="/projects/<%= project._id %>/recommendations">Full queue</a>
        </div>
        <% if (!workspace.topPriorities.length) { %>
          <p class="empty">Run a scan and generate the plan to surface ranked priorities.</p>
        <% } %>
        <div class="recommendation-grid workspace-priority-grid">
          <% workspace.topPriorities.forEach((priority) => { %>
            <article class="recommendation-card workspace-priority-card">
              <span class="status"><%= priority.badge %></span>
              <h2><%= priority.title %></h2>
              <p><%= priority.body %></p>
              <a href="<%= priority.href %>">Open context</a>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="panel workspace-panel">
        <div class="panel-title">
          <h2>This week’s plan</h2>
          <a href="/projects/<%= project._id %>/reports">Reporting cadence</a>
        </div>
        <ol class="workspace-plan-list">
          <% workspace.thisWeekPlan.forEach((step) => { %>
            <li class="workspace-plan-item">
              <div>
                <strong><%= step.title %></strong>
                <p><%= step.detail %></p>
              </div>
              <% if (step.action.method === 'post') { %>
                <form action="<%= step.action.href %>" method="post" data-loading-state="<%= step.action.loadingState %>">
                  <button class="button" type="submit"><%= step.action.label %></button>
                </form>
              <% } else { %>
                <a class="button" href="<%= step.action.href %>"><%= step.action.label %></a>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </section>

      <section class="panel workspace-panel">
        <div class="panel-title">
          <h2>Measurement gaps</h2>
          <a href="/projects/<%= project._id %>/tracking/setup">Fix setup</a>
        </div>
        <% if (!workspace.measurementGaps.length) { %>
          <p class="empty">The measurement foundation is in decent shape. Keep validating outcomes through reports and search performance.</p>
        <% } else { %>
          <ul class="clean-list workspace-note-list">
            <% workspace.measurementGaps.forEach((gap) => { %>
              <li>
                <strong><%= gap.title %></strong>
                <span><%= gap.detail %></span>
                <a href="<%= gap.href %>">Resolve</a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="panel workspace-panel">
        <div class="panel-title">
          <h2>Execution queue</h2>
          <a href="/projects/<%= project._id %>/content">Approval queue</a>
        </div>
        <% if (!workspace.executionQueue.length) { %>
          <p class="empty">There is no active queue yet. Once recommendations are accepted or drafts are created, this becomes the execution control panel.</p>
        <% } else { %>
          <div class="work-queue">
            <% workspace.executionQueue.forEach((item) => { %>
              <a href="<%= item.href %>">
                <strong><%= item.title %></strong>
                <span><%= item.detail %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>

    <section class="section-label">
      <p class="eyebrow">Focus Areas</p>
      <h2>Quick wins and strategic bet</h2>
    </section>

    <div class="dashboard-grid project-overview-grid workspace-focus-grid">
      <section class="panel workspace-panel">
        <div class="panel-title">
          <h2>Quick wins</h2>
          <a href="/projects/<%= project._id %>/recommendations">Open queue</a>
        </div>
        <% if (!workspace.quickWins.length) { %>
          <p class="empty">No quick wins are visible yet. They will appear once the workspace has enough evidence.</p>
        <% } %>
        <ul class="clean-list workspace-note-list">
          <% workspace.quickWins.forEach((item) => { %>
            <li>
              <strong><%= item.title %></strong>
              <span><%= item.detail %></span>
              <a href="<%= item.href %>">Review</a>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="panel workspace-panel workspace-bet-panel">
        <div class="panel-title">
          <h2>Strategic bet</h2>
          <a href="<%= workspace.strategicBet.href %>">Open context</a>
        </div>
        <p class="workspace-bet-title"><%= workspace.strategicBet.title %></p>
        <p><%= workspace.strategicBet.body %></p>
      </section>
    </div>

    <section class="section-label">
      <p class="eyebrow">Business context</p>
      <h2>Positioning and market picture</h2>
    </section>

    <div class="dashboard-grid project-overview-grid">
      <section class="panel workspace-panel">
        <h2>Business context</h2>
        <dl class="detail-list">
          <div><dt>Audience</dt><dd><%= project.targetAudience || 'Not set yet.' %></dd></div>
          <div><dt>Main goal</dt><dd><%= project.mainGoal || 'Not set yet.' %></dd></div>
          <div><dt>Main offer</dt><dd><%= project.mainOffer || 'Not set yet.' %></dd></div>
          <div><dt>Country</dt><dd><%= project.targetCountry || 'Global' %></dd></div>
          <div><dt>Conversion goals</dt><dd><%= conversionGoalCount ? conversionGoalCount : 'Not defined yet' %></dd></div>
        </dl>
      </section>

      <section class="panel workspace-panel">
        <h2>Market context</h2>
        <% if (!(project.competitors || []).length) { %>
          <p class="empty">No competitors added yet. Discovery will improve once more evidence is gathered.</p>
        <% } %>
        <ul class="clean-list">
          <% (project.competitors || []).slice(0, 6).forEach((competitor) => { %>
            <li><%= typeof competitor === 'string' ? competitor : (competitor.name || competitor.websiteUrl) %></li>
          <% }) %>
        </ul>
      </section>
    </div>

    <section class="panel project-section-panel">
      <div class="panel-title">
        <h2>Latest strategy brief</h2>
        <div class="row-actions">
          <a href="/projects/<%= project._id %>/ai-report/latest">Open brief</a>
          <a href="/projects/<%= project._id %>/recommendations">Recommendations</a>
          <a href="/projects/<%= project._id %>/content">Approval queue</a>
        </div>
      </div>
      <% if (!latestReport) { %>
        <p class="empty">No AI CMO plan generated yet. Run a completed website scan, then generate a plan.</p>
      <% } else if (latestReport.status === 'failed') { %>
        <p class="empty"><%= latestReport.errorMessage || 'The latest AI CMO plan could not be generated.' %></p>
      <% } else { %>
        <p><%= latestReport.executiveSummary %></p>
        <ul class="clean-list">
          <% latestReport.topPriorities.slice(0, 5).forEach((priority) => { %>
            <li><%= priority %></li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="panel project-section-panel">
      <div class="panel-title">
        <h2>Competitor comparison</h2>
        <div class="row-actions">
          <a href="/projects/<%= project._id %>/competitors">Competitors</a>
          <a href="/projects/<%= project._id %>/competitors/insights">Open report</a>
        </div>
      </div>
      <% if (!workspace.competitorCount) { %>
        <p class="empty">No competitors have been identified for this project yet. Running another website scan will retry discovery automatically.</p>
      <% } else if (!latestCompetitorInsights.length) { %>
        <p class="empty">Competitors are tracked, but comparison opportunities have not been generated yet.</p>
      <% } else { %>
        <div class="recommendation-grid">
          <% latestCompetitorInsights.forEach((insight) => { %>
            <article class="recommendation-card">
              <span class="status"><%= insight.category.replace(/_/g, ' ') %> / Priority <%= insight.priority %></span>
              <h2><%= insight.title %></h2>
              <p><strong>What they do better:</strong> <%= insight.insight %></p>
              <p><strong>What to improve:</strong> <%= insight.opportunity %></p>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="section-label">
      <p class="eyebrow">Evidence and cadence</p>
      <h2>Reports and scans</h2>
    </section>

    <section class="history-grid">
      <section class="panel project-section-panel">
        <div class="panel-title">
          <h2>Reports</h2>
          <div class="row-actions">
            <form action="/projects/<%= project._id %>/reports/weekly" method="post" data-loading-state="Generating your weekly report">
              <button class="button" type="submit">Weekly</button>
            </form>
            <form action="/projects/<%= project._id %>/reports/monthly" method="post" data-loading-state="Generating your monthly report">
              <button class="button" type="submit">Monthly</button>
            </form>
            <a href="/projects/<%= project._id %>/reports">History</a>
          </div>
        </div>
        <% if (!recentCmoReports.length) { %>
          <p class="empty">No weekly or monthly AI CMO reports generated yet.</p>
        <% } %>
        <div class="scan-list">
          <% recentCmoReports.forEach((report) => { %>
            <a class="scan-row" href="/projects/<%= project._id %>/reports/<%= report._id %>">
              <span class="scan-status scan-status-report"><i></i><b><%= report.type %></b></span>
              <span><%= report.periodStart %></span>
              <span><%= report.periodEnd %></span>
              <time class="scan-time" datetime="<%= report.createdAt.toISOString() %>">
                <span><%= report.createdAt.toLocaleDateString() %></span>
                <span><%= report.createdAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
              </time>
            </a>
          <% }) %>
        </div>
      </section>

      <section class="panel project-section-panel">
        <div class="panel-title">
          <h2>Scan history</h2>
          <div class="row-actions">
            <a href="/projects/<%= project._id %>/pages">Scanned pages</a>
            <a href="/projects/<%= project._id %>/scans">All scans</a>
          </div>
        </div>
        <% if (!recentScans.length) { %>
          <p class="empty">No website scans yet. Run a scan to collect factual SEO page data.</p>
        <% } %>
        <div class="scan-list">
          <% recentScans.forEach((scan) => { %>
            <a class="scan-row" href="/projects/<%= project._id %>/scans/<%= scan._id %>">
              <span class="scan-status scan-status-<%= scan.status %>">
                <i></i>
                <b><%= scan.status === 'completed' ? 'Done' : (scan.status === 'failed' ? 'Failed' : scan.status) %></b>
              </span>
              <span><%= scan.pagesScanned %> scanned</span>
              <span><%= scan.pagesFound %> found</span>
              <% const scanTime = scan.completedAt || scan.createdAt; %>
              <time class="scan-time" datetime="<%= scanTime.toISOString() %>">
                <span><%= scanTime.toLocaleDateString() %></span>
                <span><%= scanTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
              </time>
            </a>
          <% }) %>
        </div>
      </section>
    </section>

    <section class="project-danger-zone" aria-labelledby="project-danger-title">
      <div>
        <p class="eyebrow">Project management</p>
        <h2 id="project-danger-title">Danger area</h2>
        <p>Deleting removes this project and its workspace entry. Keep this action separate from daily project work.</p>
      </div>
      <form action="/projects/<%= project._id %>/delete" method="post" onsubmit="return confirm('Delete this project? This action cannot be undone.');">
        <button class="button danger-button" type="submit">Delete project</button>
      </form>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
