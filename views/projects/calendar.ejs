<%- include('../partials/header') %>

<%
  const currentImageJob = typeof imageJob !== 'undefined' ? imageJob : null;
  const userCanPublishProject = typeof canPublishProject !== 'undefined' ? canPublishProject : true;
  const userCanManageProject = typeof canManageProject !== 'undefined' ? canManageProject : true;
  const currentFilters = typeof filters !== 'undefined' ? filters : { search: '', status: '', platform: '', campaign: '', account: '', contentType: '', view: 'list', date: '', page: 1 };
  const counts = typeof calendarCounts !== 'undefined' ? calendarCounts : { scheduled: 0, needsAttention: 0, published: 0, drafts: 0, ready: 0, total: 0 };
  const items = typeof calendarItems !== 'undefined' ? calendarItems : [];
  const availableFilters = typeof filterOptions !== 'undefined' ? filterOptions : { platforms: [], campaigns: [], accounts: [], contentTypes: [] };
  const pageInfo = typeof pagination !== 'undefined' ? pagination : { page: 1, pageSize: 50, totalItems: items.length, totalPages: 1 };
  const currentCalendarDays = typeof calendarDays !== 'undefined' ? calendarDays : [];
  const currentCalendarNavigation = typeof calendarNavigation !== 'undefined' ? calendarNavigation : { previous: '', next: '' };
  const currentCalendarRangeTitle = typeof calendarRangeTitle !== 'undefined' ? calendarRangeTitle : '';
  const currentCalendarTimezone = typeof calendarTimezone !== 'undefined' ? calendarTimezone : (project.timezone || 'UTC');
  const currentTodayContext = typeof todayContext !== 'undefined' ? todayContext : null;
  const currentCalendarTruncated = typeof calendarTruncated !== 'undefined' ? calendarTruncated : false;
  const currentPublishReadiness = typeof publishReadiness !== 'undefined' ? publishReadiness : { attentionCount: 0, readyCount: 0, inFlightCount: 0, groups: {} };
%>

<div class="app-layout">
  <%- include('../partials/project-sidebar', { project, activeSection: 'calendar' }) %>

  <section
    class="app-main content-calendar-workspace"
    data-calendar-root
    data-project-id="<%= project._id %>"
    data-calendar-timezone="<%= currentCalendarTimezone %>"
    <% if (currentImageJob && ['queued', 'running'].includes(currentImageJob.status)) { %>
      data-live-job
      data-live-job-endpoint="/projects/<%= project._id %>/jobs/<%= currentImageJob._id %>"
      data-initial-job-status="<%= currentImageJob.status %>"
    <% } %>
  >
    <nav class="project-command-nav" aria-label="Content operations">
      <a href="/projects/<%= project._id %>/content"><strong>Content Studio</strong><span>Create and review</span></a>
      <a class="is-active" href="/projects/<%= project._id %>/calendar"><strong>Calendar</strong><span>Plan and publish</span></a>
      <a href="/projects/<%= project._id %>/campaigns"><strong>Campaigns</strong><span>Track objectives</span></a>
    </nav>

    <header class="calendar-page-header">
      <div class="calendar-heading-copy">
        <p class="eyebrow"><%= project.name %></p>
        <h1>Content Calendar</h1>
        <p>Plan, approve and publish your marketing content.</p>
      </div>
      <div class="calendar-header-actions">
        <a class="button" href="/projects/<%= project._id %>/content#planner">Create Content</a>
        <% if (userCanPublishProject && counts.ready) { %>
          <form action="/social-drafts/publish-all-connected" method="post" data-async-action data-refresh-list>
            <input type="hidden" name="projectId" value="<%= project._id %>">
            <button class="button button-primary" type="submit">Publish Ready</button>
          </form>
        <% } %>
      </div>
    </header>

    <section class="calendar-command-bar" aria-label="Calendar tools">
      <label class="calendar-search">
        <span class="sr-only">Search calendar</span>
        <span aria-hidden="true">⌕</span>
        <input type="search" value="<%= currentFilters.search %>" placeholder="Search content, campaigns, platforms or accounts" autocomplete="off" data-calendar-search>
        <kbd>/</kbd>
      </label>
      <button class="button calendar-filter-toggle" type="button" aria-expanded="false" aria-controls="calendar-results" data-filter-toggle>Filters</button>
      <div class="calendar-view-selector" role="group" aria-label="Calendar view">
        <% [['today','Today'],['week','Week'],['month','Month'],['list','List'],['attention','Attention']].forEach(([value,label]) => { %><button type="button" class="<%= currentFilters.view === value ? 'is-active' : '' %>" data-calendar-view="<%= value %>" aria-pressed="<%= currentFilters.view === value %>"><%= label %><% if (value === 'attention' && currentPublishReadiness.attentionCount) { %> <span><%= currentPublishReadiness.attentionCount %></span><% } %></button><% }) %>
      </div>
    </section>

    <div class="calendar-page-message" aria-live="polite" data-calendar-message>
      <% if (successMessage) { %><div class="image-success-message"><%= successMessage %></div><% } %>
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <% if (typeof limitType !== 'undefined' && limitType === 'social_posts') { %>
          <section class="panel notice-panel limit-notice-panel">
            <div><h2>Social post limit reached</h2><p class="empty"><%= errorMessage %></p></div>
            <div class="row-actions"><a class="button button-primary" href="/billing">Upgrade Plan</a><a class="button" href="/contact">Request Credits</a></div>
          </section>
        <% } else { %><div class="form-error"><%= errorMessage %></div><% } %>
      <% } %>
    </div>

    <% if (currentImageJob && ['queued', 'running'].includes(currentImageJob.status)) { %>
      <section class="calendar-inline-job" role="status">
        <span class="calendar-live-dot"></span>
        <strong>Visual generation in progress</strong>
        <span data-job-step><%= currentImageJob.currentStep || 'Preparing the image' %></span>
        <span data-job-progress><%= currentImageJob.progressPercent || 0 %>%</span>
        <span data-job-status hidden><%= currentImageJob.status %></span>
        <span data-job-last-checked hidden>just now</span>
        <span data-job-error-row hidden><span data-job-error></span></span>
      </section>
    <% } %>

    <div id="calendar-results" data-calendar-results>
      <%- include('partials/calendar-results', {
        project,
        calendarItems: items,
        calendarCounts: counts,
        filters: currentFilters,
        filterOptions: availableFilters,
        pagination: pageInfo,
        calendarDays: currentCalendarDays,
        calendarNavigation: currentCalendarNavigation,
        calendarRangeTitle: currentCalendarRangeTitle,
        calendarTimezone: currentCalendarTimezone,
        todayContext: currentTodayContext,
        calendarTruncated: currentCalendarTruncated,
        publishReadiness: currentPublishReadiness,
        userCanManageProject,
        userCanPublishProject
      }) %>
    </div>
  </section>
</div>

<div class="calendar-drawer-layer" data-calendar-drawer-layer hidden>
  <button class="calendar-drawer-backdrop" type="button" aria-label="Close post details" data-close-drawer></button>
  <aside class="calendar-detail-drawer" role="dialog" aria-modal="true" aria-labelledby="calendar-drawer-title" tabindex="-1" data-calendar-drawer>
    <div class="calendar-drawer-shell" data-calendar-drawer-content>
      <div class="calendar-drawer-loading" role="status"><span></span><p>Loading post details…</p></div>
    </div>
  </aside>
</div>

<div class="calendar-toast-region" aria-live="polite" aria-atomic="true" data-calendar-toasts></div>

<script src="/js/content-calendar.js?v=20260825" defer></script>
<%- include('../partials/footer') %>
