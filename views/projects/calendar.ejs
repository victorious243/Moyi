<%- include('../partials/header') %>
<link rel="stylesheet" href="/stylesheets/content-calendar.css?v=20260826">

<%
  const currentImageJob = typeof imageJob !== 'undefined' ? imageJob : null;
  const userCanPublishProject = typeof canPublishProject !== 'undefined' ? canPublishProject : true;
  const userCanManageProject = typeof canManageProject !== 'undefined' ? canManageProject : true;
  const userCanReviewDrafts = typeof canReviewDraft !== 'undefined' ? canReviewDraft : userCanManageProject;
  const teamMode = typeof teamCollaborationEnabled !== 'undefined' ? teamCollaborationEnabled : false;
  const currentFilters = typeof filters !== 'undefined' ? filters : { search: '', status: '', platform: '', campaign: '', account: '', contentType: '', approval: '', owner: '', view: 'list', date: '', page: 1 };
  const counts = typeof calendarCounts !== 'undefined' ? calendarCounts : { scheduled: 0, needsAttention: 0, published: 0, drafts: 0, ready: 0, total: 0 };
  const items = typeof calendarItems !== 'undefined' ? calendarItems : [];
  const availableFilters = typeof filterOptions !== 'undefined' ? filterOptions : { platforms: [], campaigns: [], accounts: [], contentTypes: [], owners: [] };
  const pageInfo = typeof pagination !== 'undefined' ? pagination : { page: 1, pageSize: 50, totalItems: items.length, totalPages: 1 };
  const currentCalendarDays = typeof calendarDays !== 'undefined' ? calendarDays : [];
  const currentCalendarNavigation = typeof calendarNavigation !== 'undefined' ? calendarNavigation : { previous: '', next: '' };
  const currentCalendarRangeTitle = typeof calendarRangeTitle !== 'undefined' ? calendarRangeTitle : '';
  const currentCalendarTimezone = typeof calendarTimezone !== 'undefined' ? calendarTimezone : (project.timezone || 'UTC');
  const currentTodayContext = typeof todayContext !== 'undefined' ? todayContext : null;
  const currentCalendarTruncated = typeof calendarTruncated !== 'undefined' ? calendarTruncated : false;
  const currentPublishReadiness = typeof publishReadiness !== 'undefined' ? publishReadiness : { attentionCount: 0, readyCount: 0, inFlightCount: 0, groups: {} };
  const currentCalendarIntelligence = typeof calendarIntelligence !== 'undefined' ? calendarIntelligence : { featured: [], insights: [], contentMix: [], campaignCoverage: [], dataQuality: { status: 'insufficient', message: 'Moyi needs more published-post performance data before it can recommend your best posting times.' } };
%>

<div class="app-layout">
  <%- include('../partials/project-sidebar', { project, activeSection: 'calendar' }) %>

  <section
    class="app-main content-calendar-workspace project-content-workspace"
    data-calendar-root
    data-project-id="<%= project._id %>"
    data-calendar-timezone="<%= currentCalendarTimezone %>"
    <% if (currentImageJob && ['queued', 'running'].includes(currentImageJob.status)) { %>
      data-live-job
      data-live-job-endpoint="/projects/<%= project._id %>/jobs/<%= currentImageJob._id %>"
      data-initial-job-status="<%= currentImageJob.status %>"
    <% } %>
  >
    <%- include('../partials/project-content-nav', { project, activeSection: 'calendar' }) %>

    <header class="calendar-page-header">
      <div class="calendar-heading-copy">
        <p class="eyebrow"><%= project.name %></p>
        <h1>Content Calendar</h1>
        <p class="calendar-subtitle">Plan, review and publish your marketing content.</p>
        <div class="calendar-header-kpis" aria-label="Overview metrics">
          <span class="cal-kpi-item"><strong><%= counts.scheduled %></strong> Scheduled</span>
          <span class="cal-kpi-dot">·</span>
          <span class="cal-kpi-item <%= counts.needsAttention ? 'has-alert' : '' %>"><strong><%= counts.needsAttention %></strong> Need attention</span>
          <span class="cal-kpi-dot">·</span>
          <span class="cal-kpi-item"><strong><%= counts.published %></strong> Published</span>
          <span class="cal-kpi-dot">·</span>
          <span class="cal-kpi-item"><strong><%= counts.drafts %></strong> Drafts</span>
        </div>
      </div>
      <div class="calendar-header-actions">
        <a class="button button-create" href="/projects/<%= project._id %>/content#planner">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
          <span>Create Content</span>
        </a>
        <% if (userCanPublishProject && counts.ready) { %>
          <form action="/social-drafts/publish-all-connected" method="post" data-async-action data-refresh-list data-global-publish-form data-ready-count="<%= currentPublishReadiness.readyCount %>" data-blocked-count="<%= currentPublishReadiness.attentionCount %>" data-processing-count="<%= currentPublishReadiness.inFlightCount %>">
            <input type="hidden" name="projectId" value="<%= project._id %>">
            <button class="button button-primary button-publish-ready" type="submit">
              <span class="ready-pulse"></span>
              <span>Publish <%= currentPublishReadiness.readyCount %> Ready</span>
            </button>
          </form>
        <% } %>
      </div>
    </header>

    <section class="calendar-command-bar" aria-label="Calendar tools">
      <div class="calendar-command-left">
        <label class="calendar-search">
          <span class="sr-only">Search calendar</span>
          <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7.33333 12.6667C10.2789 12.6667 12.6667 10.2789 12.6667 7.33333C12.6667 4.38781 10.2789 2 7.33333 2C4.38781 2 2 4.38781 2 7.33333C2 10.2789 4.38781 12.6667 7.33333 12.6667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 14L11.1 11.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <input type="search" value="<%= currentFilters.search %>" placeholder="Search content, campaigns, platforms..." autocomplete="off" data-calendar-search>
          <kbd>/</kbd>
        </label>
        <button class="button calendar-filter-toggle" type="button" aria-expanded="false" aria-controls="calendar-results" data-filter-toggle>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2 3.5H14M4 8H12M6.5 12.5H9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Filters</span>
        </button>
      </div>
      <div class="calendar-view-selector" role="group" aria-label="Calendar view">
        <% [['today','Today'],['week','Week'],['month','Month'],['list','List'],['attention','Attention']].forEach(([value,label]) => { %>
          <button type="button" class="<%= currentFilters.view === value ? 'is-active' : '' %> <%= value === 'attention' && currentPublishReadiness.attentionCount ? 'has-attention-badge' : '' %>" data-calendar-view="<%= value %>" aria-pressed="<%= currentFilters.view === value %>">
            <span><%= label %></span><% if (value === 'attention' && currentPublishReadiness.attentionCount) { %><span class="attention-count-badge"><%= currentPublishReadiness.attentionCount %></span><% } %>
          </button>
        <% }) %>
      </div>
    </section>

    <div class="calendar-page-message" aria-live="polite" data-calendar-message>
      <% if (successMessage) { %><div class="image-success-message"><%= successMessage %></div><% } %>
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <% if (typeof limitType !== 'undefined' && limitType === 'social_posts') { %>
          <section class="panel notice-panel limit-notice-panel">
            <div><h2>Social post limit reached</h2><p class="empty"><%= errorMessage %></p></div>
            <div class="row-actions"><a class="button button-primary" href="/billing">Upgrade Plan</a><a class="button" href="/contact">Request Credits</a></div>
          </section>
        <% } else { %><div class="form-error"><%= errorMessage %></div><% } %>
      <% } %>
    </div>

    <% if (currentImageJob && ['queued', 'running'].includes(currentImageJob.status)) { %>
      <section class="calendar-inline-job" role="status">
        <span class="calendar-live-dot"></span>
        <strong>Visual generation in progress</strong>
        <span data-job-step><%= currentImageJob.currentStep || 'Preparing the image' %></span>
        <span data-job-progress><%= currentImageJob.progressPercent || 0 %>%</span>
        <span data-job-status hidden><%= currentImageJob.status %></span>
        <span data-job-last-checked hidden>just now</span>
        <span data-job-error-row hidden><span data-job-error></span></span>
      </section>
    <% } %>

    <div id="calendar-results" data-calendar-results>
      <%- include('partials/calendar-results', {
        project,
        calendarItems: items,
        calendarCounts: counts,
        filters: currentFilters,
        filterOptions: availableFilters,
        pagination: pageInfo,
        calendarDays: currentCalendarDays,
        calendarNavigation: currentCalendarNavigation,
        calendarRangeTitle: currentCalendarRangeTitle,
        calendarTimezone: currentCalendarTimezone,
        todayContext: currentTodayContext,
        calendarTruncated: currentCalendarTruncated,
        publishReadiness: currentPublishReadiness,
        calendarIntelligence: currentCalendarIntelligence,
        userCanManageProject,
        userCanReviewDrafts,
        userCanPublishProject,
        teamCollaborationEnabled: teamMode
      }) %>
    </div>
  </section>
</div>

<div class="calendar-drawer-layer" data-calendar-drawer-layer hidden>
  <button class="calendar-drawer-backdrop" type="button" aria-label="Close post details" data-close-drawer></button>
  <aside class="calendar-detail-drawer" role="dialog" aria-modal="true" aria-labelledby="calendar-drawer-title" tabindex="-1" data-calendar-drawer>
    <div class="calendar-drawer-shell" data-calendar-drawer-content>
      <div class="calendar-drawer-loading" role="status"><span></span><p>Loading post details…</p></div>
    </div>
  </aside>
</div>

<div class="calendar-toast-region" aria-live="polite" aria-atomic="true" data-calendar-toasts></div>

<script src="/js/content-calendar.js?v=20260825" defer></script>
<%- include('../partials/footer') %>
