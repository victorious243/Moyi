<%
  const connectedAccounts = typeof socialAccounts !== 'undefined' ? socialAccounts : [];
  const nativeAccounts = typeof publishAccounts !== 'undefined' ? publishAccounts : connectedAccounts;
  const projectNames = typeof accountProjectNames !== 'undefined' ? accountProjectNames : {};
  const images = typeof socialImages !== 'undefined' ? socialImages : [];
  const assets = typeof mediaAssets !== 'undefined' ? mediaAssets : [];
  const jobs = typeof publishJobs !== 'undefined' ? publishJobs : [];
  const events = typeof eventsByJobId !== 'undefined' ? eventsByJobId : {};
  const canManage = typeof canManageProject !== 'undefined' ? canManageProject : false;
  const canEdit = typeof canEditDraft !== 'undefined' ? canEditDraft : canManage;
  const canReview = typeof canReviewDraft !== 'undefined' ? canReviewDraft : canManage;
  const canPublish = typeof canPublishProject !== 'undefined' ? canPublishProject : false;
  const isClientReview = typeof clientReviewMode !== 'undefined' ? clientReviewMode : false;
  const currentReviewStatus = typeof reviewStatus !== 'undefined' ? reviewStatus : 'draft';
  const currentReviewLabel = typeof reviewStatusLabel !== 'undefined' ? reviewStatusLabel : 'Draft';
  const draftComments = typeof comments !== 'undefined' ? comments : [];
  const draftActivities = typeof activities !== 'undefined' ? activities : [];
  const draftCollaborators = typeof collaborators !== 'undefined' ? collaborators : [];
  const draftCampaign = typeof campaign !== 'undefined' ? campaign : null;
  const status = typeof calendarStatus !== 'undefined' ? calendarStatus : { uiStatus: 'draft', statusLabel: 'Draft', statusTone: 'neutral', blockers: [], blocker: '' };
  const selectedImage = images.find((image) => image.status === 'selected' || String(image._id) === String(draft.contentImageId || ''));
  const inheritedImageUrl = draft.contentImageId && draft.sourceContentDraftId && !selectedImage ? `/content/${draft.sourceContentDraftId}/images/${draft.contentImageId}/file` : '';
  const selectedImageUrl = selectedImage ? `/social-drafts/${draft._id}/images/${selectedImage._id}/file` : inheritedImageUrl;
  const selectedDownloadUrl = selectedImage ? `/social-drafts/${draft._id}/images/${selectedImage._id}/file?download=1` : (inheritedImageUrl ? `${inheritedImageUrl}?download=1` : '');
  const selectableAssets = assets.filter((asset) => asset.status !== 'failed');
  const activePublish = ['publishing'].includes(status.uiStatus);
  const canChange = canEdit && !activePublish;
  const canStartPublish = canPublish && !status.blockers.length && !['publishing', 'published', 'cancelled'].includes(status.uiStatus);
  const defaultPublishAt = draft.scheduledFor && draft.scheduledFor.getTime() > Date.now() ? draft.scheduledFor : new Date(Date.now() + 10 * 60 * 1000);
  const accountNameById = new Map(connectedAccounts.map((account) => [String(account._id), account.accountName]));
  const lastFirstComment = jobs.find((job) => job.content && job.content.firstComment)?.content?.firstComment || '';
  const defaultMediaForPlatform = (platform) => {
    const ready = selectableAssets.filter((asset) => asset.status === 'ready');
    const imageAssets = ready.filter((asset) => asset.kind === 'image');
    const videos = ready.filter((asset) => asset.kind === 'video');
    if (platform === 'youtube') return [videos[0], imageAssets[0]].filter(Boolean);
    if (platform === 'tiktok') return videos.length ? [videos[0]] : imageAssets;
    if (['facebook', 'linkedin'].includes(platform) && videos.length) return [videos[0]];
    if (['bluesky', 'x'].includes(platform)) return imageAssets.slice(0, 4);
    return ready;
  };
%>

<header class="calendar-drawer-header">
  <button class="mobile-drawer-cancel" type="button" data-close-drawer>Cancel</button>
  <div>
    <p class="eyebrow"><%= draft.channel %> content</p>
    <h2 id="calendar-drawer-title"><%= draft.title || 'Untitled post' %></h2>
    <div class="calendar-drawer-meta">
      <span class="calendar-ui-status status-tone-<%= status.statusTone %>">
        <span class="status-dot"></span>
        <span><%= status.statusLabel %></span>
      </span>
      <span class="calendar-review-status"><%= currentReviewLabel %></span>
      <span><%= draft.scheduledFor ? draft.scheduledFor.toLocaleString() : 'Unscheduled' %></span>
    </div>
  </div>
  <% if (canChange) { %><button class="mobile-drawer-save" type="submit" form="calendar-draft-update-<%= draft._id %>">Save</button><% } %>
  <button class="icon-button" type="button" aria-label="Close post details" title="Close" data-close-drawer>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4L4 12M4 4l8 8"/></svg>
  </button>
</header>

<div class="calendar-drawer-tabs" role="tablist" aria-label="Post details">
  <% (isClientReview ? [['content','Review'],['collaboration','Discussion']] : [['content','Content'],['media','Media'],['publishing','Publishing'],['collaboration','Collaboration'],['history','History']]).forEach(([key, label], index) => { %>
    <button type="button" role="tab" id="drawer-tab-<%= key %>" aria-controls="drawer-panel-<%= key %>" aria-selected="<%= index === 0 %>" tabindex="<%= index === 0 ? '0' : '-1' %>" data-drawer-tab="<%= key %>"><%= label %><% if (key === 'history' && jobs.length) { %><span><%= jobs.length %></span><% } %></button>
  <% }) %>
</div>

<div class="calendar-drawer-body">
  <section id="drawer-panel-content" role="tabpanel" aria-labelledby="drawer-tab-content" data-drawer-panel="content">
    <% if (selectedImageUrl) { %><figure class="calendar-drawer-visual"><img src="<%= selectedImageUrl %>" alt="<%= selectedImage ? selectedImage.altText || '' : '' %>"><% if (selectedImage?.caption) { %><figcaption><%= selectedImage.caption %></figcaption><% } %></figure><% } %>
    <div class="calendar-copy-preview"><p id="drawer-copy-<%= draft._id %>"><%= draft.body %></p><button class="button button-small" type="button" data-copy-target="drawer-copy-<%= draft._id %>">Copy caption</button></div>
    <dl class="calendar-content-context">
      <div><dt>Campaign</dt><dd><%= draftCampaign?.name || 'No campaign details available' %></dd></div>
      <div><dt>Owner</dt><dd><%= draftCollaborators.find((person) => String(person.id) === String(draft.assignedTo || ''))?.name || 'Unassigned' %></dd></div>
      <div><dt>First comment</dt><dd><%= lastFirstComment || 'None configured' %></dd></div>
      <% if (Array.isArray(draft.metadata?.tags) && draft.metadata.tags.length) { %><div><dt>Tags</dt><dd><%= draft.metadata.tags.join(', ') %></dd></div><% } %>
    </dl>
    <div class="calendar-review-actions">
      <% if (canChange && ['draft','changes_requested'].includes(currentReviewStatus)) { %><form action="/social-drafts/<%= draft._id %>/review/<%= currentReviewStatus === 'changes_requested' ? 'resubmit' : 'submit' %>" method="post" data-async-action data-refresh-drawer><button class="button button-primary" type="submit"><%= currentReviewStatus === 'changes_requested' ? 'Re-submit for review' : 'Submit for review' %></button></form><% } %>
      <% if (canReview && ['draft','ready_for_review','changes_requested'].includes(currentReviewStatus)) { %><form action="/social-drafts/<%= draft._id %>/review/approve" method="post" data-async-action data-refresh-drawer><input type="text" name="comment" maxlength="2000" placeholder="Optional approval note"><button class="button button-primary" type="submit">Approve</button></form><% } %>
      <% if (canReview && ['ready_for_review','approved','scheduled'].includes(currentReviewStatus)) { %><form action="/social-drafts/<%= draft._id %>/review/request_changes" method="post" data-async-action data-refresh-drawer><input type="text" name="comment" maxlength="2000" placeholder="Describe the required changes" required><button class="button" type="submit">Request changes</button></form><% } %>
    </div>
    <% if (canChange) { %>
      <form id="calendar-draft-update-<%= draft._id %>" class="form calendar-drawer-form" action="/social-drafts/<%= draft._id %>/update" method="post" data-async-action data-refresh-drawer>
        <div class="form-grid">
          <label>Internal title<input name="title" value="<%= draft.title || '' %>" maxlength="180"></label>
          <label>Platform<select name="channel" data-draft-channel><% ['bluesky','linkedin','instagram','facebook','threads','x','tiktok','youtube','email','webhook'].forEach((channel) => { %><option value="<%= channel %>" <%= draft.channel === channel ? 'selected' : '' %>><%= channel %></option><% }) %></select></label>
          <label>Account<select name="socialAccountId"><option value="">Auto-select connected account</option><% connectedAccounts.forEach((account) => { %><option value="<%= account._id %>" <%= String(draft.socialAccountId || '') === String(account._id) ? 'selected' : '' %>><%= account.platform %> · <%= account.accountName %> · <%= projectNames[String(account.projectId)] || project.name %></option><% }) %></select></label>
          <label>Scheduled date<input type="datetime-local" name="scheduledFor" value="<%= draft.scheduledFor ? new Date(draft.scheduledFor.getTime() - draft.scheduledFor.getTimezoneOffset() * 60000).toISOString().slice(0, 16) : '' %>" required></label>
        </div>
        <label>Caption<textarea name="body" rows="10" maxlength="4000" required data-draft-copy><%= draft.body %></textarea><small data-draft-copy-limit></small></label>
        <div class="calendar-drawer-actions"><button class="button button-primary" type="submit">Save changes</button><button class="button" type="submit" formaction="/social-drafts/<%= draft._id %>/delete" data-delete-draft>Remove post</button></div>
      </form>
    <% } %>
  </section>

  <% if (!isClientReview) { %><section id="drawer-panel-media" role="tabpanel" aria-labelledby="drawer-tab-media" data-drawer-panel="media" hidden>
    <div class="calendar-drawer-section-heading"><div><p class="eyebrow">Publishing media</p><h3>Uploads and platform variants</h3></div><span><%= assets.filter((asset) => asset.status === 'ready').length %> ready</span></div>
    <% if (canChange) { %>
      <form class="form calendar-media-upload" action="/social-drafts/<%= draft._id %>/media/upload" method="post" enctype="multipart/form-data" data-async-action data-refresh-drawer>
        <label>Image or video<input type="file" name="media" accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/webm" required></label>
        <label>Alt text<input name="altText" maxlength="500" placeholder="Describe the media for accessibility"></label>
        <button class="button" type="submit">Upload media</button>
      </form>
    <% } %>
    <% if (assets.length) { %>
      <div class="calendar-media-grid" data-media-status-endpoint="/social-drafts/<%= draft._id %>/media-status">
        <% assets.forEach((asset) => { %>
          <article class="calendar-media-item" data-media-asset-id="<%= asset._id %>">
            <div class="calendar-media-preview">
              <% if (asset.status === 'ready' && asset.kind === 'image') { %><img src="/social-drafts/<%= draft._id %>/media/<%= asset._id %>/file?variant=portrait_image" alt="<%= asset.altText || '' %>" loading="lazy"><% } else if (asset.status === 'ready' && asset.kind === 'video') { %><video src="/social-drafts/<%= draft._id %>/media/<%= asset._id %>/file?variant=vertical_video" controls preload="metadata"></video><% } else { %><div><strong><%= asset.kind %></strong><span><%= asset.status.replace(/_/g, ' ') %></span></div><% } %>
            </div>
            <div><strong><%= asset.filename || `${asset.kind} upload` %></strong><span class="calendar-ui-status status-tone-neutral"><%= asset.status.replace(/_/g, ' ') %></span><% if (asset.processingError) { %><p class="form-error"><%= asset.processingError %></p><% } %><% if (canChange) { %><form class="calendar-inline-details" action="/social-drafts/<%= draft._id %>/media/<%= asset._id %>/update" method="post" data-async-action data-refresh-drawer><label>Alt text<input name="altText" value="<%= asset.altText || '' %>" maxlength="500"></label><button class="button button-small" type="submit">Save description</button></form><% } %></div>
            <% if (canChange) { %><div class="calendar-media-actions"><% if (asset.status === 'ready') { %><a class="button button-small" href="/social-drafts/<%= draft._id %>/media/<%= asset._id %>/file?download=1">Download</a><% } %><% if (asset.status === 'failed') { %><button class="button button-small" type="submit" form="media-retry-<%= asset._id %>">Retry</button><% } %><button class="button button-small" type="submit" form="media-delete-<%= asset._id %>">Remove</button></div><% } %>
          </article>
          <% if (canChange && asset.status === 'failed') { %><form id="media-retry-<%= asset._id %>" action="/social-drafts/<%= draft._id %>/media/<%= asset._id %>/retry" method="post" data-async-action data-refresh-drawer></form><% } %>
          <% if (canChange) { %><form id="media-delete-<%= asset._id %>" action="/social-drafts/<%= draft._id %>/media/<%= asset._id %>/delete" method="post" data-async-action data-refresh-drawer></form><% } %>
        <% }) %>
      </div>
    <% } else { %><div class="calendar-drawer-empty"><strong>No publishing media yet</strong><p>Upload an image or video. Processing runs asynchronously.</p></div><% } %>

    <% if (canManage) { %>
      <div class="calendar-drawer-section-heading"><div><p class="eyebrow">Creative workspace</p><h3>Generated and uploaded visuals</h3></div><span><%= images.filter((image) => image.status !== 'rejected').length %> candidates</span></div>
      <div class="calendar-image-actions">
        <form class="form" action="/social-drafts/<%= draft._id %>/images/generate" method="post" data-async-action data-refresh-drawer data-image-generation>
          <label>Visual format<select name="visualFormat"><option value="minimal-product-visual">Minimal no-text visual</option><option value="fashion-editorial">Fashion / beauty editorial</option><option value="ecommerce-product-scene">Ecommerce product scene</option><option value="ugc-lifestyle">UGC / lifestyle moment</option><option value="art-direction-campaign">Art-direction campaign</option><option value="human-editorial-poster">Human editorial poster</option><option value="corporate-flyer">Corporate marketing flyer</option><option value="b2b-carousel-slide">Multi-slide B2B carousel</option><option value="3d-device-mockup">SaaS product mockup</option><option value="data-infographic">Data infographic</option><option value="performance-ad-creative">Performance ad creative</option></select></label>
          <label>Aesthetic<select name="aestheticTheme"><option value="documentary-human">Documentary human brand</option><option value="luxury-fashion">Luxury fashion editorial</option><option value="clean-commerce">Clean commerce studio</option><option value="art-house">Art-house campaign</option><option value="earthy-wellness">Earthy wellness lifestyle</option><option value="minimalist-saas">Minimalist enterprise SaaS</option><option value="fintech-glass">Fintech and cyber glass</option><option value="warm-editorial">Warm editorial corporate</option><option value="high-voltage-growth">High-voltage growth</option></select></label>
          <label>Image direction<textarea name="guidance" rows="4" maxlength="1500" placeholder="Describe the scene, product, styling, camera feel and what to avoid."></textarea></label>
          <% if (images.some((image) => image.status !== 'rejected')) { %><label>Reference image<select name="referenceImageId"><option value="">No reference</option><% images.filter((image) => image.status !== 'rejected').forEach((image) => { %><option value="<%= image._id %>"><%= image.source %> image <%= image.status === 'selected' ? '(selected)' : '' %></option><% }) %></select></label><% } %>
          <button class="button button-primary" type="submit">Generate image</button>
        </form>
        <form class="form" action="/social-drafts/<%= draft._id %>/images/upload" method="post" enctype="multipart/form-data" data-async-action data-refresh-drawer><label>Upload image<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><label>Alt text<input name="altText" maxlength="240"></label><label>Caption<input name="caption" maxlength="500"></label><button class="button" type="submit">Upload image</button></form>
      </div>
      <% if (images.length) { %><div class="calendar-image-grid"><% images.forEach((image) => { %><article class="calendar-image-card <%= image.status === 'selected' ? 'is-selected' : '' %> <%= image.status === 'rejected' ? 'is-rejected' : '' %>"><img src="/social-drafts/<%= draft._id %>/images/<%= image._id %>/file" alt="<%= image.altText || '' %>" loading="lazy"><div><strong><%= image.status %></strong><span><%= image.source %></span></div><form class="calendar-inline-details" action="/social-drafts/<%= draft._id %>/images/<%= image._id %>/update" method="post" data-async-action data-refresh-drawer><label>Alt text<input name="altText" value="<%= image.altText || '' %>" maxlength="240"></label><label>Caption<input name="caption" value="<%= image.caption || '' %>" maxlength="500"></label><button class="button button-small" type="submit">Save details</button></form><div class="calendar-media-actions"><% if (image.status !== 'rejected') { %><form action="/social-drafts/<%= draft._id %>/images/<%= image._id %>/select" method="post" data-async-action data-refresh-drawer><button class="button button-primary button-small" type="submit">Select</button></form><a class="button button-small" href="/social-drafts/<%= draft._id %>/images/<%= image._id %>/file?download=1">Download</a><form action="/social-drafts/<%= draft._id %>/images/<%= image._id %>/reject" method="post" data-async-action data-refresh-drawer><button class="button button-small" type="submit">Reject</button></form><% } else { %><form action="/social-drafts/<%= draft._id %>/images/<%= image._id %>/restore" method="post" data-async-action data-refresh-drawer><button class="button button-small" type="submit">Restore</button></form><% } %></div></article><% }) %></div><% } %>
    <% } %>
  </section><% } %>

  <% if (!isClientReview) { %><section id="drawer-panel-publishing" role="tabpanel" aria-labelledby="drawer-tab-publishing" data-drawer-panel="publishing" hidden>
    <% if (status.hasAttention || status.blockers.length || draft.errorMessage) { %><div class="calendar-publishing-alert" role="alert"><div><strong>Publishing needs attention</strong><span><%= publishReadiness.score %>% readiness</span></div><ul><% (publishReadiness.blockerDetails || []).forEach((blocker) => { %><li><strong><%= blocker.message %></strong><span><%= blocker.resolution %></span><% if (blocker.action?.href) { %><a class="button button-small" href="<%= blocker.action.href %>"><%= blocker.action.label %></a><% } %></li><% }) %><% if (!(publishReadiness.blockerDetails || []).length && draft.errorMessage) { %><li><%= draft.errorMessage %></li><% } %></ul></div><% } %>
    <% if (canStartPublish && nativeAccounts.length) { %>
      <form class="form calendar-publish-form" action="/social-drafts/<%= draft._id %>/approve-and-publish" method="post" data-async-action data-refresh-drawer data-publish-form>
        <fieldset class="publish-account-picker"><legend>Publish to</legend><% nativeAccounts.forEach((account) => { const selected = account.platform === draft.channel || String(account._id) === String(draft.socialAccountId || ''); %><label><input type="checkbox" name="accountIds" value="<%= account._id %>" data-publish-account data-platform="<%= account.platform %>" <%= selected ? 'checked' : '' %>><span><strong><%= account.platform %></strong><%= account.accountName %> · <%= projectNames[String(account.projectId)] || project.name %></span></label><% }) %></fieldset>
        <% if (selectableAssets.length) { %><div class="publish-media-matrix"><% nativeAccounts.forEach((account) => { const defaults = defaultMediaForPlatform(account.platform).map((asset) => String(asset._id)); const selected = account.platform === draft.channel || String(account._id) === String(draft.socialAccountId || ''); %><fieldset data-account-media="<%= account._id %>" <%= selected ? '' : 'hidden' %>><input type="hidden" name="mediaAccountConfigured" value="<%= account._id %>"><legend><%= account.platform %> media</legend><% selectableAssets.forEach((asset) => { %><label><input type="checkbox" name="media_<%= account._id %>" value="<%= asset._id %>" <%= defaults.includes(String(asset._id)) ? 'checked' : '' %>><span><strong><%= asset.kind %></strong><%= asset.filename || `${asset.kind} upload` %> · <%= asset.status %></span></label><% }) %></fieldset><% }) %></div><% } %>
        <label>First comment<textarea name="firstComment" rows="4" maxlength="3000" placeholder="Optional follow-up comment for supported platforms"><%= lastFirstComment %></textarea></label>
        <fieldset class="platform-publish-options" data-platform-options="tiktok" data-creator-endpoint="/social-drafts/<%= draft._id %>/tiktok-creator-info" hidden><legend>TikTok settings</legend><p data-tiktok-creator-status>Select a TikTok account to load posting choices.</p><label>Visibility<select name="tiktokPrivacyLevel" data-tiktok-privacy><option value="">Choose visibility</option></select></label><div class="platform-option-checks"><label><input type="checkbox" name="tiktokAllowComment" checked data-tiktok-feature="comment"> Allow comments</label><label><input type="checkbox" name="tiktokAllowDuet" checked data-tiktok-feature="duet"> Allow Duet</label><label><input type="checkbox" name="tiktokAllowStitch" checked data-tiktok-feature="stitch"> Allow Stitch</label></div><label><input type="checkbox" name="tiktokCommercialContent" data-tiktok-commercial> Promotes a brand, product or service</label><div class="platform-option-checks" data-tiktok-disclosures hidden><label><input type="checkbox" name="tiktokBrandOrganicContent"> Promotes this creator's own brand</label><label><input type="checkbox" name="tiktokBrandedContent"> Paid partnership or third-party brand</label></div><label><input type="checkbox" name="tiktokMusicUsageConsent" data-tiktok-consent> I have permission to use this music.</label></fieldset>
        <fieldset class="platform-publish-options" data-platform-options="youtube" hidden><legend>YouTube settings</legend><label>Format<select name="youtubeVideoType"><option value="regular">Regular video</option><option value="short">Short</option></select></label><label>Visibility<select name="youtubePrivacyStatus"><option value="private">Private</option><option value="unlisted">Unlisted</option><option value="public">Public</option></select></label><label><input type="checkbox" name="youtubeNotifySubscribers"> Notify subscribers</label></fieldset>
        <fieldset class="calendar-publish-timing"><legend>Timing</legend><label><input type="radio" name="publishMode" value="now" checked> Publish now</label><label><input type="radio" name="publishMode" value="schedule"> Schedule</label><label data-schedule-field hidden>Date and time<input type="datetime-local" name="scheduledAt" data-scheduled-at="<%= defaultPublishAt.toISOString() %>" value="<%= new Date(defaultPublishAt.getTime() - defaultPublishAt.getTimezoneOffset() * 60000).toISOString().slice(0, 16) %>" disabled></label><input type="hidden" name="timeZone"></fieldset>
        <button class="button button-primary" type="submit"><%= draft.status === 'draft' ? 'Approve and publish' : 'Publish' %></button>
      </form>
    <% } else if (!nativeAccounts.length) { %><div class="calendar-drawer-empty"><strong>No connected social account</strong><p>Connect an account before publishing this post.</p><a class="button button-primary" href="/projects/<%= project._id %>/integrations/social">Connect account</a></div><% } %>
    <div class="calendar-secondary-actions"><% if (canManage && draft.status === 'draft') { %><form action="/social-drafts/<%= draft._id %>/approve" method="post" data-async-action data-refresh-drawer><button class="button" type="submit">Approve only</button></form><% } %><% if (canChange && status.uiStatus !== 'published') { %><form action="/social-drafts/<%= draft._id %>/mark-published" method="post" data-async-action data-refresh-drawer><button class="button" type="submit">Mark published manually</button></form><% } %></div>
  </section><% } %>

  <section id="drawer-panel-collaboration" role="tabpanel" aria-labelledby="drawer-tab-collaboration" data-drawer-panel="collaboration" hidden>
    <div class="calendar-drawer-section-heading"><div><p class="eyebrow">Team conversation</p><h3>Comments and decisions</h3></div><span><%= draftComments.length %></span></div>
    <form class="form calendar-comment-form" action="/social-drafts/<%= draft._id %>/comments" method="post" data-async-action data-refresh-drawer><label>Add comment<textarea name="body" rows="3" maxlength="2000" required placeholder="Add context, feedback, or a client note"></textarea></label><button class="button button-primary" type="submit">Comment</button></form>
    <% if (canManage && draftCollaborators.length) { %><form class="form calendar-assignment-form" action="/social-drafts/<%= draft._id %>/assign" method="post" data-async-action data-refresh-drawer><label>Owner<select name="assignedTo"><option value="">Unassigned</option><% draftCollaborators.forEach((person) => { %><option value="<%= person.id %>" <%= String(draft.assignedTo || '') === String(person.id) ? 'selected' : '' %>><%= person.name %> · <%= person.role %></option><% }) %></select></label><button class="button" type="submit">Update owner</button></form><% } %>
    <div class="calendar-comment-list"><% if (!draftComments.length) { %><div class="calendar-drawer-empty"><strong>No comments yet</strong><p>Use comments for review context and decisions.</p></div><% } %><% draftComments.forEach((comment) => { %><article><header><strong><%= comment.authorUserId?.name || comment.authorUserId?.email || 'Team member' %></strong><time><%= new Date(comment.createdAt).toLocaleString() %></time></header><span class="calendar-ui-status status-tone-neutral"><%= comment.kind.replace(/_/g, ' ') %></span><p><%= comment.body %></p></article><% }) %></div>
    <% if (!isClientReview) { %><details class="calendar-activity-feed"><summary>Activity trail (<%= draftActivities.length %>)</summary><ol><% draftActivities.forEach((activity) => { %><li><time><%= new Date(activity.createdAt).toLocaleString() %></time><strong><%= activity.actorUserId?.name || activity.actorUserId?.email || 'System' %></strong><span><%= activity.summary %></span></li><% }) %></ol></details><% } %>
  </section>

  <% if (!isClientReview) { %><section id="drawer-panel-history" role="tabpanel" aria-labelledby="drawer-tab-history" data-drawer-panel="history" hidden>
    <% if (!jobs.length) { %><div class="calendar-drawer-empty"><strong>No publishing history</strong><p>Publishing attempts and provider outcomes will appear here.</p></div><% } %>
    <div class="calendar-history-list" data-publish-status-endpoint="/social-drafts/<%= draft._id %>/publish-status">
      <% jobs.forEach((job) => { const failure = (publishReadiness.blockerDetails || []).find((blocker) => blocker.code === 'PUBLISH_FAILED'); const unsafeRetry = job.failureKind === 'unknown' && job.providerDispatchStartedAt; %><article data-publish-job-id="<%= job._id %>"><header><div><strong><%= job.platform %></strong><span><%= accountNameById.get(String(job.accountId)) || 'Connected account' %></span></div><span class="calendar-ui-status status-tone-neutral" data-publish-job-status><%= job.status.replace(/_/g, ' ') %></span></header><dl><div><dt>Created</dt><dd><%= job.createdAt.toLocaleString() %></dd></div><% if (job.publishedAt) { %><div><dt>Published</dt><dd><%= job.publishedAt.toLocaleString() %></dd></div><% } %><div><dt>Attempts</dt><dd><%= job.attempts %> / <%= job.maxAttempts %></dd></div></dl><% if (failure && ['failed','dead_letter','expired'].includes(job.status)) { %><div class="calendar-history-resolution"><strong><%= failure.message %></strong><p><%= failure.resolution %></p></div><% } %><% if (job.warningMessage) { %><p class="calendar-history-warning"><%= job.warningMessage %></p><% } %><div class="calendar-media-actions"><% if (job.platformUrl) { %><a class="button button-small" href="<%= job.platformUrl %>" target="_blank" rel="noopener">View post</a><% } %><% if (['failed','dead_letter'].includes(job.status) && canPublish && !unsafeRetry) { %><form action="/social-drafts/<%= draft._id %>/publish-jobs/<%= job._id %>/retry" method="post" data-async-action data-refresh-drawer><button class="button button-small" type="submit">Retry</button></form><% } %><% if (job.reconnectRequired) { %><a class="button button-small" href="/projects/<%= job.destinationProjectId || project._id %>/integrations/social">Reconnect</a><% } %></div><details><summary>Technical history</summary><% if (job.errorMessage) { %><p class="form-error"><%= job.errorMessage %></p><% } %><% if ((events[String(job._id)] || []).length) { %><ol><% events[String(job._id)].forEach((event) => { %><li><time><%= event.createdAt.toLocaleString() %></time><strong><%= event.eventType.replace(/_/g, ' ') %></strong><% if (event.message) { %><span><%= event.message %></span><% } %></li><% }) %></ol><% } %></details></article><% }) %>
    </div>
  </section><% } %>
</div>
