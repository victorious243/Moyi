%>
<article
  class="calendar-event status-tone-<%= item.statusTone %> <%= item.hasAttention ? 'has-attention' : '' %>"
  id="post-<%= eventDraft._id %>"
  data-calendar-row
  data-calendar-event
  data-draft-id="<%= eventDraft._id %>"
  data-scheduled-at="<%= eventDraft.scheduledFor ? eventDraft.scheduledFor.toISOString() : '' %>"
  data-local-time="<%= item.localTime || '' %>"
  draggable="<%= item.canReschedule ? 'true' : 'false' %>"
>
  <button type="button" data-open-drawer aria-label="Open <%= eventDraft.title || 'untitled post' %>">
    <span class="calendar-event-header">
      <span class="calendar-event-time"><%= item.displayTime %></span>
      <span class="calendar-event-channel" title="<%= eventDraft.channel %>">
        <%- icons[eventDraft.channel] || shortPlatform %>
      </span>
      <span class="status-dot tone-<%= item.statusTone %>" title="<%= item.statusLabel %>"></span>
    </span>
    <span class="calendar-event-title"><%= eventDraft.title || 'Untitled post' %></span>
    <span class="calendar-event-meta">
      <% if (typeof teamMode !== 'undefined' && teamMode && item.reviewLabel) { %>
        <span><%= item.reviewLabel %></span>
      <% } else { %>
        <span><%= item.statusLabel %></span>
      <% } %>
      <% if (item.accountName) { %>
        <span class="meta-account">· <%= item.accountName %></span>
      <% } %>
    </span>
  </button>
  <% if (item.blocker) { %><p class="calendar-event-blocker" title="<%= item.blocker %>">⚠ <%= item.blocker %></p><% } %>
</article>
