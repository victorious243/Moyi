<%- include('../../partials/header') %>

<% const fmt = new Intl.NumberFormat('en'); %>
<% const pct = (value) => `${((value || 0) * 100).toFixed(2)}%`; %>
<% const pos = (value) => value ? value.toFixed(1) : '0.0'; %>
<% const opportunityCount = opportunities ? opportunities.total : 0; %>

<div class="app-layout">
  <%- include('../../partials/project-sidebar', { project, activeSection: 'search-console' }) %>

  <section
    class="app-main"
    <% if (syncJob && (syncJob.status === 'queued' || syncJob.status === 'running')) { %>
      data-live-job
      data-live-job-endpoint="/projects/<%= project._id %>/jobs/<%= syncJob._id %>"
      data-initial-job-status="<%= syncJob.status %>"
    <% } %>
  >
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Search Performance</h1>
      </div>
      <div class="row-actions">
        <a class="button" href="/projects/<%= project._id %>/search-console/connect">Connect property</a>
        <% if (connectedProperty) { %>
          <form action="/projects/<%= project._id %>/search-console/sync" method="post">
            <input type="hidden" name="days" value="<%= days %>">
            <button class="button button-primary" type="submit">Sync <%= days %> Days</button>
          </form>
        <% } %>
      </div>
    </div>

    <% if (errorMessage) { %>
      <section class="panel notice-panel">
        <h2>Sync issue</h2>
        <p class="empty"><%= errorMessage %></p>
      </section>
    <% } %>

    <% if (successMessage) { %>
      <section class="panel">
        <h2>Search Console updated</h2>
        <p class="empty"><%= successMessage %></p>
      </section>
    <% } %>

    <% if (queuedMessage && syncJob && (syncJob.status === 'queued' || syncJob.status === 'running')) { %>
      <section class="panel">
        <h2>Search Console sync in progress</h2>
        <p class="empty"><%= queuedMessage %></p>
        <p class="empty">Status: <strong data-job-status><%= syncJob.status %></strong><% if (syncJob.startedAt) { %> / started <%= new Date(syncJob.startedAt).toLocaleString() %><% } %></p>
        <p class="empty"><span data-job-step><%= syncJob.currentStep || 'Preparing the Search Console sync' %></span></p>
        <p class="empty">Progress: <span data-job-progress><%= typeof syncJob.progressPercent === 'number' ? `${syncJob.progressPercent}%` : '0%' %></span> / Last checked at <span data-job-last-checked>just now</span>.</p>
        <p class="empty" data-job-error-row hidden>Error: <span data-job-error></span></p>
      </section>
    <% } %>

    <% if (syncJob && syncJob.status === 'failed') { %>
      <section class="panel notice-panel">
        <h2>Latest Search Console sync failed</h2>
        <p class="empty"><%= syncJob.errorMessage || 'The background sync job failed before new performance rows were saved.' %></p>
        <form action="/projects/<%= project._id %>/jobs/<%= syncJob._id %>/retry" method="post">
          <button class="button button-primary" type="submit">Retry Job</button>
        </form>
      </section>
    <% } %>

    <% if (!connectedProperty) { %>
      <section class="panel">
        <h2><%= integration ? 'Select a Search Console property' : 'Connect Google Search Console' %></h2>
        <p class="empty">
          <% if (integration) { %>
            Google readonly access is connected, but this project still needs a verified Search Console property before performance data can sync.
          <% } else { %>
            Connect Google readonly access, then select the verified property for this project.
          <% } %>
        </p>
        <a class="button button-primary" href="/projects/<%= project._id %>/search-console/connect"><%= integration ? 'Select Property' : 'Connect Search Console' %></a>
      </section>
    <% } else { %>
      <section class="panel">
        <div class="panel-title">
          <div>
            <h2><%= connectedProperty.siteUrl %></h2>
            <p class="empty">Last synced: <%= connectedProperty.lastSyncedAt ? connectedProperty.lastSyncedAt.toLocaleString() : 'Never' %></p>
          </div>
          <div class="segmented-links">
            <a class="<%= days === 7 ? 'active' : '' %>" href="/projects/<%= project._id %>/search-console/performance?days=7">7d</a>
            <a class="<%= days === 28 ? 'active' : '' %>" href="/projects/<%= project._id %>/search-console/performance?days=28">28d</a>
            <a class="<%= days === 90 ? 'active' : '' %>" href="/projects/<%= project._id %>/search-console/performance?days=90">90d</a>
          </div>
        </div>
      </section>

      <section class="metrics">
        <article><span>Total clicks</span><strong><%= fmt.format(dashboard.summary.totalClicks) %></strong></article>
        <article><span>Total impressions</span><strong><%= fmt.format(dashboard.summary.totalImpressions) %></strong></article>
        <article><span>Average CTR</span><strong><%= pct(dashboard.summary.averageCtr) %></strong></article>
        <article><span>Average position</span><strong><%= pos(dashboard.summary.averagePosition) %></strong></article>
      </section>

      <section class="panel opportunity-command">
        <div class="panel-title">
          <div>
            <p class="eyebrow">Automated growth opportunities</p>
            <h2><%= opportunityCount %> rule-based opportunity candidates</h2>
            <p class="empty">Benchmark CTR: <%= pct(opportunities.averageCtr) %>. These candidates are calculated from synced query and page performance. They are pattern matches, not predictions.</p>
          </div>
        </div>

        <% if (!opportunityCount) { %>
          <p class="empty">No strong pattern matches yet. Sync more Search Console data or expand the date range.</p>
        <% } else { %>
          <div class="opportunity-grid">
            <div class="opportunity-column">
              <div class="opportunity-column-heading">
                <span>Boost CTR</span>
                <strong><%= opportunities.boostCtr.length %></strong>
              </div>
              <% if (!opportunities.boostCtr.length) { %>
                <p class="empty">No page-one CTR gaps detected.</p>
              <% } %>
              <% opportunities.boostCtr.slice(0, 5).forEach((item) => { %>
                <article class="opportunity-card">
                  <div class="opportunity-card-heading">
                    <span class="status">Page 1</span>
                    <strong><%= item.query %></strong>
                  </div>
                  <p class="empty">Rule-based candidate from synced Search Console data.</p>
                  <p><%= item.recommendation %></p>
                  <dl class="opportunity-stats">
                    <div><dt>CTR</dt><dd><%= pct(item.ctr) %></dd></div>
                    <div><dt>Avg</dt><dd><%= pct(item.benchmarkCtr) %></dd></div>
                    <div><dt>Pos</dt><dd><%= pos(item.position) %></dd></div>
                    <div><dt>Impr.</dt><dd><%= fmt.format(item.impressions) %></dd></div>
                  </dl>
                  <a class="opportunity-page" href="<%= item.page %>" target="_blank" rel="noopener"><%= item.page %></a>
                  <div class="row-actions opportunity-actions">
                    <form action="/projects/<%= project._id %>/search-console/opportunities/draft" method="post">
                      <input type="hidden" name="opportunityType" value="<%= item.type %>">
                      <input type="hidden" name="query" value="<%= item.query %>">
                      <input type="hidden" name="page" value="<%= item.page %>">
                      <button class="button button-primary" type="submit">Create Optimization Draft</button>
                    </form>
                    <a class="button" href="<%= item.page %>" target="_blank" rel="noopener">Review Page</a>
                  </div>
                </article>
              <% }) %>
            </div>

            <div class="opportunity-column">
              <div class="opportunity-column-heading">
                <span>Push to Page 1</span>
                <strong><%= opportunities.pushToPageOne.length %></strong>
              </div>
              <% if (!opportunities.pushToPageOne.length) { %>
                <p class="empty">No high-impression page-two queries detected.</p>
              <% } %>
              <% opportunities.pushToPageOne.slice(0, 5).forEach((item) => { %>
                <article class="opportunity-card">
                  <div class="opportunity-card-heading">
                    <span class="status">Page 2</span>
                    <strong><%= item.query %></strong>
                  </div>
                  <p class="empty">Rule-based candidate from synced Search Console data.</p>
                  <p><%= item.recommendation %></p>
                  <dl class="opportunity-stats">
                    <div><dt>Clicks</dt><dd><%= fmt.format(item.clicks) %></dd></div>
                    <div><dt>CTR</dt><dd><%= pct(item.ctr) %></dd></div>
                    <div><dt>Pos</dt><dd><%= pos(item.position) %></dd></div>
                    <div><dt>Impr.</dt><dd><%= fmt.format(item.impressions) %></dd></div>
                  </dl>
                  <a class="opportunity-page" href="<%= item.page %>" target="_blank" rel="noopener"><%= item.page %></a>
                  <div class="row-actions opportunity-actions">
                    <form action="/projects/<%= project._id %>/search-console/opportunities/draft" method="post">
                      <input type="hidden" name="opportunityType" value="<%= item.type %>">
                      <input type="hidden" name="query" value="<%= item.query %>">
                      <input type="hidden" name="page" value="<%= item.page %>">
                      <button class="button button-primary" type="submit">Create Optimization Draft</button>
                    </form>
                    <a class="button" href="<%= item.page %>" target="_blank" rel="noopener">Review Page</a>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        <% } %>
      </section>

      <div class="dashboard-grid">
        <section class="panel">
          <h2>Top Queries</h2>
          <%- include('./table', { rows: dashboard.topQueries, label: 'Query', fmt, pct, pos }) %>
        </section>
        <section class="panel">
          <h2>Top Pages</h2>
          <%- include('./table', { rows: dashboard.topPages, label: 'Page', fmt, pct, pos }) %>
        </section>
      </div>

      <section class="panel">
        <h2>High Impressions, Low CTR</h2>
        <%- include('./table', { rows: dashboard.highImpressionsLowCtr, label: 'Page', fmt, pct, pos }) %>
      </section>

      <section class="panel">
        <h2>Queries Close to Page 1</h2>
        <%- include('./table', { rows: dashboard.queriesCloseToPageOne, label: 'Query', fmt, pct, pos }) %>
      </section>

      <div class="dashboard-grid">
        <section class="panel">
          <h2>Pages Losing Visibility</h2>
          <%- include('./visibility-table', { rows: dashboard.pagesLosingVisibility, fmt }) %>
        </section>
        <section class="panel">
          <h2>Pages Gaining Visibility</h2>
          <%- include('./visibility-table', { rows: dashboard.pagesGainingVisibility, fmt }) %>
        </section>
      </div>
    <% } %>
  </section>
</div>

<%- include('../../partials/footer') %>
