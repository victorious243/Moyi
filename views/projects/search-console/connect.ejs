<%- include('../../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/search-console/connect">Search Console</a>
    <a href="/projects/<%= project._id %>/search-console/performance">Performance</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Connect Search Console</h1>
      </div>
      <a class="button" href="/integrations">Integration settings</a>
    </div>

    <% if (errorMessage) { %>
      <section class="panel notice-panel">
        <h2>Search Console unavailable</h2>
        <p class="empty"><%= errorMessage %></p>
        <div class="integration-checklist">
          <strong>To make this connection work:</strong>
          <ol>
            <li>Enable the Google Search Console API in the same Google Cloud project used by Moyi-CMO.</li>
            <li>Add the readonly scope: <code>https://www.googleapis.com/auth/webmasters.readonly</code>.</li>
            <li>Use the same Google account that owns or can view the Search Console property for this website.</li>
            <li>If you changed scopes, revoke the old Moyi-CMO Google permission and click Reconnect Google.</li>
          </ol>
        </div>
      </section>
    <% } %>

    <% if (successMessage) { %>
      <section class="panel">
        <h2>Property connected</h2>
        <p class="empty"><%= successMessage %></p>
      </section>
    <% } %>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Google Account</h2>
          <p class="empty">Moyi requests Search Console readonly access only.</p>
        </div>
        <a class="button button-primary" href="/integrations/google/connect?projectId=<%= project._id %>">
          <%= integration ? 'Reconnect Google' : 'Connect Google' %>
        </a>
      </div>
      <p><span class="status"><%= integration ? 'Google connected' : 'Google not connected' %></span></p>
    </section>

    <% if (connectedProperty) { %>
      <section class="panel">
        <div class="panel-title">
          <h2>Current Property</h2>
          <a href="/projects/<%= project._id %>/search-console/performance">Open performance</a>
        </div>
        <dl class="detail-list">
          <div><dt>Site URL</dt><dd><%= connectedProperty.siteUrl %></dd></div>
          <div><dt>Permission</dt><dd><%= connectedProperty.permissionLevel || 'Unknown' %></dd></div>
          <div><dt>Last synced</dt><dd><%= connectedProperty.lastSyncedAt ? connectedProperty.lastSyncedAt.toLocaleString() : 'Never' %></dd></div>
        </dl>
      </section>
    <% } %>

    <section class="panel">
      <h2>Verified Properties</h2>
      <% if (!integration) { %>
        <p class="empty">Connect Google before selecting a project property.</p>
      <% } else if (!properties.length) { %>
        <p class="empty">Google readonly access is connected, but no verified Search Console properties were returned for this Google account. Open Google Search Console with this same account and verify the website property first.</p>
      <% } else { %>
        <form class="form" action="/projects/<%= project._id %>/search-console/property" method="post">
          <label>
            Search Console property
            <select name="property" required>
              <% properties.forEach((property) => { %>
                <option value="<%= property.siteUrl %>||<%= property.permissionLevel %>" <%= connectedProperty && connectedProperty.siteUrl === property.siteUrl ? 'selected' : '' %>>
                  <%= property.siteUrl %> (<%= property.permissionLevel %>)
                </option>
              <% }) %>
            </select>
          </label>
          <button class="button button-primary" type="submit">Connect Property</button>
        </form>
      <% } %>
    </section>
  </section>
</div>

<%- include('../../partials/footer') %>
