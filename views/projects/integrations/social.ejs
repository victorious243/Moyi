<%- include('../../partials/header') %>

<%
  const readiness = typeof socialReadiness !== 'undefined' ? socialReadiness : { providers: {} };
  const userCanManageProject = typeof canManageProject !== 'undefined' ? canManageProject : true;
  const providerCards = [
    {
      key: 'bluesky',
      label: 'Bluesky',
      body: 'Connect with your Bluesky handle through the AT Protocol OAuth flow.',
      href: `/integrations/social/bluesky/connect?projectId=${project._id}`,
      needsHandle: true
    },
    {
      key: 'linkedin',
      label: 'LinkedIn',
      body: 'Connect a LinkedIn member or company-page capable account for thought leadership and product updates.',
      href: `/integrations/social/linkedin/connect?projectId=${project._id}`
    },
    {
      key: 'x',
      label: 'X',
      body: 'Connect an X account for short updates and launch posts.',
      href: `/integrations/social/x/connect?projectId=${project._id}`
    },
    {
      key: 'meta',
      label: 'Facebook + Instagram',
      body: 'Connect Facebook Pages and their linked Instagram Business or Creator accounts through Meta.',
      href: `/integrations/social/meta/connect?projectId=${project._id}`
    },
    {
      key: 'threads',
      label: 'Threads',
      body: 'Connect a Threads profile for text, image, video, and carousel publishing.',
      href: `/integrations/social/threads/connect?projectId=${project._id}`
    },
    {
      key: 'tiktok',
      label: 'TikTok',
      body: 'Connect an approved Content Posting API app for video and photo posts.',
      href: `/integrations/social/tiktok/connect?projectId=${project._id}`
    },
    {
      key: 'youtube',
      label: 'YouTube',
      body: 'Connect a YouTube channel for regular videos and Shorts.',
      href: `/integrations/social/youtube/connect?projectId=${project._id}`
    }
  ];
  const nativeProviderKeys = providerCards.map((provider) => provider.key);
  const readyNativeProviders = nativeProviderKeys.filter((key) => readiness.providers && readiness.providers[key] && readiness.providers[key].ready);
  const connectedByPlatform = (platforms) => accounts.filter((account) => platforms.includes(account.platform) && account.status === 'connected');
  const ownedConnectedByPlatform = (platforms) => connectedByPlatform(platforms).filter((account) => account.isOwnedByCurrentUser);
  const reconnectHref = (account) => {
    const key = ['facebook', 'instagram'].includes(account.platform) ? 'meta' : account.platform;
    return `/integrations/social/${key}/connect?projectId=${project._id}`;
  };
%>

<div class="app-layout">
  <%- include('../../partials/project-sidebar', { project, activeSection: 'social' }) %>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Social Publishing</h1>
        <p>Connect the accounts Moyi can publish approved calendar posts to. Nothing posts until a human approves the draft.</p>
      </div>
      <div class="row-actions">
        <a class="button" href="/projects/<%= project._id %>/calendar">Open Calendar</a>
      </div>
    </div>

    <% if (errorMessage) { %><div class="form-error"><%= errorMessage %></div><% } %>
    <% if (successMessage) { %><div class="image-success-message"><%= successMessage %></div><% } %>

    <%- include('../partials/project-connected-workflow', { project, activeWorkflowStep: 'execution' }) %>

    <section class="studio-summary" aria-label="Social publishing summary">
      <div><span>Connected</span><strong><%= accounts.filter((account) => account.status === 'connected').length %></strong></div>
      <div><span>Active Channels</span><strong><%= readyNativeProviders.length %>/<%= nativeProviderKeys.length %></strong></div>
      <div><span>Publish actions</span><strong><%= recentActions.length %></strong></div>
      <div><span>Human approval</span><strong>On</strong></div>
    </section>

    <% if (userCanManageProject) { %>
    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>One-click account connection</h2>
          <p>Connect your verified brand channels for scheduled and instant multi-platform publishing.</p>
        </div>
      </div>
      <div class="social-connect-grid">
        <% providerCards.forEach((provider) => { %>
          <%
            const providerInfo = readiness.providers ? readiness.providers[provider.key] : null;
            const platformAccounts = provider.key === 'meta'
              ? connectedByPlatform(['facebook', 'instagram'])
              : connectedByPlatform([provider.key]);
            const ownedPlatformAccounts = provider.key === 'meta'
              ? ownedConnectedByPlatform(['facebook', 'instagram'])
              : ownedConnectedByPlatform([provider.key]);
          %>
          <article class="social-connect-card">
            <div>
              <span class="status <%= platformAccounts.length ? 'status-success' : (providerInfo && !providerInfo.ready ? 'status-available-soon' : '') %>" <%= !platformAccounts.length && providerInfo && !providerInfo.ready ? 'style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.28); font-weight: 600;"' : '' %>><%= platformAccounts.length ? 'Connected' : (providerInfo && !providerInfo.ready ? 'Available soon' : 'Not connected') %></span>
              <h3><%= provider.label %></h3>
              <p><%= provider.body %></p>
            </div>
            <% if (platformAccounts.length) { %>
              <ul class="clean-list compact-list">
                <% platformAccounts.forEach((account) => { %>
                  <li>
                    <strong><%= account.accountName %></strong>
                    <span><%= account.platform %><%= account.visibility === 'project' && !account.isOwnedByCurrentUser ? ' · shared' : '' %></span>
                  </li>
                <% }) %>
              </ul>
            <% } %>
            <% if (providerInfo && !providerInfo.ready) { %>
              <p class="empty" style="color: var(--saas-text-muted, rgba(245, 247, 255, 0.6)); font-size: 0.88rem;">1-click connection for <%= provider.label %> will be available soon.</p>
              <button class="button" type="button" disabled style="opacity: 0.6; cursor: not-allowed;">Available soon</button>
            <% } else if (provider.needsHandle) { %>
              <form class="form social-handle-connect" action="/integrations/social/bluesky/connect" method="get">
                <input type="hidden" name="projectId" value="<%= project._id %>">
                <label>Bluesky handle <input name="handle" placeholder="name.bsky.social" autocomplete="username" required></label>
                <button class="button button-primary" type="submit"><%= ownedPlatformAccounts.length ? 'Reconnect' : 'Connect Bluesky' %></button>
              </form>
            <% } else { %>
              <a class="button button-primary" href="<%= provider.href %>"><%= ownedPlatformAccounts.length ? 'Reconnect' : `Connect ${provider.label}` %></a>
            <% } %>
          </article>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Connected accounts</h2>
          <p>These are the publishing targets Moyi can use from the content calendar.</p>
        </div>
      </div>
      <% if (!accounts.length) { %>
        <p class="empty">No social accounts connected yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="connected-social-table">
            <thead>
              <tr>
                <th>Platform</th>
                <th>Account</th>
                <th>Status</th>
                <th>Access</th>
                <th>Token renewal</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% accounts.forEach((account) => { %>
                <tr>
                  <td data-label="Platform"><strong><%= account.platform %></strong></td>
                  <td data-label="Account"><%= account.accountName %></td>
                  <td data-label="Status">
                    <span class="status <%= account.status === 'connected' ? 'status-success' : 'publish-status-failed' %>"><%= account.status %></span>
                    <% if (account.statusMessage && account.status !== 'connected') { %><small class="connection-status-message"><%= account.statusMessage %></small><% } %>
                  </td>
                  <td data-label="Access">
                    <span class="status"><%= account.visibility === 'project' ? 'Agency shared' : 'Private' %></span>
                  </td>
                  <td data-label="Token renewal"><%= account.tokenExpiresAt ? account.tokenExpiresAt.toLocaleString() : (account.platform === 'bluesky' ? 'Managed session' : 'No expiry reported') %></td>
                  <td data-label="Actions">
                    <% if (userCanManageProject && account.isOwnedByCurrentUser && account.status === 'reconnect_required') { %><a class="button button-primary button-small" href="<%= reconnectHref(account) %>">Reconnect</a><% } %>
                    <% if (userCanManageProject && account.isOwnedByCurrentUser && project.organizationId) { %>
                      <form action="/projects/<%= project._id %>/integrations/social/<%= account.id %>/visibility" method="post">
                        <input type="hidden" name="visibility" value="<%= account.visibility === 'project' ? 'private' : 'project' %>">
                        <button class="button button-small" type="submit"><%= account.visibility === 'project' ? 'Make private' : 'Share with agency' %></button>
                      </form>
                    <% } %>
                    <% if (userCanManageProject && account.isOwnedByCurrentUser && account.status !== 'disconnected') { %>
                      <form action="/projects/<%= project._id %>/integrations/social/<%= account.id %>/disconnect" method="post">
                        <button class="button button-small" type="submit">Disconnect</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Publish history</h2>
          <p>Latest social publishing attempts for this project.</p>
        </div>
      </div>
      <% if (!recentActions.length) { %>
        <p class="empty">No social publishing actions recorded yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="social-history-table">
            <thead>
              <tr>
                <th>When</th>
                <th>Target</th>
                <th>Action</th>
                <th>Status</th>
                <th>Result</th>
              </tr>
            </thead>
            <tbody>
              <% recentActions.forEach((action) => { %>
                <tr>
                  <td data-label="When"><%= action.createdAt.toLocaleString() %></td>
                  <td data-label="Target"><%= action.integrationType %></td>
                  <td data-label="Action"><%= action.actionType.replace(/_/g, ' ') %></td>
                  <td data-label="Status"><span class="status <%= action.status === 'success' ? 'status-success' : '' %>"><%= action.status %></span></td>
                  <td data-label="Result"><%= action.externalId || action.errorMessage || 'Recorded' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </section>
</div>

<%- include('../../partials/footer') %>
