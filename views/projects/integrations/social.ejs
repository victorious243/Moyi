<%- include('../../partials/header') %>

<%
  const readiness = typeof socialReadiness !== 'undefined' ? socialReadiness : { providers: {} };
  const providerCards = [
    {
      key: 'linkedin',
      label: 'LinkedIn',
      body: 'Connect a LinkedIn member or company-page capable account for thought leadership and product updates.',
      href: `/integrations/social/linkedin/connect?projectId=${project._id}`
    },
    {
      key: 'x',
      label: 'X',
      body: 'Connect an X account for short updates and launch posts.',
      href: `/integrations/social/x/connect?projectId=${project._id}`
    },
    {
      key: 'meta',
      label: 'Facebook and Instagram',
      body: 'Connect Meta once. Moyi stores Facebook Page and Instagram Business targets separately when both are available.',
      href: `/integrations/social/meta/connect?projectId=${project._id}`
    }
  ];
  const connectedByPlatform = (platforms) => accounts.filter((account) => platforms.includes(account.platform) && account.status === 'connected');
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/integrations/wordpress">WordPress</a>
    <a href="/projects/<%= project._id %>/integrations/webflow">Webflow</a>
    <a href="/projects/<%= project._id %>/integrations/shopify">Shopify</a>
    <a href="/projects/<%= project._id %>/integrations/social" class="active">Social Accounts</a>
    <a href="/projects/<%= project._id %>/integrations/webhook">Webhook</a>
    <a href="/projects/<%= project._id %>/content">Approval Queue</a>
    <a href="/projects/<%= project._id %>/calendar">Calendar</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Social Publishing</h1>
        <p>Connect the accounts Moyi can publish approved calendar posts to. Nothing posts until a human approves the draft.</p>
      </div>
      <div class="row-actions">
        <a class="button" href="/projects/<%= project._id %>/calendar">Open Calendar</a>
      </div>
    </div>

    <% if (errorMessage) { %><div class="form-error"><%= errorMessage %></div><% } %>
    <% if (successMessage) { %><div class="image-success-message"><%= successMessage %></div><% } %>

    <section class="studio-summary" aria-label="Social publishing summary">
      <div><span>Connected</span><strong><%= accounts.filter((account) => account.status === 'connected').length %></strong></div>
      <div><span>OAuth ready</span><strong><%= (readiness.configuredProviders || []).length %>/3</strong></div>
      <div><span>Publish actions</span><strong><%= recentActions.length %></strong></div>
      <div><span>Human approval</span><strong>On</strong></div>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>One-click account connection</h2>
          <p>Use OAuth for the cleanest customer setup. Provider apps still need the right live credentials and approved permissions.</p>
        </div>
      </div>
      <div class="social-connect-grid">
        <% providerCards.forEach((provider) => { %>
          <%
            const providerInfo = readiness.providers ? readiness.providers[provider.key] : null;
            const platformAccounts = provider.key === 'meta'
              ? connectedByPlatform(['facebook', 'instagram'])
              : connectedByPlatform([provider.key]);
          %>
          <article class="social-connect-card">
            <div>
              <span class="status <%= platformAccounts.length ? 'status-success' : '' %>"><%= platformAccounts.length ? 'Connected' : 'Not connected' %></span>
              <h3><%= provider.label %></h3>
              <p><%= provider.body %></p>
            </div>
            <% if (platformAccounts.length) { %>
              <ul class="clean-list compact-list">
                <% platformAccounts.forEach((account) => { %>
                  <li><strong><%= account.accountName %></strong> <span><%= account.platform %></span></li>
                <% }) %>
              </ul>
            <% } %>
            <% if (providerInfo && !providerInfo.ready) { %>
              <p class="empty">Missing env: <%= providerInfo.missingKeys.join(', ') %></p>
              <p class="empty">Callback: <code><%= providerInfo.callbackUrl %></code></p>
            <% } %>
            <a class="button button-primary" href="<%= provider.href %>"><%= platformAccounts.length ? 'Reconnect' : `Connect ${provider.label}` %></a>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Connected accounts</h2>
          <p>These are the publishing targets Moyi can use from the content calendar.</p>
        </div>
      </div>
      <% if (!accounts.length) { %>
        <p class="empty">No social accounts connected yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Platform</th>
                <th>Account</th>
                <th>External ID</th>
                <th>Status</th>
                <th>Last sync</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% accounts.forEach((account) => { %>
                <tr>
                  <td><strong><%= account.platform %></strong></td>
                  <td><%= account.accountName %></td>
                  <td><%= account.externalAccountId || account.webhookUrl || 'Stored securely' %></td>
                  <td><span class="status <%= account.status === 'connected' ? 'status-success' : '' %>"><%= account.status %></span></td>
                  <td><%= account.lastSyncAt ? account.lastSyncAt.toLocaleString() : 'Not synced' %></td>
                  <td>
                    <% if (account.status === 'connected') { %>
                      <form action="/projects/<%= project._id %>/integrations/social/<%= account.id %>/disconnect" method="post">
                        <button class="button button-small" type="submit">Disconnect</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel social-setup-grid">
      <div>
        <h2>Manual API or aggregator token</h2>
        <p class="empty">Use this for server-side tokens or Ayrshare. Tokens are encrypted before storage.</p>
        <form class="form" action="/projects/<%= project._id %>/integrations/social/api/connect" method="post">
          <label>Platform
            <select name="platform" required>
              <option value="linkedin">LinkedIn</option>
              <option value="x">X</option>
              <option value="facebook">Facebook Page</option>
              <option value="instagram">Instagram Business</option>
              <option value="ayrshare">Ayrshare</option>
            </select>
          </label>
          <label>Account label <input name="accountName" maxlength="140" placeholder="Company LinkedIn page" required></label>
          <label>External account ID <input name="externalAccountId" maxlength="220" placeholder="Page ID, Instagram Business ID, author URN, or user ID"></label>
          <label>Access token <input name="accessToken" type="password" autocomplete="off" required></label>
          <label>Refresh token <input name="refreshToken" type="password" autocomplete="off"></label>
          <button class="button button-primary" type="submit">Save API Account</button>
        </form>
      </div>

      <div>
        <h2>Webhook publishing target</h2>
        <p class="empty">Use this for Make, Zapier, n8n, a custom frontend, or any platform Moyi should send approved post payloads to.</p>
        <form class="form" action="/projects/<%= project._id %>/integrations/social/webhook/connect" method="post">
          <label>Route as
            <select name="platform">
              <option value="webhook">Custom webhook</option>
              <option value="linkedin">LinkedIn automation</option>
              <option value="x">X automation</option>
              <option value="facebook">Facebook automation</option>
              <option value="instagram">Instagram automation</option>
              <option value="youtube">YouTube automation</option>
              <option value="tiktok">TikTok automation</option>
            </select>
          </label>
          <label>Account label <input name="accountName" maxlength="140" placeholder="Make social router" required></label>
          <label>Webhook URL <input name="webhookUrl" type="url" placeholder="https://hook.example.com/moyi-social" required></label>
          <label>Signing secret <input name="webhookSecret" type="password" autocomplete="off" placeholder="Optional HMAC secret"></label>
          <button class="button" type="submit">Save Webhook Target</button>
        </form>
      </div>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Publish history</h2>
          <p>Latest social publishing attempts for this project.</p>
        </div>
      </div>
      <% if (!recentActions.length) { %>
        <p class="empty">No social publishing actions recorded yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>When</th>
                <th>Target</th>
                <th>Action</th>
                <th>Status</th>
                <th>Result</th>
              </tr>
            </thead>
            <tbody>
              <% recentActions.forEach((action) => { %>
                <tr>
                  <td><%= action.createdAt.toLocaleString() %></td>
                  <td><%= action.integrationType %></td>
                  <td><%= action.actionType.replace(/_/g, ' ') %></td>
                  <td><span class="status <%= action.status === 'success' ? 'status-success' : '' %>"><%= action.status %></span></td>
                  <td><%= action.externalId || action.errorMessage || 'Recorded' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </section>
</div>

<%- include('../../partials/footer') %>
