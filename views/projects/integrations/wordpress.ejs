<%- include('../../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/integrations/wordpress">WordPress</a>
    <a href="/projects/<%= project._id %>/integrations/webflow">Webflow</a>
    <a href="/projects/<%= project._id %>/integrations/shopify">Shopify</a>
    <a href="/projects/<%= project._id %>/integrations/webhook">Webhook</a>
    <a href="/projects/<%= project._id %>/content">Approval Queue</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>WordPress Integration</h1>
      </div>
      <div class="row-actions">
        <% if (integration) { %>
          <form action="/projects/<%= project._id %>/integrations/wordpress/test" method="post">
            <button class="button button-primary" type="submit">Test Connection</button>
          </form>
          <a class="button" href="/projects/<%= project._id %>/integrations/wordpress/pages">Fetch Posts & Pages</a>
        <% } %>
      </div>
    </div>

    <% if (errorMessage) { %>
      <section class="panel notice-panel">
        <h2>WordPress issue</h2>
        <p class="empty"><%= errorMessage %></p>
      </section>
    <% } %>

    <% if (successMessage) { %>
      <section class="panel">
        <h2>WordPress updated</h2>
        <p class="empty"><%= successMessage %></p>
      </section>
    <% } %>

    <section class="metrics">
      <article><span>Status</span><strong><%= integration ? integration.status : 'not set' %></strong></article>
      <article><span>Site</span><strong><%= integration ? integration.siteUrl.replace(/^https?:\/\//, '') : 'none' %></strong></article>
      <article><span>User</span><strong><%= integration ? integration.username : 'none' %></strong></article>
      <article><span>Last tested</span><strong><%= integration && integration.lastTestedAt ? integration.lastTestedAt.toLocaleDateString() : 'never' %></strong></article>
    </section>

    <section class="panel">
      <h2>Connection Settings</h2>
      <form class="form grid-form" action="/projects/<%= project._id %>/integrations/wordpress/connect" method="post">
        <label>
          WordPress site URL
          <input type="url" name="siteUrl" value="<%= integration ? integration.siteUrl : project.websiteUrl %>" required>
        </label>
        <label>
          Username
          <input type="text" name="username" value="<%= integration ? integration.username : '' %>" required>
        </label>
        <label class="full">
          Application password
          <input type="password" name="appPassword" placeholder="<%= integration ? 'Enter a new password to replace saved credentials' : 'WordPress application password' %>" required>
        </label>
        <button class="button button-primary" type="submit">Save WordPress Credentials</button>
      </form>
      <p class="empty">Application passwords are encrypted before storage and are never shown after saving.</p>
    </section>

    <section class="panel">
      <h2>Publishing Rules</h2>
      <ul class="clean-list">
        <li>Only approved content drafts can be sent to WordPress.</li>
        <li>Blog articles become WordPress draft posts, never published posts.</li>
        <li>FAQ sections, service page sections, and metadata suggestions are export-only in this MVP.</li>
        <li>No live page is overwritten automatically.</li>
      </ul>
    </section>

    <section class="panel">
      <h2>Recent Publish Actions</h2>
      <% if (!recentActions.length) { %>
        <p class="empty">No WordPress publish actions yet.</p>
      <% } else { %>
        <div class="table-scroll">
          <table class="data-table compact-table">
            <thead><tr><th>Action</th><th>Status</th><th>External ID</th><th>Error</th><th>Date</th></tr></thead>
            <tbody>
              <% recentActions.forEach((action) => { %>
                <tr>
                  <td><%= action.actionType.replace(/_/g, ' ') %></td>
                  <td><span class="status"><%= action.status %></span></td>
                  <td><%= action.externalId || '-' %></td>
                  <td><%= action.errorMessage || '-' %></td>
                  <td><%= action.createdAt.toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </section>
</div>

<%- include('../../partials/footer') %>
