<%- include('../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong><%= project.name %></strong>
    <a href="/projects/<%= project._id %>">CMO Overview</a>
    <a href="/projects/<%= project._id %>/content">Content Studio</a>
    <a href="/projects/<%= project._id %>/calendar">Content Calendar</a>
    <a class="active" href="/projects/<%= project._id %>/campaigns">Campaigns</a>
  </aside>

  <section class="app-main">
    <nav class="project-command-nav" aria-label="Content operations">
      <a href="/projects/<%= project._id %>/content"><strong>Content Studio</strong><span>Create and review</span></a>
      <a href="/projects/<%= project._id %>/calendar"><strong>Calendar</strong><span>See what goes out</span></a>
      <a class="is-active" href="/projects/<%= project._id %>/campaigns"><strong>Campaigns</strong><span>Track each objective</span></a>
    </nav>

    <div class="page-heading content-studio-heading">
      <div><p class="eyebrow"><%= project.name %></p><h1>Campaigns</h1><p>Keep every content plan tied to a clear objective, schedule, and review state.</p></div>
      <a class="button button-primary" href="/projects/<%= project._id %>/content#planner">New Campaign Plan</a>
    </div>

    <% if (successMessage) { %><div class="image-success-message"><%= successMessage %></div><% } %>

    <% if (!campaigns.length) { %>
      <section class="calendar-empty-state">
        <p class="eyebrow">No campaigns yet</p>
        <h2>Start with the business objective</h2>
        <p>Choose a single post, weekly plan, or monthly plan. Moyi will create the campaign and schedule its drafts together.</p>
        <a class="button button-primary" href="/projects/<%= project._id %>/content#planner">Create Campaign Plan</a>
      </section>
    <% } %>

    <div class="campaign-register">
      <% campaigns.forEach((campaign) => { %>
        <%
          const campaignDrafts = socialDrafts.filter((draft) => draft.campaignId && draft.campaignId.toString() === campaign._id.toString());
          const approvedCount = campaignDrafts.filter((draft) => ['approved', 'published_manually'].includes(draft.status)).length;
          const progress = campaignDrafts.length ? Math.round(approvedCount / campaignDrafts.length * 100) : 0;
        %>
        <article class="campaign-register-row">
          <div class="campaign-register-main">
            <span class="status"><%= campaign.cadence || 'custom' %> · <%= campaign.channel %></span>
            <h2><%= campaign.name %></h2>
            <p><%= campaign.goal || 'No campaign objective recorded.' %></p>
          </div>
          <div class="campaign-register-progress">
            <span><%= approvedCount %> of <%= campaignDrafts.length %> reviewed</span>
            <div><i style="width:<%= progress %>%"></i></div>
            <small><%= campaign.startDate.toLocaleDateString() %> – <%= campaign.endDate.toLocaleDateString() %></small>
          </div>
          <a class="button" href="/projects/<%= project._id %>/calendar">Open Calendar</a>
        </article>
      <% }) %>
    </div>

    <section class="campaign-safety-note">
      <strong>Human-controlled publishing</strong>
      <span>Moyi prepares and organizes drafts. Review remains required, and nothing is posted automatically.</span>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
