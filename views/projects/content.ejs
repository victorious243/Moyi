<%- include('../partials/header') %>
<link rel="stylesheet" href="/stylesheets/content-calendar.css?v=20260826">

<%
  const reviewDrafts = drafts.filter((draft) => ['draft', 'awaiting_review', 'needs_revision'].includes(draft.status));
  const completedDrafts = drafts.filter((draft) => ['approved', 'published_manually'].includes(draft.status));
  const scheduledCount = socialDrafts.filter((draft) => draft.status === 'draft').length;
  const currentJob = typeof job !== 'undefined' ? job : null;
  const recentPipelineDrafts = typeof pipelineDrafts !== 'undefined' ? pipelineDrafts : [];
%>

<div class="app-layout">
  <%- include('../partials/project-sidebar', { project, activeSection: 'content' }) %>

  <section
    class="app-main project-content-workspace content-calendar-workspace"
    <% if (currentJob && (currentJob.status === 'queued' || currentJob.status === 'running')) { %>
      data-live-job
      data-live-job-endpoint="/projects/<%= project._id %>/jobs/<%= currentJob._id %>"
      data-initial-job-status="<%= currentJob.status %>"
    <% } %>
  >
    <%- include('../partials/project-content-nav', { project, activeSection: 'content' }) %>

    <header class="content-workspace-page-header calendar-page-header">
      <div class="calendar-heading-copy">
        <p class="eyebrow"><%= project.name %></p>
        <h1>Content Studio</h1>
        <p class="calendar-subtitle">Create a post or build an organized campaign plan. Everything generated appears below and in the calendar.</p>
        <div class="calendar-header-kpis" aria-label="Overview metrics">
          <span class="cal-kpi-item"><strong><%= reviewDrafts.length %></strong> Needs review</span>
          <span class="cal-kpi-dot">·</span>
          <span class="cal-kpi-item"><strong><%= completedDrafts.length %></strong> Approved assets</span>
          <span class="cal-kpi-dot">·</span>
          <span class="cal-kpi-item"><strong><%= scheduledCount %></strong> Scheduled posts</span>
          <span class="cal-kpi-dot">·</span>
          <span class="cal-kpi-item"><strong><%= campaigns.length %></strong> Campaigns</span>
        </div>
      </div>
      <div class="calendar-header-actions">
        <a class="button button-secondary button-open-calendar" href="/projects/<%= project._id %>/calendar">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="2"/><path d="M2 7h12M5 1v3M11 1v3"/></svg>
          <span>Open Calendar</span>
        </a>
        <a class="button button-create" href="#planner">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
          <span>Create Plan</span>
        </a>
      </div>
    </header>

    <% if (currentJob && (currentJob.status === 'queued' || currentJob.status === 'running')) { %>
      <section class="calendar-inline-job studio-job-bar" role="status">
        <span class="calendar-live-dot"></span>
        <strong>Content pipeline running</strong>
        <span data-job-step><%= currentJob.currentStep || 'Preparing evidence-backed content assets' %></span>
        <span data-job-progress><%= currentJob.progressPercent || 0 %>%</span>
        <span class="status" data-job-status hidden><%= currentJob.status %></span>
        <span data-job-error-row hidden><span data-job-error></span></span>
      </section>
    <% } %>

    <% if (currentJob && currentJob.status === 'failed') { %>
      <section class="panel notice-panel">
        <h2>Content pipeline failed</h2>
        <p><%= currentJob.errorMessage || 'The content pipeline could not complete.' %></p>
        <form action="/projects/<%= project._id %>/jobs/<%= currentJob._id %>/retry" method="post"><button class="button button-primary" type="submit">Retry Pipeline</button></form>
      </section>
    <% } %>

    <% if (successMessage) { %><div class="image-success-message"><%= successMessage %></div><% } %>
    <% if (errorMessage) { %><section class="panel notice-panel"><strong>Plan creation failed</strong><p><%= errorMessage %></p></section><% } %>

    <%- include('./partials/project-connected-workflow', { project, activeWorkflowStep: 'execution' }) %>

    <!-- Instant 30-Day Omnichannel Growth Pack Card -->
    <section class="panel growth-pack-panel">
      <div class="growth-pack-content">
        <div class="growth-pack-text">
          <div class="growth-pack-badge">
            ⚡ Instant 1-Click Engine
          </div>
          <h2>Launch Instant 30-Day Growth Pack</h2>
          <p>
            Point Moyi at your URL to instantly generate a complete omnichannel pipeline: <strong>1 Comparison Article</strong>, <strong>4 Social Posts</strong>, <strong>2 Paid Ads</strong>, <strong>1 Executive Newsletter</strong>, and <strong>1 Page Improvement Brief</strong>.
          </p>
        </div>
        <form action="/projects/<%= project._id %>/growth-pack" method="post" class="growth-pack-form" data-loading-state="Generating Instant 30-Day Growth Pack...">
          <input type="hidden" name="targetUrl" value="<%= project.websiteUrl %>">
          <input type="hidden" name="keyword" value="<%= project.mainOffer || 'AI Marketing' %>">
          <button class="button button-primary button-growth-pack" type="submit">
            <span>🚀 Generate Instant Growth Pack</span>
          </button>
        </form>
      </div>
    </section>

    <section class="campaign-composer" id="planner">
      <div class="campaign-composer-intro">
        <p class="eyebrow">Create new content</p>
        <h2>What should Moyi plan?</h2>
        <p>Give Moyi the campaign objective. It will use this project’s real audience, offer, website, and tone to prepare drafts for review.</p>
      </div>
      <form action="/projects/<%= project._id %>/content-plan" method="post" data-loading-state="Building your campaign content plan">
        <fieldset class="cadence-selector">
          <legend>Plan length</legend>
          <label><input type="radio" name="cadence" value="single" checked><span><strong>Single post</strong><small>One focused draft</small></span></label>
          <label><input type="radio" name="cadence" value="weekly"><span><strong>Weekly plan</strong><small>5 scheduled posts</small></span></label>
          <label><input type="radio" name="cadence" value="monthly"><span><strong>Monthly plan</strong><small>12 scheduled posts</small></span></label>
        </fieldset>
        <div class="campaign-composer-fields">
          <label>Campaign name <input name="name" maxlength="160" placeholder="August product education" required></label>
          <label>Channel
            <select name="channel" required>
              <option value="multi">Multi-channel</option>
              <option value="bluesky">Bluesky</option>
              <option value="linkedin">LinkedIn</option>
              <option value="instagram">Instagram</option>
              <option value="facebook">Facebook</option>
              <option value="threads">Threads</option>
              <option value="tiktok">TikTok</option>
              <option value="youtube">YouTube</option>
              <option value="x">X</option>
              <option value="email">Email</option>
            </select>
          </label>
          <label>Start date <input type="date" name="startDate" value="<%= today %>" required></label>
          <label class="full">Campaign objective <textarea name="goal" rows="4" maxlength="500" placeholder="What are we promoting, who needs it, and what action should they take?" required></textarea></label>
        </div>
        <div class="campaign-composer-submit">
          <span>Drafts are scheduled for review. Nothing posts automatically.</span>
          <button class="button button-primary" type="submit">Create Content Plan</button>
        </div>
      </form>
    </section>

    <section class="studio-section-heading">
      <div><p class="eyebrow">Generated work</p><h2>Find everything here</h2></div>
      <a class="studio-view-all-link" href="/projects/<%= project._id %>/calendar">
        <span>View scheduled work</span>
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3L11 8L6 13"/></svg>
      </a>
    </section>

    <div class="studio-library-grid">
      <section class="studio-library">
        <div class="studio-library-title">
          <h2>Content assets</h2>
          <span class="studio-badge"><%= drafts.length %></span>
        </div>
        <% if (!drafts.length) { %>
          <div class="studio-empty-box">
            <p class="empty">No website or article assets yet. Generate them from a growth opportunity.</p>
            <a class="button button-small" href="/projects/<%= project._id %>/recommendations">Open Growth Opportunities</a>
          </div>
        <% } else { %>
          <div class="studio-work-list">
            <% drafts.slice(0, 12).forEach((draft) => { %>
              <a href="/content/<%= draft._id %>" class="studio-work-item">
                <div class="studio-item-main">
                  <strong><%= draft.title || 'Untitled asset' %></strong>
                  <span><%= draft.type.replace(/_/g, ' ') %></span>
                </div>
                <span class="status status-<%= draft.status %>"><%= draft.status.replace(/_/g, ' ') %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="studio-library">
        <div class="studio-library-title">
          <h2>Campaign posts</h2>
          <span class="studio-badge"><%= socialDrafts.length %></span>
        </div>
        <% if (!socialDrafts.length) { %>
          <div class="studio-empty-box">
            <p class="empty">No campaign posts yet. Use the planner above to create one post, a week, or a month.</p>
          </div>
        <% } else { %>
          <div class="studio-work-list">
            <% socialDrafts.forEach((draft) => { %>
              <a href="/projects/<%= project._id %>/calendar#post-<%= draft._id %>" class="studio-work-item">
                <div class="studio-item-main">
                  <strong><%= draft.title || 'Untitled post' %></strong>
                  <span><%= draft.channel %> · <%= draft.scheduledFor.toLocaleDateString() %></span>
                </div>
                <span class="status status-<%= draft.status %>"><%= draft.status.replace(/_/g, ' ') %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>

    <% if (recentPipelineDrafts.length) { %>
      <section class="panel studio-pipeline-panel">
        <div class="panel-title">
          <h2>Just generated</h2>
          <span class="status"><%= recentPipelineDrafts.length %> assets</span>
        </div>
        <div class="content-card-grid">
          <% recentPipelineDrafts.forEach((draft) => { %>
            <a class="content-card" href="/content/<%= draft._id %>">
              <strong><%= draft.title || 'Untitled draft' %></strong>
              <span><%= draft.type.replace(/_/g, ' ') %></span>
              <p><%= draft.body.slice(0, 180) %></p>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </section>
</div>

<%- include('partials/mobile-workspace-actions', {
  project,
  activeSection: 'content',
  showCreate: true,
  createHref: '#planner'
}) %>

<%- include('../partials/footer') %>
