<%- include('../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/recommendations">Recommendations</a>
    <a href="/projects/<%= project._id %>/ai-report/latest">AI CMO Plan</a>
    <a href="/projects/<%= project._id %>/calendar">Calendar</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Approval Queue</h1>
      </div>
      <a class="button" href="/projects/<%= project._id %>/recommendations">Generate from recommendations</a>
      <a class="button" href="/projects/<%= project._id %>/calendar">Calendar</a>
    </div>

    <section class="panel">
      <div class="panel-title">
        <h2>Drafts needing review</h2>
        <span class="status"><%= drafts.filter((draft) => ['draft', 'awaiting_review', 'needs_revision'].includes(draft.status)).length %> drafts</span>
      </div>
      <% const queueDrafts = drafts.filter((draft) => ['draft', 'awaiting_review', 'needs_revision'].includes(draft.status)); %>
      <% if (!queueDrafts.length) { %>
        <p class="empty">No drafts are waiting for approval.</p>
      <% } %>
      <div class="content-card-grid">
        <% queueDrafts.forEach((draft) => { %>
          <a class="content-card" href="/content/<%= draft._id %>">
            <span class="status"><%= draft.type.replace(/_/g, ' ') %> / <%= draft.status.replace(/_/g, ' ') %></span>
            <strong><%= draft.title || 'Untitled draft' %></strong>
            <small><%= draft.targetUrl %></small>
            <p><%= draft.body.slice(0, 150) %><%= draft.body.length > 150 ? '...' : '' %></p>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="panel">
      <h2>Content History</h2>
      <% if (!drafts.length) { %>
        <p class="empty">No content drafts have been generated yet.</p>
      <% } %>
      <div class="scan-list">
        <% drafts.forEach((draft) => { %>
          <a class="scan-row" href="/content/<%= draft._id %>">
            <strong><%= draft.title || draft.type.replace(/_/g, ' ') %></strong>
            <span><%= draft.type.replace(/_/g, ' ') %></span>
            <span><%= draft.status.replace(/_/g, ' ') %></span>
            <span><%= draft.updatedAt.toLocaleString() %></span>
          </a>
        <% }) %>
      </div>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
