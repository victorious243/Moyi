<%- include('../partials/header') %>

<%
  const selectedView = typeof currentView !== 'undefined' ? currentView : 'active';
  const visibleRecommendations = recommendations.filter((recommendation) => {
    if (selectedView === 'all') return true;
    if (selectedView === 'rejected') return recommendation.status === 'rejected';
    if (selectedView === 'done') return recommendation.status === 'done';
    return !['rejected', 'done'].includes(recommendation.status);
  });
  const counts = typeof recommendationCounts !== 'undefined'
    ? recommendationCounts
    : recommendations.reduce((summary, recommendation) => {
        summary.all += 1;
        if (recommendation.status === 'rejected') summary.rejected += 1;
        else if (recommendation.status === 'done') summary.done += 1;
        else summary.active += 1;
        return summary;
      }, { active: 0, rejected: 0, done: 0, all: 0 });
  const statusSuccess = typeof successMessage !== 'undefined' ? successMessage : '';
  const actionLabels = {
    pending: 'Restore',
    accepted: 'Accept',
    rejected: 'Reject',
    in_progress: 'Start',
    done: 'Complete'
  };
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/ai-report/latest">AI CMO Plan</a>
    <a href="/projects/<%= project._id %>/scans">Scan History</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Recommendations</h1>
      </div>
      <form action="/projects/<%= project._id %>/ai-report" method="post">
        <button class="button button-primary" type="submit">Generate AI CMO Plan</button>
      </form>
    </div>

    <% if (statusSuccess) { %>
      <section class="panel notice-panel">
        <p><%= statusSuccess %></p>
      </section>
    <% } %>

    <nav class="recommendation-filters" aria-label="Recommendation views">
      <% ['active', 'rejected', 'done', 'all'].forEach((view) => { %>
        <a class="<%= selectedView === view ? 'is-active' : '' %>" href="/projects/<%= project._id %>/recommendations?view=<%= view %>">
          <%= view === 'done' ? 'Completed' : view.charAt(0).toUpperCase() + view.slice(1) %>
          <span><%= counts[view] || 0 %></span>
        </a>
      <% }) %>
    </nav>

    <% if (!visibleRecommendations.length) { %>
      <section class="panel">
        <p class="empty">
          <%= selectedView === 'active'
            ? 'No active recommendations. Complete a website scan to generate evidence-backed actions automatically.'
            : `No ${selectedView === 'done' ? 'completed' : selectedView} recommendations.` %>
        </p>
      </section>
    <% } %>

    <section class="panel">
      <h2>Review policy</h2>
      <p class="empty">Recommendations stay in the status you choose. Moyi does not auto-accept, auto-reject, or silently move work forward in the background.</p>
    </section>

    <section class="recommendation-grid">
      <% visibleRecommendations.forEach((recommendation) => { %>
        <article class="recommendation-card">
          <div class="panel-title">
            <span class="status">Priority <%= recommendation.priority %></span>
            <span class="status"><%= recommendation.status.replace('_', ' ') %></span>
          </div>
          <% if (recommendation.auditId && recommendation.auditId._id) { %>
            <p class="empty">
              Source scan:
              <a href="/projects/<%= project._id %>/scans/<%= recommendation.auditId._id %>">
                <%= recommendation.auditId.completedAt
                  ? new Date(recommendation.auditId.completedAt).toLocaleString()
                  : new Date(recommendation.auditId.createdAt).toLocaleString() %>
              </a>
            </p>
          <% } %>
          <h2><%= recommendation.title %></h2>
          <p><strong>Impact:</strong> <%= recommendation.expectedImpact || 'Not specified' %></p>
          <p><strong>Effort:</strong> <%= recommendation.effort %></p>
          <p><strong>Action:</strong> <%= recommendation.actionType.replace('_', ' ') %></p>
          <p><strong>Reason:</strong> <%= recommendation.reason %></p>
          <% if (recommendation.assetOptions && recommendation.assetOptions.length) { %>
            <div>
              <strong>Execution pipeline</strong>
              <ul class="clean-list">
                <% recommendation.assetOptions.forEach((option) => { %>
                  <li><strong><%= option.label %>:</strong> <%= option.description %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <div>
            <strong>Affected pages</strong>
            <ul class="clean-list">
              <% recommendation.targetUrls.forEach((url) => { %>
                <li><a href="<%= url %>" target="_blank" rel="noreferrer"><%= url %></a></li>
              <% }) %>
            </ul>
          </div>
          <div class="status-actions">
            <% const availableActions = recommendation.status === 'rejected' || recommendation.status === 'done'
              ? ['pending']
              : ['accepted', 'rejected', 'in_progress', 'done']; %>
            <% availableActions.forEach((status) => { %>
              <form action="/recommendations/<%= recommendation._id %>/status" method="post">
                <input type="hidden" name="status" value="<%= status %>">
                <button
                  class="button <%= status === 'accepted' ? 'button-primary' : '' %>"
                  type="submit"
                  <%= recommendation.status === status ? 'disabled' : '' %>
                ><%= actionLabels[status] %></button>
              </form>
            <% }) %>
          </div>
          <% if (['accepted', 'in_progress', 'done'].includes(recommendation.status)) { %>
            <div class="content-generate-panel">
              <strong>Build execution assets</strong>
              <form
                class="form compact-form"
                action="/recommendations/<%= recommendation._id %>/generate-content"
                method="post"
                data-loading-state="Generating <%= (recommendation.assetOptions || []).length %> evidence-backed pipeline assets"
              >
                <input name="keyword" placeholder="Optional keyword">
                <button class="button button-primary" type="submit">
                  Generate <%= (recommendation.assetOptions || []).length %> Pipeline Assets
                </button>
              </form>
              <div class="status-actions">
                <% (recommendation.assetOptions || []).forEach((option) => { %>
                  <form
                    action="/recommendations/<%= recommendation._id %>/generate-content"
                    method="post"
                    data-loading-state="Generating <%= option.label %>"
                  >
                    <input type="hidden" name="type" value="<%= option.type %>">
                    <button class="button" type="submit"><%= option.label %></button>
                  </form>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <p class="empty">Accept this recommendation before generating content drafts.</p>
          <% } %>
        </article>
      <% }) %>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
