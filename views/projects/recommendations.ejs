<%- include('../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/ai-report/latest">AI CMO Plan</a>
    <a href="/projects/<%= project._id %>/scans">Scan History</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Recommendations</h1>
      </div>
      <form action="/projects/<%= project._id %>/ai-report" method="post">
        <button class="button button-primary" type="submit">Generate AI CMO Plan</button>
      </form>
    </div>

    <% if (!recommendations.length) { %>
      <section class="panel">
        <p class="empty">No recommendations yet. Generate an AI CMO plan after a completed scan.</p>
      </section>
    <% } %>

    <section class="panel">
      <h2>Review policy</h2>
      <p class="empty">Recommendations stay in the status you choose. Moyi does not auto-accept, auto-reject, or silently move work forward in the background.</p>
    </section>

    <section class="recommendation-grid">
      <% recommendations.forEach((recommendation) => { %>
        <article class="recommendation-card">
          <div class="panel-title">
            <span class="status">Priority <%= recommendation.priority %></span>
            <span class="status"><%= recommendation.status.replace('_', ' ') %></span>
          </div>
          <h2><%= recommendation.title %></h2>
          <p><strong>Impact:</strong> <%= recommendation.expectedImpact || 'Not specified' %></p>
          <p><strong>Effort:</strong> <%= recommendation.effort %></p>
          <p><strong>Action:</strong> <%= recommendation.actionType.replace('_', ' ') %></p>
          <p><strong>Reason:</strong> <%= recommendation.reason %></p>
          <% if (recommendation.assetOptions && recommendation.assetOptions.length) { %>
            <div>
              <strong>Execution pipeline</strong>
              <ul class="clean-list">
                <% recommendation.assetOptions.forEach((option) => { %>
                  <li><strong><%= option.label %>:</strong> <%= option.description %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <div>
            <strong>Affected pages</strong>
            <ul class="clean-list">
              <% recommendation.targetUrls.forEach((url) => { %>
                <li><a href="<%= url %>" target="_blank" rel="noreferrer"><%= url %></a></li>
              <% }) %>
            </ul>
          </div>
          <div class="status-actions">
            <% ['accepted', 'rejected', 'in_progress', 'done'].forEach((status) => { %>
              <form action="/recommendations/<%= recommendation._id %>/status" method="post">
                <input type="hidden" name="status" value="<%= status %>">
                <button class="button" type="submit"><%= status.replace('_', ' ') %></button>
              </form>
            <% }) %>
          </div>
          <% if (['accepted', 'in_progress', 'done'].includes(recommendation.status)) { %>
            <div class="content-generate-panel">
              <strong>Build execution assets</strong>
              <form class="form compact-form" action="/recommendations/<%= recommendation._id %>/generate-content" method="post">
                <input name="keyword" placeholder="Optional keyword">
                <button class="button button-primary" type="submit">Generate full pipeline</button>
              </form>
              <div class="status-actions">
                <% (recommendation.assetOptions || []).forEach((option) => { %>
                  <form action="/recommendations/<%= recommendation._id %>/generate-content" method="post">
                    <input type="hidden" name="type" value="<%= option.type %>">
                    <button class="button" type="submit"><%= option.label %></button>
                  </form>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <p class="empty">Accept this recommendation before generating content drafts.</p>
          <% } %>
        </article>
      <% }) %>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
