<%- include('../../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/reports">Reports</a>
    <a href="/projects/<%= project._id %>/search-console/performance">Search Performance</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>AI CMO Reports</h1>
      </div>
      <div class="row-actions">
        <form action="/projects/<%= project._id %>/reports/weekly" method="post">
          <button class="button button-primary" type="submit">Generate Weekly Report</button>
        </form>
        <form action="/projects/<%= project._id %>/reports/monthly" method="post">
          <button class="button" type="submit">Generate Monthly Report</button>
        </form>
      </div>
    </div>

    <section class="panel">
      <div class="panel-title">
        <h2>Report History</h2>
        <span class="status"><%= reports.length %> reports</span>
      </div>
      <% if (!reports.length) { %>
        <p class="empty">No weekly or monthly reports have been generated yet.</p>
      <% } %>
      <div class="content-card-grid">
        <% reports.forEach((report) => { %>
          <a class="content-card" href="/projects/<%= project._id %>/reports/<%= report._id %>">
            <span class="status"><%= report.type %></span>
            <strong><%= report.periodStart %> to <%= report.periodEnd %></strong>
            <small>Generated by <%= report.generatedBy %> on <%= report.createdAt.toLocaleString() %></small>
            <p><%= report.summary ? report.summary.slice(0, 180) : 'No summary available.' %><%= report.summary && report.summary.length > 180 ? '...' : '' %></p>
          </a>
        <% }) %>
      </div>
    </section>
  </section>
</div>

<%- include('../../partials/footer') %>
