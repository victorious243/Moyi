<%- include('../../partials/header') %>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/reports">Reports</a>
    <a href="/projects/<%= project._id %>/search-console/performance">Search Performance</a>
  </aside>

  <section
    class="app-main"
    <% if (reportJob && (reportJob.status === 'queued' || reportJob.status === 'running')) { %>
      data-live-job
      data-live-job-endpoint="/projects/<%= project._id %>/jobs/<%= reportJob._id %>"
      data-initial-job-status="<%= reportJob.status %>"
    <% } %>
  >
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= project.name %></p>
        <h1>Measurement Reports</h1>
      </div>
      <div class="row-actions">
        <form action="/projects/<%= project._id %>/reports/weekly" method="post">
          <button class="button button-primary" type="submit">Generate Weekly Report</button>
        </form>
        <form action="/projects/<%= project._id %>/reports/monthly" method="post">
          <button class="button" type="submit">Generate Monthly Report</button>
        </form>
      </div>
    </div>

    <% if (queuedMessage && reportJob && (reportJob.status === 'queued' || reportJob.status === 'running')) { %>
      <section class="panel">
        <h2>Report generation in progress</h2>
        <p class="empty"><%= queuedMessage %></p>
        <p class="empty">Status: <strong data-job-status><%= reportJob.status %></strong><% if (reportJob.startedAt) { %> / started <%= new Date(reportJob.startedAt).toLocaleString() %><% } %></p>
        <p class="empty"><span data-job-step><%= reportJob.currentStep || 'Preparing the report' %></span></p>
        <p class="empty">Progress: <span data-job-progress><%= typeof reportJob.progressPercent === 'number' ? `${reportJob.progressPercent}%` : '0%' %></span> / Last checked at <span data-job-last-checked>just now</span>.</p>
        <p class="empty" data-job-error-row hidden>Error: <span data-job-error></span></p>
      </section>
    <% } %>

    <% if (reportJob && reportJob.status === 'failed') { %>
      <section class="panel notice-panel">
        <h2>Latest report job failed</h2>
        <p class="empty"><%= reportJob.errorMessage || 'The background report job failed before a report could be created.' %></p>
        <form action="/projects/<%= project._id %>/jobs/<%= reportJob._id %>/retry" method="post">
          <button class="button button-primary" type="submit">Retry Job</button>
        </form>
      </section>
    <% } %>

    <section class="panel">
      <div class="panel-title">
        <h2>Report History</h2>
        <span class="status"><%= reports.length %> reports</span>
      </div>
      <% if (!reports.length) { %>
        <p class="empty">No weekly or monthly reports have been generated yet.</p>
      <% } %>
      <div class="content-card-grid">
        <% reports.forEach((report) => { %>
          <a class="content-card" href="/projects/<%= project._id %>/reports/<%= report._id %>">
            <span class="status"><%= report.type %></span>
            <strong><%= report.periodStart %> to <%= report.periodEnd %></strong>
            <small>Generated by <%= report.generatedBy %> on <%= report.createdAt.toLocaleString() %></small>
            <p><%= report.summary ? report.summary.slice(0, 180) : 'No summary available.' %><%= report.summary && report.summary.length > 180 ? '...' : '' %></p>
          </a>
        <% }) %>
      </div>
    </section>
  </section>
</div>

<%- include('../../partials/footer') %>
