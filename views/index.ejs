<%- include('partials/header') %>

<%
  const scanResult = typeof quickScanResult !== 'undefined' ? quickScanResult : null;
  const scanError = typeof quickScanError !== 'undefined' ? quickScanError : '';
  const scanUrl = typeof quickScanUrl !== 'undefined' ? quickScanUrl : '';
%>

<section class="hero landing-hero reveal" id="quick-scan">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="pill">Moyi-CMO AI platform for search-led growth</p>
    <h1>Moyi-CMO turns website and Search Console evidence into marketing action</h1>
    <p class="lead">Moyi-CMO helps business owners and marketing teams audit their websites, connect Google Search Console with read-only access, understand search performance, and turn real findings into SEO recommendations, content drafts, campaign plans, and weekly reports.</p>
    <div class="actions">
      <a class="button" href="#product-preview">View Demo</a>
      <a class="button button-primary" href="/register">Create Free Account</a>
    </div>
  </div>

  <div class="hero-console product-glass" data-terminal-console>
    <div class="window-bar">
      <span></span><span></span><span></span>
      <strong>moyi-cmo.run</strong>
    </div>
    <div class="console-layout">
      <div class="console-main">
        <div class="terminal-status-row">
          <p class="eyebrow"><%= scanResult ? 'Quick scan complete' : 'Live quick scan' %></p>
          <span class="terminal-live-dot"><%= scanResult ? 'report ready' : 'agent online' %></span>
        </div>
        <form class="terminal-scan-form" action="/quick-scan" method="post" data-terminal-scan data-loading-state="Running your public Moyi scan">
          <span class="terminal-prompt">$ moyi scan</span>
          <input name="websiteUrl" value="<%= scanUrl %>" placeholder="example.com" autocomplete="url" required>
          <button type="submit" aria-label="Run quick scan">Enter</button>
        </form>
        <div class="terminal-pipeline" aria-hidden="true">
          <span>crawl</span>
          <span>audit</span>
          <span>score</span>
          <span>plan</span>
        </div>
        <% if (scanError) { %>
          <p class="quick-scan-error"><%= scanError %></p>
        <% } %>
        <h2><%= scanResult ? `${scanResult.snapshot.host} quick report generated` : 'Enter your website to wake up Moyi' %></h2>
        <p><%= scanResult ? `${scanResult.pagesScanned} pages sampled. ${scanResult.summary.issueCount} visible signals found. Full recommendations unlock after signup.` : 'Type your website URL into the terminal, press Enter, and get a limited public scan before creating an account.' %></p>
        <div class="score-ring <%= scanResult ? '' : 'score-ring-idle' %>">
          <strong><%= scanResult ? scanResult.score : '--' %></strong>
          <span><%= scanResult ? 'Quick score' : 'Awaiting scan' %></span>
        </div>
      </div>
      <div class="console-side">
        <span><i></i>Critical issues <strong><%= scanResult ? scanResult.summary.criticalCount : '--' %></strong><small><%= scanResult ? 'from sampled pages' : 'waiting for URL' %></small></span>
        <span><i></i>Warnings <strong><%= scanResult ? scanResult.summary.warningCount : '--' %></strong><small><%= scanResult ? 'from crawl evidence' : 'waiting for URL' %></small></span>
        <span><i></i>Opportunities <strong><%= scanResult ? scanResult.summary.opportunityCount : '--' %></strong><small><%= scanResult ? 'visible preview only' : 'waiting for URL' %></small></span>
      </div>
    </div>
    <div class="terminal-signal-grid" aria-hidden="true"></div>
  </div>
</section>

<section class="section-intro reveal app-purpose-section" aria-label="Moyi-CMO application purpose">
  <p class="eyebrow">Application purpose</p>
  <h2>Moyi-CMO is an evidence-led AI Chief Marketing Officer workspace.</h2>
  <p>Moyi-CMO is built for businesses that need clearer marketing decisions from real website and search data. The platform crawls public website pages, highlights technical and content issues, and can connect to Google Search Console using read-only permission so users can review clicks, impressions, CTR, average ranking position, pages, countries, devices, and search queries in their own dashboard.</p>
  <p>Moyi-CMO uses that evidence to create prioritized SEO recommendations, content briefs, article drafts, social posts, campaign plans, and recurring reports for human review. It does not modify Google Search Console data, does not request write access to Search Console, and does not publish content automatically. Users stay in control of approvals, exports, publishing, and account access.</p>
</section>

<% if (scanResult) { %>
  <section class="public-scan-result reveal" id="quick-scan-result">
    <div class="section-intro">
      <p class="eyebrow">Free quick scan</p>
      <h2>We found the shape of <%= scanResult.snapshot.host %>.</h2>
      <p>This public preview shows a limited crawl sample. Create a free account to unlock the full prioritized plan and draft recommendations.</p>
    </div>

    <div class="public-scan-grid">
      <div class="website-snapshot product-glass">
        <div class="browser-bar">
          <span></span><span></span><span></span>
          <strong><%= scanResult.snapshot.host %></strong>
        </div>
        <div class="snapshot-canvas">
          <p class="eyebrow">Captured page snapshot</p>
          <h3><%= scanResult.snapshot.h1 || scanResult.snapshot.title %></h3>
          <p><%= scanResult.snapshot.description %></p>
          <div class="snapshot-lines">
            <% scanResult.snapshot.headings.forEach((heading) => { %>
              <span><%= heading %></span>
            <% }) %>
            <% if (!scanResult.snapshot.headings.length) { %>
              <span>No visible H2 headings found in this sample.</span>
            <% } %>
          </div>
        </div>
      </div>

      <div class="signal-report">
        <header class="signal-report-head">
          <div class="signal-score-dial">
            <strong><%= scanResult.score %></strong>
          </div>
          <div>
            <p class="eyebrow">Moyi signal index</p>
            <h3><%= scanResult.score >= 80 ? 'Strong foundation' : scanResult.score >= 60 ? 'Growth is within reach' : 'Priority work detected' %></h3>
            <p>Measured from the public crawl sample.</p>
          </div>
        </header>

        <div class="signal-report-list">
          <article class="signal-report-row">
            <strong><%= scanResult.pagesScanned %></strong>
            <div><span>Pages inspected</span><small><%= scanResult.pagesFound %> public pages discovered</small></div>
            <i class="signal-state signal-state-info">Crawl</i>
          </article>
          <article class="signal-report-row">
            <strong><%= scanResult.summary.criticalCount %></strong>
            <div><span>Critical issues</span><small>Blocking signals in this sample</small></div>
            <i class="signal-state <%= scanResult.summary.criticalCount ? 'signal-state-alert' : 'signal-state-clear' %>"><%= scanResult.summary.criticalCount ? 'Review' : 'Clear' %></i>
          </article>
          <article class="signal-report-row">
            <strong><%= scanResult.summary.warningCount %></strong>
            <div><span>Warnings</span><small>Metadata and page structure</small></div>
            <i class="signal-state <%= scanResult.summary.warningCount ? 'signal-state-warn' : 'signal-state-clear' %>"><%= scanResult.summary.warningCount ? 'Improve' : 'Clear' %></i>
          </article>
          <article class="signal-report-row">
            <strong><%= scanResult.summary.opportunityCount %></strong>
            <div><span>Growth signals</span><small>Visible opportunities to pursue</small></div>
            <i class="signal-state signal-state-growth">Open</i>
          </article>
        </div>

        <footer class="signal-report-foot">
          <span><i></i> Live website evidence</span>
          <a href="/register">Unlock the full plan <b aria-hidden="true">&rarr;</b></a>
        </footer>
      </div>
    </div>

    <div class="public-scan-grid">
      <section class="panel">
        <div class="panel-title">
          <h2>Visible Findings</h2>
          <span class="status"><%= scanResult.visibleIssues.length %> shown</span>
        </div>
        <% if (!scanResult.visibleIssues.length) { %>
          <p class="empty">No major issues were visible in the public sample. The full workspace checks deeper pages and turns findings into actions.</p>
        <% } %>
        <% scanResult.visibleIssues.forEach((issue) => { %>
          <article class="quick-finding">
            <span class="status"><%= issue.severity %></span>
            <strong><%= issue.title %></strong>
            <p><%= issue.recommendation %></p>
          </article>
        <% }) %>
      </section>

      <section class="panel gated-panel">
        <div class="panel-title">
          <h2>Locked Growth Plan</h2>
          <span class="status"><%= scanResult.hiddenOpportunityCount %> more signals</span>
        </div>
        <% scanResult.gatedInsights.forEach((item) => { %>
          <div class="locked-row"><span><%= item %></span><strong>Unlock</strong></div>
        <% }) %>
        <a class="button button-primary" href="/register">Unlock Full Free Audit</a>
      </section>
    </div>
  </section>
<% } %>

<section class="value-strip reveal" aria-label="Core product value">
  <span>Website SEO audits</span>
  <span>AI growth plans</span>
  <span>Content recommendations</span>
  <span>Search Console insights</span>
  <span>Weekly CMO reports</span>
  <span>Human approval workflow</span>
</section>

<section class="section-intro reveal" id="product-preview">
  <p class="eyebrow">Product preview</p>
  <h2>A marketing command center for what to fix next.</h2>
  <p>Moyi-CMO gives every project one place to collect evidence, review priorities, create content assets, plan campaigns, and measure progress. Sample data below shows the workflow the product is built around.</p>
</section>

<section class="dashboard-preview product-glass reveal" aria-label="Dashboard preview">
  <div class="dashboard-header">
    <div>
      <p class="eyebrow">Live workspace</p>
      <h2>Acme Studio SEO Overview</h2>
    </div>
    <span class="status">scan complete</span>
  </div>

  <div class="preview-metrics">
    <article><span>Sample signal score</span><strong>84</strong><small>Illustrative dashboard state</small></article>
    <article><span>Critical issues</span><strong>3</strong><small>Title and indexability fixes</small></article>
    <article><span>AI recommendations</span><strong>18</strong><small>6 waiting for review</small></article>
    <article><span>Sample impressions</span><strong>48.2k</strong><small>Illustrative 30-day window</small></article>
    <article><span>Content opportunities</span><strong>27</strong><small>Rule-based and AI-reviewed candidates</small></article>
  </div>

  <div class="preview-grid">
    <div class="preview-panel">
      <h3>Top opportunities</h3>
      <div class="bar-row bar-row-strong"><span>Homepage title clarity</span><i></i></div>
      <div class="bar-row bar-row-medium"><span>Pricing page schema</span><i></i></div>
      <div class="bar-row bar-row-balanced"><span>Comparison content gap</span><i></i></div>
    </div>
    <div class="preview-panel">
      <h3>Approval queue</h3>
      <ul class="clean-list">
        <li>Rewrite 5 duplicate meta descriptions</li>
        <li>Draft 30-day content roadmap</li>
        <li>Add H1 improvements to service pages</li>
      </ul>
    </div>
  </div>
</section>

<section class="section-intro reveal" id="features">
  <p class="eyebrow">Features</p>
  <h2>Everything your website needs to keep improving.</h2>
  <p>Built for startups, small businesses, creators, and teams that need direction without a full-time marketing department.</p>
</section>

<section class="feature-grid capability-grid reveal">
  <article>
    <span class="feature-icon">SCN</span>
    <h2>Website SEO Scanner</h2>
    <p>Crawl public pages, inspect titles, descriptions, headings, internal links, schema, images, and crawl health, then separate observable issues from AI interpretation.</p>
  </article>
  <article>
    <span class="feature-icon">CMO</span>
    <h2>AI CMO Strategy</h2>
    <p>Convert audit evidence into weekly priorities, executive summaries, business risks, growth opportunities, and a clear plan the team can review before acting.</p>
  </article>
  <article>
    <span class="feature-icon">DRF</span>
    <h2>Content Draft Generator</h2>
    <p>Generate human-reviewed articles, comparison pages, alternatives lists, product-led guides, social posts, titles, descriptions, and briefs from approved recommendations.</p>
  </article>
  <article>
    <span class="feature-icon">GSC</span>
    <h2>Search Console Tracking</h2>
    <p>Use read-only Search Console data to track impressions, clicks, CTR, position, page performance, query movement, and opportunities such as low-CTR page-one rankings.</p>
  </article>
  <article>
    <span class="feature-icon">CMP</span>
    <h2>Competitor Insights</h2>
    <p>Review public competitor pages, content gaps, SERP patterns, positioning signals, and market angles so strategy is based on visible evidence, not guesswork.</p>
  </article>
  <article>
    <span class="feature-icon">RPT</span>
    <h2>Weekly Growth Reports</h2>
    <p>Get concise CMO-style reports explaining what changed, what remains uncertain, which data sources are connected, and what should be reviewed next.</p>
  </article>
</section>

<section class="workflow-section reveal" id="how-it-works">
  <div class="section-intro">
    <p class="eyebrow">How it works</p>
    <h2>Scan, diagnose, plan, generate, approve, track, improve.</h2>
  </div>
  <div class="workflow-grid">
    <article><span>01</span><h3>Scan your website</h3><p>Run a crawl, collect page evidence, and capture what the website currently says to search engines and visitors.</p></article>
    <article><span>02</span><h3>Connect Search Console</h3><p>Optional read-only Google Search Console access adds real query, page, click, impression, CTR, and position data.</p></article>
    <article><span>03</span><h3>Diagnose SEO problems</h3><p>Identify technical, content, search visibility, and measurement gaps with clear evidence attached to each finding.</p></article>
    <article><span>04</span><h3>Generate a 30-day plan</h3><p>Turn supported findings into prioritized actions, content opportunities, campaign ideas, and reporting tasks.</p></article>
    <article><span>05</span><h3>Approve the work</h3><p>Review recommendations, drafts, visuals, and campaign posts before anything is exported, published, or marked complete.</p></article>
    <article><span>06</span><h3>Improve every week</h3><p>Track movement over time, refresh scans, update recommendations, and keep marketing decisions tied to evidence.</p></article>
  </div>
</section>

<section class="split-section technical-section reveal">
  <div>
    <p class="eyebrow">AI output</p>
    <h2>Recommendations grounded in website evidence.</h2>
    <p class="lead-small">Moyi keeps a clean boundary between what the crawler saw and what the AI recommends, so every plan can be reviewed against visible evidence.</p>
  </div>
  <div class="code-window">
    <div class="window-bar">
      <span></span><span></span><span></span>
      <strong>ai-cmo-output.json</strong>
    </div>
    <pre><code>{
  "issue": "homepage_title_generic",
  "evidence": "Title is 12 characters and lacks audience",
  "recommendation": "Your homepage title is too generic.",
  "suggested_fix": "Include product, audience, and location.",
  "approval_status": "pending"
}</code></pre>
  </div>
</section>

<section class="section-intro reveal">
  <p class="eyebrow">Use cases</p>
  <h2>Built for teams that need clearer marketing decisions.</h2>
  <p>Moyi-CMO is useful when a business needs a repeatable operating system for organic growth: find what is broken, decide what matters, create the assets, approve the work, and measure the next result.</p>
</section>

<section class="use-case-grid reveal">
  <article><h3>Startups</h3><p>Find traction channels, fix foundation pages, and turn positioning into search demand.</p></article>
  <article><h3>Local businesses</h3><p>Improve service pages, location relevance, and weekly organic visibility.</p></article>
  <article><h3>SaaS products</h3><p>Prioritize comparison pages, feature content, and high-intent search opportunities.</p></article>
  <article><h3>Agencies</h3><p>Create repeatable audit, approval, and reporting workflows across client portfolios.</p></article>
  <article><h3>Creators</h3><p>Turn content libraries into clearer clusters, better titles, and measurable search growth.</p></article>
</section>

<section class="section-intro reveal" id="pricing">
  <p class="eyebrow">Pricing preview</p>
  <h2>Start with a scan. Scale into a marketing operating system.</h2>
  <p>Pay yearly and get two months free on every paid plan.</p>
</section>

<section class="pricing-grid reveal">
  <article>
    <h3>Free</h3>
    <strong>&euro;<%= publicPlans.free.monthlyPrice %></strong>
    <p><%= publicPlans.free.description %></p>
    <a class="button" href="/register">Run audit</a>
  </article>
  <article>
    <h3>Starter</h3>
    <strong>&euro;<%= publicPlans.starter.monthlyPrice %><small>/month</small></strong>
    <p><%= publicPlans.starter.description %></p>
    <a class="button button-primary" href="/register">Get Started</a>
  </article>
  <article>
    <h3>Pro</h3>
    <strong>&euro;<%= publicPlans.pro.monthlyPrice %><small>/month</small></strong>
    <p><%= publicPlans.pro.description %></p>
    <a class="button" href="/register">Choose Pro</a>
  </article>
  <article>
    <h3>Agency</h3>
    <strong>&euro;<%= publicPlans.agency.monthlyPrice %><small>/month</small></strong>
    <p><%= publicPlans.agency.description %></p>
    <a class="button" href="/register">Choose Agency</a>
  </article>
</section>

<section class="final-cta reveal" id="contact">
  <div class="hero-glow" aria-hidden="true"></div>
  <p class="eyebrow">Ready when you are</p>
  <h2>Give your website an AI marketing brain.</h2>
  <div class="actions">
    <a class="button button-primary" href="/register">Run First SEO Scan</a>
    <a class="button" href="#features">See Features</a>
  </div>
</section>

<%- include('partials/footer') %>
