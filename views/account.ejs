<%- include('partials/header') %>

<%
  const availableApiCredentials = typeof apiCredentials !== 'undefined' ? apiCredentials : [];
  const availableApiProjects = typeof apiProjects !== 'undefined' ? apiProjects : [];
  const availableApiScopes = typeof apiScopes !== 'undefined' ? apiScopes : [];
  const newApiKey = typeof oneTimeApiKey !== 'undefined' ? oneTimeApiKey : '';
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <a href="/organizations">Agency Workspaces</a>
    <a href="/billing">Billing</a>
    <a href="/account">Account</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Settings</p>
        <h1>Account</h1>
      </div>
    </div>

    <% if (accountMessage) { %>
      <section class="panel notice-panel">
        <h2>Account update</h2>
        <p class="empty"><%= accountMessage %></p>
      </section>
    <% } %>
    <% if (accountError) { %>
      <section class="panel notice-panel">
        <h2>Account issue</h2>
        <p class="empty"><%= accountError %></p>
      </section>
    <% } %>

    <section class="panel">
      <h2>Profile</h2>
      <dl class="detail-list">
        <div><dt>Name</dt><dd><%= currentUser.name %></dd></div>
        <div><dt>Email</dt><dd><%= currentUser.email %></dd></div>
        <div><dt>Plan</dt><dd><%= plan.name %></dd></div>
        <div><dt>Subscription</dt><dd><%= currentUser.subscriptionStatus || 'inactive' %></dd></div>
      </dl>
    </section>

    <section class="panel">
      <h2>Data Export</h2>
      <p class="empty">Download account, project, recommendation, content, analytics, publishing, and audit data as JSON. Saved integration credentials are redacted.</p>
      <a class="button" href="/account/export">Download Account Export</a>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div><h2>Public API Keys</h2><p>Create a project-scoped key for approved publishing jobs, account status, and social analytics.</p></div>
        <a class="button" href="/docs#content-distribution-api">API documentation</a>
      </div>
      <% if (newApiKey) { %>
        <div class="image-success-message">
          <strong>New API key</strong>
          <input id="one-time-api-key" value="<%= newApiKey %>" readonly autocomplete="off" spellcheck="false">
          <button class="button button-small" type="button" data-copy-api-key>Copy</button>
        </div>
      <% } %>
      <form class="form" action="/account/api-keys" method="post">
        <label>Name <input name="name" maxlength="120" placeholder="Production automation" required></label>
        <fieldset>
          <legend>Scopes</legend>
          <% availableApiScopes.forEach((scope) => { %><label><input type="checkbox" name="scopes" value="<%= scope %>"> <%= scope %></label><% }) %>
        </fieldset>
        <fieldset>
          <legend>Projects</legend>
          <% availableApiProjects.forEach((project) => { %><label><input type="checkbox" name="projectIds" value="<%= project._id %>"> <%= project.name %></label><% }) %>
        </fieldset>
        <button class="button button-primary" type="submit">Create API Key</button>
      </form>
      <% if (availableApiCredentials.length) { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Prefix</th><th>Scopes</th><th>Projects</th><th>Last used</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% availableApiCredentials.forEach((credential) => { %>
                <tr>
                  <td><strong><%= credential.name %></strong></td>
                  <td><code>moyi_live_<%= credential.prefix %>_...</code></td>
                  <td><%= (credential.scopes || []).join(', ') %></td>
                  <td><%= (credential.projectIds || []).map((project) => project.name || project).join(', ') %></td>
                  <td><%= credential.lastUsedAt ? new Date(credential.lastUsedAt).toLocaleString() : 'Never' %></td>
                  <td><span class="status <%= credential.status === 'active' ? 'status-success' : '' %>"><%= credential.status %></span></td>
                  <td>
                    <% if (credential.status === 'active') { %>
                      <form action="/account/api-keys/<%= credential._id %>/revoke" method="post" onsubmit="return confirm('Revoke this API key?');">
                        <button class="button button-small" type="submit">Revoke</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel notice-panel">
      <h2>Delete Account & Data</h2>
      <p class="empty">This permanently deletes your user account, projects, scans, reports, recommendations, drafts, tracking events, integrations, campaigns, and social drafts. Audit records are retained for security and compliance evidence.</p>
      <form class="form" action="/account/delete" method="post" onsubmit="return confirm('Permanently delete this account and all owned Moyi data? This cannot be undone.');">
        <label>Confirm email <input type="email" name="confirmEmail" autocomplete="email" required></label>
        <label>Type DELETE <input name="confirmText" pattern="DELETE" required></label>
        <button class="button danger-button" type="submit">Delete Account Permanently</button>
      </form>
    </section>

    <section class="panel">
      <h2>Recent Security Events</h2>
      <% if (auditLogs.length) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Event</th>
                <th>Status</th>
                <th>When</th>
              </tr>
            </thead>
            <tbody>
              <% auditLogs.forEach((log) => { %>
                <tr>
                  <td><%= log.eventType.replace(/_/g, ' ') %></td>
                  <td><%= log.status %></td>
                  <td><%= log.createdAt ? new Date(log.createdAt).toLocaleString() : '' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="empty">No security events recorded yet.</p>
      <% } %>
    </section>
  </section>
</div>

<script>
  document.querySelector('[data-copy-api-key]')?.addEventListener('click', async (event) => {
    const input = document.getElementById('one-time-api-key');
    if (!input) return;
    await navigator.clipboard.writeText(input.value);
    event.currentTarget.textContent = 'Copied';
  });
</script>

<%- include('partials/footer') %>
