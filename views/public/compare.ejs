<%- include('../partials/header') %>

<main class="programmatic-page">
  <!-- Hero Section -->
  <section class="programmatic-hero">
    <div class="programmatic-hero-inner">
      <span class="status status-connected" style="margin-bottom: 16px;"><%= page.heroBadge %></span>
      <h1><%= page.heroHeadline %></h1>
      <p class="programmatic-subheadline"><%= page.heroSubheadline %></p>
      <div class="programmatic-hero-actions">
        <a class="button button-primary" href="/signup"><%= page.ctaText %></a>
        <a class="button" href="/pricing">View Pricing Plans</a>
      </div>
    </div>
  </section>

  <!-- Core Summary Panel -->
  <section class="panel programmatic-panel">
    <div class="panel-title">
      <div>
        <h2>Executive Summary</h2>
        <p><%= page.coreSummary %></p>
      </div>
    </div>
  </section>

  <!-- Key Differentiators Grid -->
  <section class="programmatic-section">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Key Advantages</p>
        <h2>Why High-Growth Teams Choose Moyi Over <%= page.competitorName %></h2>
      </div>
    </div>
    <div class="feature-grid">
      <% page.keyDifferentiators.forEach((diff) => { %>
        <article class="panel">
          <h3><%= diff.title %></h3>
          <p><%= diff.description %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <!-- Head-to-Head Comparison Table -->
  <section class="panel programmatic-panel table-panel">
    <div class="panel-title">
      <div>
        <h2>Feature-by-Feature Matrix</h2>
        <p>Direct comparison of core capabilities between Moyi and <%= page.competitorName %>.</p>
      </div>
    </div>
    <div style="overflow-x: auto;">
      <table class="programmatic-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.12);">
            <th style="padding: 14px 16px; color: var(--muted); font-size: 13px; text-transform: uppercase;">Feature / Capability</th>
            <th style="padding: 14px 16px; color: #818cf8; font-weight: 700;">Moyi AI CMO</th>
            <th style="padding: 14px 16px; color: var(--muted); font-size: 13px;"><%= page.competitorName %></th>
          </tr>
        </thead>
        <tbody>
          <% page.comparisonTable.forEach((row) => { %>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
              <td style="padding: 14px 16px; font-weight: 600;"><%= row.feature %></td>
              <td style="padding: 14px 16px; color: #34d399; font-weight: 700;"><%= row.moyi %></td>
              <td style="padding: 14px 16px; color: var(--muted);"><%= row.competitor %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="panel programmatic-panel">
    <div class="panel-title">
      <div>
        <h2>Frequently Asked Questions</h2>
        <p>Everything you need to know about switching or pairing Moyi with <%= page.competitorName %>.</p>
      </div>
    </div>
    <div class="faq-accordion" style="display: grid; gap: 16px; margin-top: 20px;">
      <% page.faqList.forEach((faq) => { %>
        <div style="padding: 16px 20px; border-radius: 10px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
          <strong style="display: block; font-size: 15px; color: #ffffff; margin-bottom: 8px;"><%= faq.question %></strong>
          <p style="margin: 0; font-size: 14px; color: var(--muted); line-height: 1.6;"><%= faq.answer %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Conversion CTA Banner -->
  <section class="programmatic-cta panel" style="text-align: center; padding: 48px 24px; background: linear-gradient(140deg, rgba(79, 70, 229, 0.15), rgba(17, 19, 24, 0.95)); border: 1px solid rgba(99, 102, 241, 0.35);">
    <h2 style="font-size: 28px; font-weight: 800; margin-bottom: 12px;"><%= page.ctaHeadline %></h2>
    <p style="font-size: 16px; color: var(--muted); max-width: 600px; margin: 0 auto 24px;"><%= page.ctaSubheadline %></p>
    <a class="button button-primary" style="padding: 14px 32px; font-size: 16px;" href="/signup"><%= page.ctaText %></a>
  </section>
</main>

<!-- JSON-LD Structured Data Schema for Google Rich Snippets -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "<%= page.title %>",
  "description": "<%= page.metaDescription %>",
  "brand": {
    "@type": "Brand",
    "name": "Moyi AI CMO"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "EUR",
    "price": "49.00",
    "availability": "https://schema.org/InStock"
  }
}
</script>

<%- include('../partials/footer') %>
