<%- include('../partials/header') %>

<section class="public-info-hero">
  <p class="eyebrow"><%= page.eyebrow %></p>
  <h1><%= page.title %></h1>
  <p><%= page.intro %></p>
  <div class="actions">
    <a class="button button-primary" href="<%= page.primaryAction.href %>"><%= page.primaryAction.label %></a>
    <a class="button" href="<%= page.secondaryAction.href %>"><%= page.secondaryAction.label %></a>
  </div>
</section>

<div class="public-info-layout">
  <nav class="public-info-index" aria-label="On this page">
    <strong>On this page</strong>
    <% page.sections.forEach((section) => { %><a href="#<%= section.id %>"><%= section.title %></a><% }) %>
  </nav>
  <div class="public-info-content">
    <% page.sections.forEach((section) => { %>
      <section id="<%= section.id %>">
        <h2><%= section.title %></h2>
        <p><%= section.body %></p>
        <% if (section.bullets && section.bullets.length) { %>
          <ul><% section.bullets.forEach((item) => { %><li><%= item %></li><% }) %></ul>
        <% } %>
        <% if (section.steps && section.steps.length) { %>
          <ol class="docs-step-list">
            <% section.steps.forEach((step) => { %>
              <li>
                <strong><%= step.title %></strong>
                <span><%= step.body %></span>
              </li>
            <% }) %>
          </ol>
        <% } %>
        <% if (section.options && section.options.length) { %>
          <div class="docs-option-grid">
            <% section.options.forEach((option) => { %>
              <article>
                <strong><%= option.title %></strong>
                <p><%= option.body %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
        <% if (section.tutorials && section.tutorials.length) { %>
          <div class="docs-option-grid docs-tutorial-grid">
            <% section.tutorials.forEach((tutorial) => { %>
              <article>
                <strong><%= tutorial.title %></strong>
                <p><%= tutorial.summary %></p>
                <a class="button button-small" href="<%= tutorial.href %>">Open setup</a>
                <ol class="docs-step-list">
                  <% tutorial.steps.forEach((step) => { %>
                    <li>
                      <span><%= step %></span>
                    </li>
                  <% }) %>
                </ol>
              </article>
            <% }) %>
          </div>
        <% } %>
        <% if (section.note) { %>
          <aside class="docs-note"><%= section.note %></aside>
        <% } %>
      </section>
    <% }) %>
    <% if (page.faqs && page.faqs.length) { %>
      <section id="faq">
        <h2>Frequently asked questions</h2>
        <div class="docs-option-grid">
          <% page.faqs.forEach((faq) => { %>
            <article>
              <strong><%= faq.question %></strong>
              <p><%= faq.answer %></p>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
    <% if (page.related && page.related.length) { %>
      <section id="related">
        <h2>Related Moyi pages</h2>
        <div class="docs-option-grid">
          <% page.related.forEach((item) => { %>
            <article>
              <strong><a href="<%= item.href %>"><%= item.label %></a></strong>
              <p><%= item.body %></p>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
