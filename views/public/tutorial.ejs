<%- include('../partials/header') %>

<main class="tutorial-page programmatic-page">
  <!-- Hero Section -->
  <section class="programmatic-hero" style="background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.15) 0%, rgba(11, 12, 16, 0.95) 75%); padding: 56px 20px 40px; text-align: left;">
    <div style="max-width: 860px; margin: 0 auto;">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #94a3b8; margin-bottom: 20px;">
        <a href="/docs" style="color: #818cf8; text-decoration: none;">Documentation</a>
        <span style="margin: 0 8px; opacity: 0.5;">/</span>
        <a href="/docs#setup-tutorials" style="color: #818cf8; text-decoration: none;">Tutorials</a>
        <span style="margin: 0 8px; opacity: 0.5;">/</span>
        <span style="color: #cbd5e1;"><%= tutorial.category %></span>
      </nav>

      <!-- Meta Badges -->
      <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px;">
        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); color: #818cf8; font-size: 12px; font-weight: 800; text-transform: uppercase;">
          <span style="width: 6px; height: 6px; border-radius: 999px; background: #6366f1;"></span>
          <%= tutorial.category %>
        </span>
        <span style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 700;">
          ⏱️ <%= tutorial.readTime %>
        </span>
        <span style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); color: #f59e0b; padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 700;">
          🎯 Level: <%= tutorial.difficulty %>
        </span>
      </div>

      <h1 style="font-size: clamp(28px, 4vw, 42px); font-weight: 900; line-height: 1.15; color: #ffffff; margin-bottom: 16px; letter-spacing: -0.02em;">
        <%= tutorial.heroHeadline %>
      </h1>
      <p style="font-size: 17px; color: #cbd5e1; line-height: 1.6; margin-bottom: 24px;">
        <%= tutorial.heroSubheadline %>
      </p>

      <!-- Prerequisites Card -->
      <% if (tutorial.prerequisites && tutorial.prerequisites.length) { %>
        <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 12px; padding: 18px 20px; margin-top: 24px;">
          <div style="color: #818cf8; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
            📋 Prerequisites Before You Begin
          </div>
          <ul style="margin: 0; padding-left: 20px; color: #94a3b8; font-size: 14px; line-height: 1.6;">
            <% tutorial.prerequisites.forEach(item => { %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Step-by-Step Walkthrough Section -->
  <section class="programmatic-section" style="max-width: 860px; margin: 40px auto; padding: 0 20px;">
    <div style="margin-bottom: 32px;">
      <h2 style="font-size: 24px; font-weight: 900; color: #ffffff; margin-bottom: 8px;">Step-by-Step Instructions</h2>
      <p style="color: #94a3b8; font-size: 15px; margin: 0;"><%= tutorial.summary %></p>
    </div>

    <div style="display: grid; gap: 24px;">
      <% tutorial.steps.forEach(step => { %>
        <article class="panel" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; padding: 24px; position: relative;">
          <div style="display: flex; align-items: flex-start; gap: 16px;">
            <!-- Step Number Badge -->
            <div style="width: 36px; height: 36px; border-radius: 999px; background: linear-gradient(135deg, #6366f1, #3b82f6); color: #ffffff; font-weight: 900; font-size: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);">
              <%= step.number %>
            </div>
            
            <div style="flex: 1;">
              <h3 style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 0 0 10px; line-height: 1.3;">
                <%= step.title %>
              </h3>
              
              <p style="color: #cbd5e1; font-size: 14.5px; line-height: 1.65; margin: 0 0 14px;">
                <%= step.instruction %>
              </p>

              <% if (step.proTip) { %>
                <div style="background: rgba(16, 185, 129, 0.08); border-left: 3px solid #10b981; padding: 10px 14px; border-radius: 4px; font-size: 13px; color: #a7f3d0; margin-bottom: 12px;">
                  <strong>💡 Pro Tip:</strong> <%= step.proTip %>
                </div>
              <% } %>

              <% if (step.actionLink && step.actionText) { %>
                <div>
                  <a href="<%= step.actionLink %>" class="button button-small" style="font-size: 12px; padding: 6px 14px;">
                    <%= step.actionText %> &rarr;
                  </a>
                </div>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <!-- Key Takeaways & Governance -->
  <section class="programmatic-section" style="max-width: 860px; margin: 48px auto; padding: 0 20px;">
    <div class="panel" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 14px; padding: 28px;">
      <h3 style="font-size: 19px; font-weight: 900; color: #ffffff; margin: 0 0 14px;">
        🎯 Key Takeaways
      </h3>
      <ul style="margin: 0; padding-left: 20px; color: #cbd5e1; font-size: 14.5px; line-height: 1.7;">
        <% tutorial.keyTakeaways.forEach(takeaway => { %>
          <li><%= takeaway %></li>
        <% }) %>
      </ul>
    </div>
  </section>

  <!-- FAQ Section -->
  <% if (tutorial.faqs && tutorial.faqs.length) { %>
    <section class="programmatic-section" style="max-width: 860px; margin: 48px auto; padding: 0 20px;">
      <h3 style="font-size: 20px; font-weight: 900; color: #ffffff; margin-bottom: 18px;">
        Frequently Asked Questions
      </h3>
      <div style="display: grid; gap: 14px;">
        <% tutorial.faqs.forEach(faq => { %>
          <div style="padding: 18px; border-radius: 10px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
            <strong style="display: block; font-size: 15px; color: #ffffff; margin-bottom: 6px;"><%= faq.question %></strong>
            <p style="margin: 0; font-size: 13.5px; color: #94a3b8; line-height: 1.6;"><%= faq.answer %></p>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Next Tutorial & Action Card -->
  <section class="programmatic-section" style="max-width: 860px; margin: 48px auto 80px; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
      <% if (tutorial.nextTutorial) { %>
        <div class="panel" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 22px;">
          <div style="color: #818cf8; font-size: 11px; font-weight: 800; text-transform: uppercase; margin-bottom: 6px;">Next Recommended Tutorial</div>
          <div style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 12px; line-height: 1.3;"><%= tutorial.nextTutorial.title %></div>
          <a href="/docs/tutorials/<%= tutorial.nextTutorial.slug %>" class="button button-small button-primary" style="font-size: 12px;">
            Continue Tutorial &rarr;
          </a>
        </div>
      <% } %>

      <div class="panel" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(16, 185, 129, 0.15)); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 12px; padding: 22px;">
        <div style="color: #10b981; font-size: 11px; font-weight: 800; text-transform: uppercase; margin-bottom: 6px;">Ready to Execute?</div>
        <div style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 12px; line-height: 1.3;">Apply this tutorial directly in your Moyi workspace.</div>
        <a href="/register" class="button button-small button-primary" style="font-size: 12px;">
          Start Free Trial &rarr;
        </a>
      </div>
    </div>
  </section>
</main>

<!-- JSON-LD HowTo & Article Structured Data Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "<%= tutorial.title %>",
  "description": "<%= tutorial.seoDescription %>",
  "totalTime": "PT<%= tutorial.readTime.replace(/[^0-9]/g, '') %>M",
  "step": [
    <% tutorial.steps.forEach((step, idx) => { %>
      {
        "@type": "HowToStep",
        "position": <%= step.number %>,
        "name": "<%= step.title %>",
        "text": "<%= step.instruction.replace(/"/g, '\\"') %>"
      }<%= idx < tutorial.steps.length - 1 ? ',' : '' %>
    <% }) %>
  ]
}
</script>

<%- include('../partials/footer') %>
