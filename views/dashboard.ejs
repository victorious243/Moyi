<%- include('partials/header') %>

<%
  const latestProject = projects[0];
  const hasProjects = projects.length > 0;
  const latestProjectBase = latestProject ? `/projects/${latestProject._id}` : '/projects/new';
  const hasScans = recentScans.length > 0;
  const hasReports = recentReports.length > 0;
  const scanPct = Math.min((usage.scansUsed / Math.max(plan.scansPerMonth, 1)) * 100, 100);
  const reportPct = Math.min((usage.aiReportsUsed / Math.max(plan.aiReportsPerMonth, 1)) * 100, 100);
  const contentPct = Math.min((usage.contentDraftsUsed / Math.max(plan.contentDraftsPerMonth, 1)) * 100, 100);
  const socialPct = Math.min(((usage.socialPostsUsed || 0) / Math.max(socialPostLimit, 1)) * 100, 100);
  const workspaceScore = hasReports ? 82 : (hasScans ? 58 : (hasProjects ? 36 : 12));
  const nextAction = !hasProjects
    ? {
        label: 'Create your first project',
        detail: 'Add a business profile so Moyi can start collecting SEO evidence.',
        href: '/projects/new',
        cta: 'Add Project'
      }
    : (!hasScans
      ? {
          label: 'Run the first website scan',
          detail: 'Start with crawl evidence before asking the AI CMO for strategy.',
          href: '/projects/' + latestProject._id,
          cta: 'Open Project'
        }
      : (!hasReports
        ? {
            label: 'Generate the AI CMO plan',
            detail: 'Turn scan evidence into priorities, content ideas, and next steps.',
            href: '/projects/' + latestProject._id,
            cta: 'Build Plan'
          }
        : {
            label: 'Review the latest recommendations',
            detail: 'Check what changed and approve the highest-impact work.',
            href: '/projects',
            cta: 'Review Work'
          }));
%>

<div class="app-layout dashboard-layout">
  <aside class="app-sidebar dashboard-sidebar">
    <strong>Workspace</strong>
    <a class="active" href="/dashboard">Dashboard</a>
    <a href="/projects">All Projects</a>
    <a href="/projects/new">+ Add Project</a>

    <span class="sidebar-divider"></span>

    <% if (latestProject) { %>
      <span class="sidebar-section-heading"><%= latestProject.name %></span>
      <a href="<%= latestProjectBase %>">Overview</a>
      <a href="<%= latestProjectBase %>/content">Content Studio</a>
      <a href="<%= latestProjectBase %>/calendar">Content Calendar</a>
      <a href="<%= latestProjectBase %>/integrations/social">Social Accounts</a>
      <a href="<%= latestProjectBase %>/social-performance">Performance</a>
    <% } else { %>
      <span class="sidebar-section-heading">Projects</span>
      <a href="/projects/new">Create First Project</a>
    <% } %>

    <span class="sidebar-divider"></span>

    <span class="sidebar-section-heading">Management</span>
    <a href="/organizations">Agency</a>
    <a href="/billing">Billing</a>
    <a href="/account">Account</a>
  </aside>

  <section class="app-main dashboard-main dashboard-console">
    <section class="dashboard-console-header dashboard-reveal">
      <div>
        <p class="eyebrow">Command center</p>
        <h1>Growth operations</h1>
        <p class="page-subtitle">A live workspace for project status, AI CMO execution, and monthly capacity. Signal coverage scores on this screen are internal progress heuristics, not business outcomes.</p>
      </div>
      <div class="dashboard-next-action">
        <span>Next best action</span>
        <strong><%= nextAction.label %></strong>
        <p><%= nextAction.detail %></p>
        <a class="button button-primary" href="<%= nextAction.href %>"><%= nextAction.cta %></a>
      </div>
    </section>

    <section class="dashboard-kpi-strip dashboard-reveal" aria-label="Workspace metrics">
      <div><span>Projects</span><strong><%= projectCount %>/<%= plan.projectLimit %></strong></div>
      <div><span>Recent scans</span><strong><%= recentScans.length %></strong></div>
      <div><span>AI reports</span><strong><%= recentReports.length %></strong></div>
      <div><span>Social accounts</span><strong><%= socialAccountCount %></strong></div>
      <div><span>Plan</span><strong><%= plan.name %></strong></div>
      <div><span>Signal coverage</span><strong><%= workspaceScore %>%</strong></div>
    </section>

    <section class="panel dashboard-panel workspace-setup-summary dashboard-reveal">
      <div class="panel-title">
        <div>
          <p class="eyebrow">Activation</p>
          <h2>Workspace setup</h2>
          <p class="empty"><%= workspaceSetup.readyProjects %>/<%= workspaceSetup.totalProjects %> project<%= workspaceSetup.totalProjects === 1 ? '' : 's' %> have every launch foundation complete.</p>
        </div>
        <a class="button" href="/projects">Open Projects</a>
      </div>
      <div class="workspace-setup-grid">
        <div class="readiness-panel workspace-setup-score">
          <div class="readiness-meter" style="--score:<%= workspaceSetup.averagePercent %>%">
            <strong><%= workspaceSetup.averagePercent %></strong>
            <span>Setup</span>
          </div>
          <p><%= workspaceSetup.averagePercent >= 85 ? 'Most foundations are in place. Keep clearing the remaining project-specific gaps.' : 'The portfolio still has setup gaps that can slow first customer value.' %></p>
        </div>
        <div class="workspace-blocker-list">
          <strong>Most common gaps</strong>
          <% if (!workspaceSetup.blockers.length) { %>
            <p class="empty">No setup gaps detected.</p>
          <% } else { %>
            <% workspaceSetup.blockers.slice(0, 4).forEach((blocker) => { %>
              <span><%= blocker.count %> missing <%= blocker.label %></span>
            <% }) %>
          <% } %>
        </div>
        <div class="workspace-attention-list">
          <strong>Needs attention</strong>
          <% if (!workspaceSetup.projectsNeedingAttention.length) { %>
            <p class="empty">All active projects have the launch foundations complete.</p>
          <% } else { %>
            <% workspaceSetup.projectsNeedingAttention.forEach((item) => { %>
              <a href="<%= item.nextHref %>">
                <span><%= item.name %></span>
                <small><%= item.percent %>% ready / next: <%= item.nextLabel %></small>
              </a>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>

    <section class="dashboard-ops-grid dashboard-reveal">
      <section class="dashboard-ledger" aria-labelledby="active-projects-title">
        <div class="ledger-header">
          <div>
            <p class="eyebrow">Portfolio</p>
            <h2 id="active-projects-title">Active projects</h2>
          </div>
          <a href="/projects">View all</a>
        </div>
        <% if (!projects.length) { %>
          <p class="empty">No projects yet. Create a business profile to start your AI CMO workspace.</p>
        <% } %>
        <div class="project-ledger-list">
          <% projects.slice(0, 5).forEach((project) => { %>
            <a class="project-ledger-row" href="/projects/<%= project._id %>">
              <span class="ledger-status-dot" aria-hidden="true"></span>
              <span>
                <strong><%= project.name %></strong>
                <small><%= project.websiteUrl %></small>
              </span>
              <span><%= project.industry || 'Business profile' %></span>
              <span><%= project.mainGoal || 'Goal not set' %></span>
            </a>
          <% }) %>
        </div>
      </section>

      <aside class="dashboard-side-rail" aria-label="Workspace queue and usage">
        <section class="readiness-panel">
          <div class="readiness-meter" style="--score:<%= workspaceScore %>%">
            <strong><%= workspaceScore %></strong>
            <span>Coverage</span>
          </div>
          <p><%= hasReports ? 'AI reporting is active. Keep reviewing recommendations weekly.' : (hasScans ? 'Scan data exists. The next step is turning it into an AI CMO plan.' : 'Start with a project and a scan to unlock useful recommendations.') %></p>
        </section>

        <section class="queue-panel">
          <div class="rail-title">
            <h2>Work queue</h2>
            <a href="/projects">Open projects</a>
          </div>
          <a href="<%= nextAction.href %>">
            <strong><%= nextAction.label %></strong>
            <span><%= nextAction.detail %></span>
          </a>
          <a href="<%= latestProject ? `${latestProjectBase}/integrations/social` : '/projects/new' %>">
            <strong>Social Accounts</strong>
            <span><%= socialAccountCount %> connected<%= reconnectAccountCount ? `, ${reconnectAccountCount} need reconnecting` : '' %>. Manage LinkedIn, X, Threads, Meta, YouTube, TikTok, and Bluesky publishing access.</span>
          </a>
          <a href="<%= latestProject ? `${latestProjectBase}/content` : '/projects/new' %>">
            <strong>Approval Queue</strong>
            <span><%= approvalQueueCount %> approved post<%= approvalQueueCount === 1 ? '' : 's' %> waiting to be scheduled or published.</span>
          </a>
          <a href="<%= latestProject ? `${latestProjectBase}/calendar` : '/projects/new' %>">
            <strong>Content Calendar</strong>
            <span>Review scheduled posts, retry failed jobs, and confirm live publishing status.</span>
          </a>
          <a href="<%= latestProject ? `${latestProjectBase}/social-performance` : '/projects/new' %>">
            <strong>Social Performance</strong>
            <span>Track published-post results once engagement collection is active.</span>
          </a>
          <a href="/integrations">
            <strong>Search Console</strong>
            <span>Connect organic search evidence for recommendations and reporting.</span>
          </a>
        </section>

        <section class="usage-rail">
          <div class="rail-title">
            <h2>Usage</h2>
            <a href="/billing">Billing</a>
          </div>
          <div class="usage-line"><span>Scans</span><strong><%= usage.scansUsed %>/<%= plan.scansPerMonth %></strong><b style="--p:<%= scanPct %>%"></b></div>
          <div class="usage-line"><span>AI reports</span><strong><%= usage.aiReportsUsed %>/<%= plan.aiReportsPerMonth %></strong><b style="--p:<%= reportPct %>%"></b></div>
          <div class="usage-line"><span>Content drafts</span><strong><%= usage.contentDraftsUsed %>/<%= plan.contentDraftsPerMonth %></strong><b style="--p:<%= contentPct %>%"></b></div>
          <div class="usage-line"><span>Social posts</span><strong><%= usage.socialPostsUsed || 0 %>/<%= socialPostLimit %></strong><b style="--p:<%= socialPct %>%"></b></div>
          <div class="usage-line"><span>GSC syncs</span><strong><%= usage.searchConsoleSyncsUsed %></strong><b style="--p:18%"></b></div>
        </section>

        <section class="queue-panel">
          <div class="rail-title">
            <h2>Setup tutorials</h2>
            <a href="/docs#setup-tutorials">Open guide</a>
          </div>
          <a href="/docs#setup-tutorials">
            <strong>Connect Search Console</strong>
            <span>Verify a property, sign in with the right Google account, and refresh the workspace with real search data.</span>
          </a>
          <a href="/docs#setup-tutorials">
            <strong>Set up social accounts</strong>
            <span>Connect LinkedIn, X, Meta, Threads, TikTok, YouTube, or Bluesky and grant the needed publishing scopes.</span>
          </a>
          <a href="/docs#setup-tutorials">
            <strong>Enable tracking</strong>
            <span>Install the tracking script and define conversion goals so the dashboard can measure outcomes.</span>
          </a>
          <a href="/docs#setup-tutorials">
            <strong>Review billing</strong>
            <span>Check plan limits, usage, and upgrade readiness before handing the workspace to a customer or team.</span>
          </a>
        </section>
      </aside>
    </section>

    <section class="history-grid dashboard-reveal">
      <section class="panel dashboard-panel">
        <div class="panel-title">
          <h2>Recent scans</h2>
          <a href="/projects">Open projects</a>
        </div>
        <% if (!recentScans.length) { %>
          <p class="empty">No scans yet. Open a project and run the first website scan.</p>
        <% } %>
        <div class="scan-list">
          <% recentScans.forEach((scan) => { const scanProject = scanProjectMap.get(scan.projectId.toString()); %>
            <% if (scanProject) { %>
              <a class="scan-row" href="/projects/<%= scanProject._id %>/scans/<%= scan._id %>">
                <strong><%= scanProject.name %></strong>
                <span><%= scan.status %></span>
                <span><%= scan.pagesScanned %> pages</span>
                <span><%= scan.createdAt.toLocaleString() %></span>
              </a>
            <% } %>
          <% }) %>
        </div>
      </section>

      <section class="panel dashboard-panel">
        <div class="panel-title">
          <h2>AI CMO reports</h2>
          <a href="/projects">Open projects</a>
        </div>
        <% if (!recentReports.length) { %>
          <p class="empty">No AI CMO reports yet.</p>
        <% } %>
        <div class="scan-list">
          <% recentReports.forEach((report) => { const reportProject = scanProjectMap.get(report.projectId.toString()); %>
            <% if (reportProject) { %>
              <a class="scan-row" href="/projects/<%= reportProject._id %>/ai-report/latest">
                <strong><%= reportProject.name %></strong>
                <span><%= report.status %></span>
                <span><%= report.topPriorities.length %> priorities</span>
                <span><%= report.createdAt.toLocaleString() %></span>
              </a>
            <% } %>
          <% }) %>
        </div>
      </section>
    </section>
  </section>
</div>

<%- include('partials/footer') %>
