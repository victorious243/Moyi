<div class="cursor-glow" aria-hidden="true"></div>
<header class="topbar">
  <a class="brand" href="/" aria-label="MOYI-CMO home">
    <img class="brand-logo" src="/images/brand/moyi-mark-64.png" alt="" width="64" height="64">
    <span class="brand-name">MOYI-CMO</span>
  </a>

  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <!-- Universal Notification Center (Mobile & Desktop) -->
    <div class="notification-center-wrap" id="notification-center-wrap">
      <button class="notification-bell-btn" id="notification-bell-btn" type="button" aria-label="View notifications and briefings" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="notification-badge" id="notification-badge" style="display:none;">0</span>
      </button>
      <div class="notification-dropdown" id="notification-dropdown" aria-hidden="true">
        <div class="notification-header">
          <strong>Moyi Intelligence & Alerts</strong>
          <button class="mark-all-read-btn" id="mark-all-read-btn" type="button">Mark all read</button>
        </div>
        <div class="notification-list" id="notification-list">
          <div class="notification-empty">Loading latest updates...</div>
        </div>
      </div>
    </div>
  <% } %>

  <button class="mobile-menu-button" type="button" aria-label="Open navigation menu" aria-controls="mobile-menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="nav desktop-nav">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/organizations">Agency</a>
      <a href="/billing">Billing</a>
      <% if (currentUser.role === 'admin') { %>
      <a href="/admin">Operator</a>
      <% } %>
      <a href="/account">Account</a>
      <form action="/logout" method="post">
        <button class="logout-button" type="submit" title="Sign out" aria-label="Sign out">
          <span class="logout-icon" aria-hidden="true"></span>
          <span>Sign out</span>
        </button>
      </form>
    <% } else { %>
      <a href="/features">Features</a>
      <a href="/solutions/ai-cmo-for-b2b-saas">Solutions</a>
      <a href="/compare/moyi-vs-ahrefs">Compare</a>
      <a href="/pricing">Pricing</a>
      <a href="/docs">Docs</a>
      <a href="/contact">Contact</a>
      <a href="/login">Sign in</a>
      <a class="button button-primary" href="/register">Get Started</a>
    <% } %>
  </nav>

  <nav class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/organizations">Agency</a>
      <a href="/projects/new">Add Project</a>
      <a href="/billing">Billing</a>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin">Operator</a>
      <% } %>
      <a href="/account">Account</a>
      <form action="/logout" method="post">
        <button class="logout-button" type="submit">
          <span class="logout-icon" aria-hidden="true"></span>
          <span>Sign out</span>
        </button>
      </form>
    <% } else { %>
      <a href="/features">Features</a>
      <a href="/solutions/ai-cmo-for-b2b-saas">Solutions</a>
      <a href="/compare/moyi-vs-ahrefs">Compare</a>
      <a href="/pricing">Pricing</a>
      <a href="/docs">Docs</a>
      <a href="/contact">Contact</a>
      <a href="/login">Sign in</a>
      <a class="button button-primary" href="/register">Get Started</a>
    <% } %>
  </nav>
</header>
