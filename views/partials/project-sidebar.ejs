<%
  const currentSection = typeof activeSection !== 'undefined' ? activeSection : '';
  const pid = project && project._id ? project._id : '';
%>

<aside class="app-sidebar project-sidebar">
  <button class="mobile-sidebar-close-button" type="button" aria-label="Close Workspace Navigation Menu" data-sidebar-close>✕</button>

  <% if (project && project.name) { %>
    <strong class="sidebar-project-title"><%= project.name %></strong>
    <a class="sidebar-back-link" href="/dashboard">&larr; Workspace Dashboard</a>
    <span class="sidebar-divider"></span>
  <% } else { %>
    <strong class="sidebar-project-title">Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects">Projects</a>
    <span class="sidebar-divider"></span>
  <% } %>

  <span class="sidebar-section-heading">Strategy & Growth</span>
  <a class="<%= currentSection === 'overview' ? 'active' : '' %>" href="/projects/<%= pid %>">Overview</a>
  <a class="<%= currentSection === 'strategy' ? 'active' : '' %>" href="/projects/<%= pid %>/ai-report/latest">Strategy Brief</a>
  <a class="<%= currentSection === 'recommendations' ? 'active' : '' %>" href="/projects/<%= pid %>/recommendations">Recommendations</a>
  <a class="<%= currentSection === 'competitors' ? 'active' : '' %>" href="/projects/<%= pid %>/competitors">Competitors</a>
  <a class="sidebar-alerts-item <%= currentSection === 'alerts' ? 'active' : '' %>" href="/dashboard?tab=alerts" style="display:flex;align-items:center;justify-content:space-between;">
    <span>Growth Alerts</span>
    <span class="notification-badge sidebar-notif-badge" style="display:none;position:static;margin-left:auto;">0</span>
  </a>

  <span class="sidebar-divider"></span>

  <span class="sidebar-section-heading">Content Studio</span>
  <a class="<%= currentSection === 'content' ? 'active' : '' %>" href="/projects/<%= pid %>/content">Content Studio</a>
  <a class="<%= currentSection === 'calendar' ? 'active' : '' %>" href="/projects/<%= pid %>/calendar">Content Calendar</a>
  <a class="<%= currentSection === 'campaigns' ? 'active' : '' %>" href="/projects/<%= pid %>/campaigns">Campaigns</a>
  <a class="<%= currentSection === 'social' ? 'active' : '' %>" href="/projects/<%= pid %>/integrations/social">Social Accounts</a>

  <span class="sidebar-divider"></span>

  <span class="sidebar-section-heading">Performance & Signals</span>
  <a class="<%= currentSection === 'search-console' ? 'active' : '' %>" href="/projects/<%= pid %>/search-console/performance">Search Console</a>
  <a class="<%= currentSection === 'social-performance' ? 'active' : '' %>" href="/projects/<%= pid %>/social-performance">Social Performance</a>
  <a class="<%= currentSection === 'analytics' ? 'active' : '' %>" href="/projects/<%= pid %>/analytics">Analytics</a>
  <a class="<%= currentSection === 'reports' ? 'active' : '' %>" href="/projects/<%= pid %>/reports">Scans & Reports</a>

  <span class="sidebar-divider"></span>

  <span class="sidebar-section-heading">Settings</span>
  <a class="<%= currentSection === 'tracking' ? 'active' : '' %>" href="/projects/<%= pid %>/tracking/setup">Tracking Setup</a>
  <a class="<%= currentSection === 'team' ? 'active' : '' %>" href="/projects/<%= pid %>/team">Team</a>
  <a class="<%= currentSection === 'settings' ? 'active' : '' %>" href="/projects/<%= pid %>/edit">Project Settings</a>
</aside>
