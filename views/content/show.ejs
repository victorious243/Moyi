<%- include('../partials/header') %>
<%
  const postDraftTypes = ['blog_article', 'comparison_page_draft', 'vs_comparison_article', 'alternatives_list', 'product_led_guide'];
  const execution = draft.executionContext || {};
  const proofPoints = Array.isArray(execution.proofPoints) ? execution.proofPoints : [];
  const evidenceHighlights = Array.isArray(execution.evidenceHighlights) ? execution.evidenceHighlights : [];
  const draftImages = typeof contentImages !== 'undefined' && Array.isArray(contentImages) ? contentImages : [];
  const activeImages = draftImages.filter((image) => image.status !== 'rejected');
  const rejectedImages = draftImages.filter((image) => image.status === 'rejected');
  const selectedImage = activeImages.find((image) => image.status === 'selected') || null;
  const previewImage = selectedImage || activeImages[0] || null;
  const currentImageJob = typeof imageJob !== 'undefined' ? imageJob : null;
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Workspace</strong>
    <a href="/dashboard">Dashboard</a>
    <a href="/projects/<%= project._id %>">Project Overview</a>
    <a href="/projects/<%= project._id %>/content">Execution Queue</a>
    <a href="/projects/<%= project._id %>/recommendations">Recommendations</a>
    <a href="/projects/<%= project._id %>/integrations/wordpress">WordPress</a>
    <a href="/projects/<%= project._id %>/integrations/webflow">Webflow</a>
    <a href="/projects/<%= project._id %>/integrations/shopify">Shopify</a>
    <a href="/projects/<%= project._id %>/calendar">Calendar</a>
  </aside>

  <section
    class="app-main"
    <% if (currentImageJob && (currentImageJob.status === 'queued' || currentImageJob.status === 'running')) { %>
      data-live-job
      data-live-job-endpoint="/projects/<%= project._id %>/jobs/<%= currentImageJob._id %>"
      data-initial-job-status="<%= currentImageJob.status %>"
    <% } %>
  >
    <div class="page-heading">
      <div>
        <p class="eyebrow"><%= draft.type.replace(/_/g, ' ') %></p>
        <h1><%= draft.title || 'Execution asset' %></h1>
      </div>
      <span class="status"><%= draftStatusLabel %></span>
    </div>

    <% if (currentImageJob && (currentImageJob.status === 'queued' || currentImageJob.status === 'running')) { %>
      <section class="panel live-job-panel">
        <h2>Image generation in progress</h2>
        <p>Status: <strong data-job-status><%= currentImageJob.status %></strong></p>
        <p data-job-step><%= currentImageJob.currentStep || 'Waiting for the image worker' %></p>
        <p>Progress: <span data-job-progress><%= currentImageJob.progressPercent || 0 %>%</span> / Last checked at <span data-job-last-checked>just now</span>.</p>
        <p data-job-error-row hidden><span data-job-error></span></p>
      </section>
    <% } %>

    <nav class="content-workflow-nav" aria-label="Content workflow">
      <button type="button" data-workflow-tab="write" aria-controls="workflow-write">
        <span>1</span><strong>Write</strong><small><%= draft.body ? 'Draft ready' : 'Needs content' %></small>
      </button>
      <button type="button" data-workflow-tab="visual" aria-controls="workflow-visual">
        <span>2</span><strong>Visual</strong><small><%= selectedImage ? 'Image selected' : `${activeImages.length} candidates` %></small>
      </button>
      <button type="button" data-workflow-tab="review" aria-controls="workflow-review">
        <span>3</span><strong>Review</strong><small><%= ['approved', 'published_manually'].includes(draft.status) ? 'Approved' : draftStatusLabel %></small>
      </button>
      <button type="button" data-workflow-tab="distribute" aria-controls="workflow-distribute">
        <span>4</span><strong>Distribute</strong><small><%= draft.status === 'published_manually' ? 'Recorded' : (draft.status === 'approved' ? 'Ready' : 'After approval') %></small>
      </button>
    </nav>

    <div class="content-workflow-panel" id="workflow-write" data-workflow-panel="write">
      <div class="workflow-step-heading">
        <div><p class="eyebrow">Step 1 of 4</p><h2>Prepare the message</h2></div>
        <p>Review the evidence, adjust the copy, and save before choosing a visual.</p>
      </div>

    <% if (['meta_title', 'meta_description', 'h1'].includes(draft.type)) { %>
      <section class="before-after-grid">
        <article class="panel">
          <p class="eyebrow">Before</p>
          <h2>Current value</h2>
          <p><%= draft.currentValue || 'No current value captured.' %></p>
        </article>
        <article class="panel">
          <p class="eyebrow">After</p>
          <h2>Generated draft</h2>
          <p><%= draft.body %></p>
          <% if (draft.improvementReason) { %><small><%= draft.improvementReason %></small><% } %>
        </article>
      </section>
    <% } %>

    <section class="before-after-grid">
      <article class="panel">
        <div class="panel-title">
          <div>
            <h2>Execution brief</h2>
            <p class="empty">This asset should stay tied to one ranked opportunity and one clear business outcome.</p>
          </div>
          <% if (execution.sourceRecommendation && execution.sourceRecommendation.priority) { %>
            <span class="status">Priority <%= execution.sourceRecommendation.priority %></span>
          <% } %>
        </div>
        <p><strong>Business goal:</strong> <%= execution.businessGoal || 'Add the goal before approving this asset.' %></p>
        <p><strong>Target persona:</strong> <%= execution.targetPersona || 'Add the target persona before approving this asset.' %></p>
        <p><strong>Search intent:</strong> <%= execution.searchIntent || 'Add the search intent before approving this asset.' %></p>
        <p><strong>Primary CTA:</strong> <%= execution.primaryCta || 'Add the CTA before approving this asset.' %></p>
        <p><strong>Opportunity summary:</strong> <%= execution.opportunitySummary || (recommendation ? recommendation.reason : 'No source recommendation summary available.') %></p>
        <div>
          <strong>Proof points</strong>
          <% if (!proofPoints.length) { %>
            <p class="empty">No proof points captured yet.</p>
          <% } else { %>
            <ul class="clean-list">
              <% proofPoints.forEach((point) => { %>
                <li><%= point %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
        <div>
          <strong>Evidence highlights</strong>
          <% if (!evidenceHighlights.length) { %>
            <p class="empty">No evidence highlights captured yet.</p>
          <% } else { %>
            <ul class="clean-list">
              <% evidenceHighlights.forEach((item) => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </article>

      <article class="panel">
        <div class="panel-title">
          <div>
            <h2>Review state</h2>
            <p class="empty">Publishing stays manual. Review is where quality control happens.</p>
          </div>
          <span class="status"><%= draftStatusLabel %></span>
        </div>
        <% if (draft.reviewNotes) { %>
          <p><strong>Latest review notes:</strong> <%= draft.reviewNotes %></p>
        <% } else { %>
          <p class="empty">No review notes have been added yet.</p>
        <% } %>
        <% if (draft.approvedAt) { %>
          <p><strong>Approved:</strong> <%= draft.approvedAt.toLocaleString() %></p>
        <% } %>
        <% if (draft.lastReviewedAt) { %>
          <p><strong>Last review:</strong> <%= draft.lastReviewedAt.toLocaleString() %></p>
        <% } %>
        <% if (draft.publishedAt) { %>
          <p><strong>Marked published:</strong> <%= draft.publishedAt.toLocaleString() %></p>
        <% } %>
        <p class="empty">
          <% if (draft.status === 'approved') { %>
            This asset cleared review and can move to manual implementation or a safe CMS draft.
          <% } else if (draft.status === 'needs_revision') { %>
            This asset needs another pass before it should return to the approval queue.
          <% } else if (draft.status === 'rejected') { %>
            This asset was rejected and should only be revived if the opportunity still matters.
          <% } else { %>
            This asset is still in the human review queue.
          <% } %>
        </p>
      </article>
    </section>

    <section class="workflow-source-strip">
      <div>
        <span>Source recommendation</span>
        <strong><%= recommendation ? recommendation.title : (execution.sourceRecommendation ? execution.sourceRecommendation.title : 'No source recommendation available') %></strong>
      </div>
      <p><%= recommendation ? recommendation.reason : (execution.sourceRecommendation ? execution.sourceRecommendation.reason : 'This asset has no active recommendation record.') %></p>
    </section>

    <form class="form" action="/content/<%= draft._id %>/update" method="post">
      <section class="panel">
        <div class="panel-title">
          <h2>Editor</h2>
          <button class="button copy-button" type="button" data-copy-target="draft-body">Copy</button>
        </div>
        <label>Keyword <input name="keyword" value="<%= draft.keyword || '' %>"></label>
        <label>Title <input name="title" value="<%= draft.title || '' %>"></label>
        <label>Business goal <input name="businessGoal" value="<%= execution.businessGoal || '' %>"></label>
        <label>Target persona <input name="targetPersona" value="<%= execution.targetPersona || '' %>"></label>
        <label>Search intent <input name="searchIntent" value="<%= execution.searchIntent || '' %>"></label>
        <label>Primary CTA <input name="primaryCta" value="<%= execution.primaryCta || '' %>"></label>
        <label>Proof points <textarea name="proofPoints" rows="6"><%= proofPoints.join('\n') %></textarea></label>
        <label>Body <textarea id="draft-body" name="body" rows="16"><%= draft.body || '' %></textarea></label>
        <% if (draft.type === 'schema_jsonld') { %>
          <label>JSON-LD <textarea name="jsonBody" rows="12"><%= draft.jsonBody ? JSON.stringify(draft.jsonBody, null, 2) : '' %></textarea></label>
        <% } %>
        <button class="button button-primary" type="submit">Save Asset</button>
      </section>
    </form>

      <div class="workflow-step-actions">
        <span>Save changes before continuing.</span>
        <button class="button button-primary" type="button" data-workflow-next="visual">Next: Choose Visual</button>
      </div>
    </div>

    <div class="content-workflow-panel" id="workflow-visual" data-workflow-panel="visual" hidden>
      <div class="workflow-step-heading">
        <div><p class="eyebrow">Step 2 of 4</p><h2>Choose the visual</h2></div>
        <p>Generate or upload candidates, preview them with the message, then select the final image.</p>
      </div>
      <section class="content-image-workspace">
        <div class="panel-title">
          <div>
            <p class="eyebrow">Visual workspace</p>
            <h2>Content image</h2>
          </div>
          <span class="status"><%= selectedImage ? 'Image selected' : `${activeImages.length} candidates` %></span>
        </div>

        <% if (typeof imageError !== 'undefined' && imageError) { %>
          <div class="notice-panel">
            <strong>Image action failed</strong>
            <p><%= imageError %></p>
          </div>
        <% } %>
        <% if (typeof imageSuccess !== 'undefined' && imageSuccess) { %>
          <div class="image-success-message"><%= imageSuccess %></div>
        <% } %>

        <% if (previewImage) { %>
          <section class="post-composition-preview" id="post-composition-preview">
            <div class="post-preview-toolbar">
              <div>
                <p class="eyebrow">Post preview</p>
                <strong>Image and draft together</strong>
              </div>
              <span class="status" data-post-preview-status><%= selectedImage ? 'Selected image' : 'Candidate preview' %></span>
            </div>
            <figure class="post-preview-media">
              <img
                data-post-preview-image
                src="/content/<%= draft._id %>/images/<%= previewImage._id %>/file"
                alt="<%= previewImage.altText || draft.title %>"
              >
              <figcaption data-post-preview-caption <%= previewImage.caption ? '' : 'hidden' %>><%= previewImage.caption || '' %></figcaption>
            </figure>
            <div class="post-preview-copy">
              <p class="post-preview-type"><%= draft.type.replace(/_/g, ' ') %></p>
              <h2><%= draft.title || 'Untitled content' %></h2>
              <div class="post-preview-body"><%- typeof postBodyHtml !== 'undefined' ? postBodyHtml : '' %></div>
              <% if (execution.primaryCta) { %>
                <div class="post-preview-cta">
                  <span>Call to action</span>
                  <strong><%= execution.primaryCta %></strong>
                </div>
              <% } %>
            </div>
          </section>
        <% } %>

        <div class="image-control-grid">
          <form
            class="image-control"
            action="/content/<%= draft._id %>/images/generate<%= typeof csrfToken !== 'undefined' && csrfToken ? `?_csrf=${csrfToken}` : '' %>"
            method="post"
            data-loading-state="Generating a content-matched image"
            data-loading-mode="calm"
            data-loading-domain="<%= draft.title || 'this content asset' %>"
            data-loading-copy="Moyi is creating the image and saving the file. This may take a little longer for logo-based poster designs."
            data-loading-stages="Brief,Reference,Render,Save"
          >
            <div>
              <strong>Generate with Moyi</strong>
              <span class="empty">GPT Image 2 · content-aware · review required</span>
            </div>
            <% if (project.brandLogo && project.brandLogo.storageKey) { %>
              <div class="brand-reference-chip">
                <img src="/projects/<%= project._id %>/logo" alt="">
                <span>Official logo ready. Mention “logo” in the art direction to use it as a reference.</span>
              </div>
            <% } else { %>
              <div class="brand-reference-chip is-empty">
                <span>No project logo uploaded. Add a transparent PNG in project settings before asking Moyi to include the logo.</span>
                <a href="/projects/<%= project._id %>/edit">Add logo</a>
              </div>
            <% } %>
            <label>
              Graphic Design Skill
              <select name="visualFormat">
                <option value="corporate-flyer">🎨 Corporate Marketing Flyer (Grid & Feature Cards)</option>
                <option value="b2b-carousel-slide">📱 Multi-Slide B2B Carousel Deck (2.1x Engagement)</option>
                <option value="3d-device-mockup">💻 3D SaaS Product Mockup (Isometric Glass Frame)</option>
                <option value="data-infographic">📊 Data-Dense Infographic & Matrix (Comparison & Stats)</option>
                <option value="performance-ad-creative">🎯 Direct-Response Performance Ad (Before/After & Trust)</option>
              </select>
            </label>
            <label>
              Aesthetic Theme
              <select name="aestheticTheme">
                <option value="minimalist-saas">Minimalist Enterprise SaaS (Stripe/Linear Dark Slate)</option>
                <option value="fintech-glass">Fintech & Cyber Glass (Frosted Glass & Neon Accents)</option>
                <option value="warm-editorial">Warm Editorial Corporate (McKinsey/HBR Paper & Serif)</option>
                <option value="high-voltage-growth">High-Voltage Growth (Punchy Gradients & Bold Badges)</option>
              </select>
            </label>
            <label>
              Art direction
              <textarea name="guidance" rows="4" maxlength="1500" placeholder="Subject, setting, mood, colors, composition, details to include or avoid"></textarea>
            </label>
            <label>
              Reference image
              <select name="referenceImageId">
                <option value="">Generate from this content only</option>
                <% activeImages.forEach((image) => { %>
                  <option value="<%= image._id %>"><%= image.source %> · <%= image.filename %></option>
                <% }) %>
              </select>
            </label>
            <button class="button button-primary" type="submit"><%= activeImages.length ? 'Generate New Candidate' : 'Generate Content Image' %></button>
          </form>

          <form
            class="image-control"
            id="content-image-upload"
            action="/content/<%= draft._id %>/images/upload<%= typeof csrfToken !== 'undefined' && csrfToken ? `?_csrf=${csrfToken}` : '' %>"
            method="post"
            enctype="multipart/form-data"
          >
            <div>
              <strong>Upload your image</strong>
              <span class="empty">JPG, PNG, or WebP · 10 MB maximum</span>
            </div>
            <label>Image <input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label>
            <label>Alt text <input name="altText" maxlength="240" placeholder="Describe the image for accessibility"></label>
            <label>Caption <input name="caption" maxlength="500" placeholder="Optional visible caption"></label>
            <button class="button" type="submit">Upload Candidate</button>
          </form>
        </div>

        <% if (!activeImages.length) { %>
          <p class="empty">No image candidates yet.</p>
        <% } else { %>
          <div class="content-image-grid">
            <% activeImages.forEach((image) => { %>
              <article class="content-image-candidate <%= image.status === 'selected' ? 'is-selected' : '' %>">
                <img src="/content/<%= draft._id %>/images/<%= image._id %>/file" alt="<%= image.altText || 'Content image candidate' %>">
                <div class="content-image-meta">
                  <div class="panel-title">
                    <span class="status"><%= image.source %></span>
                    <% if (image.status === 'selected') { %><span class="status">Selected</span><% } %>
                  </div>
                  <form class="compact-form" action="/content/<%= draft._id %>/images/<%= image._id %>/update" method="post">
                    <label>Alt text <input name="altText" value="<%= image.altText || '' %>" maxlength="240"></label>
                    <label>Caption <input name="caption" value="<%= image.caption || '' %>" maxlength="500"></label>
                    <button class="button" type="submit">Save Details</button>
                  </form>
                  <div class="status-actions">
                    <button
                      class="button post-preview-button"
                      type="button"
                      data-preview-image="/content/<%= draft._id %>/images/<%= image._id %>/file"
                      data-preview-alt="<%= image.altText || draft.title || 'Content image candidate' %>"
                      data-preview-caption="<%= image.caption || '' %>"
                      data-preview-selected="<%= image.status === 'selected' ? '1' : '0' %>"
                    >Preview with Post</button>
                    <% if (image.status !== 'selected') { %>
                      <form action="/content/<%= draft._id %>/images/<%= image._id %>/select" method="post">
                        <button class="button button-primary" type="submit">Select</button>
                      </form>
                    <% } %>
                    <a class="button" href="/content/<%= draft._id %>/images/<%= image._id %>/file?download=1">Download</a>
                    <form action="/content/<%= draft._id %>/images/<%= image._id %>/reject" method="post">
                      <button class="button" type="submit">Reject</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

        <% if (rejectedImages.length) { %>
          <details class="rejected-image-list">
            <summary><%= rejectedImages.length %> rejected image<%= rejectedImages.length === 1 ? '' : 's' %></summary>
            <div class="status-actions">
              <% rejectedImages.forEach((image) => { %>
                <form action="/content/<%= draft._id %>/images/<%= image._id %>/restore" method="post">
                  <button class="button" type="submit">Restore <%= image.filename %></button>
                </form>
              <% }) %>
            </div>
          </details>
        <% } %>
      </section>
      <div class="workflow-step-actions">
        <button class="button" type="button" data-workflow-next="write">Back: Write</button>
        <span><%= selectedImage ? 'Final image selected.' : 'You can continue without an image or select one now.' %></span>
        <button class="button button-primary" type="button" data-workflow-next="review">Next: Review</button>
      </div>
    </div>

    <div class="content-workflow-panel" id="workflow-review" data-workflow-panel="review" hidden>
      <div class="workflow-step-heading">
        <div><p class="eyebrow">Step 3 of 4</p><h2>Review the final asset</h2></div>
        <p>Confirm the message and visual are ready, leave notes, then approve or request changes.</p>
      </div>

      <section class="final-review-summary">
        <% if (selectedImage) { %>
          <img src="/content/<%= draft._id %>/images/<%= selectedImage._id %>/file" alt="<%= selectedImage.altText || draft.title %>">
        <% } else { %>
          <div class="final-review-no-image"><strong>No image selected</strong><span>The content can still be approved without one.</span></div>
        <% } %>
        <div>
          <p class="eyebrow"><%= draft.type.replace(/_/g, ' ') %></p>
          <h2><%= draft.title || 'Untitled content' %></h2>
          <div class="final-review-copy"><%- typeof postBodyHtml !== 'undefined' ? postBodyHtml : '' %></div>
        </div>
      </section>

      <section class="panel review-decision-panel">
        <div class="panel-title">
          <div><h2>Decision</h2><p class="empty">Approval unlocks distribution. Nothing is automatically published.</p></div>
          <span class="status"><%= draftStatusLabel %></span>
        </div>
        <form class="form review-actions-form" action="/content/<%= draft._id %>/approve" method="post">
          <label>Review notes <textarea name="reviewNotes" rows="5" placeholder="Record changes, checks, or approval context"><%= draft.reviewNotes || '' %></textarea></label>
          <div class="status-actions">
            <% if (['needs_revision', 'rejected'].includes(draft.status)) { %>
              <button class="button" formaction="/content/<%= draft._id %>/submit-for-review" type="submit">Return to Review</button>
            <% } %>
            <% if (draft.status !== 'approved' && draft.status !== 'published_manually') { %>
              <button class="button" formaction="/content/<%= draft._id %>/request-revision" type="submit">Request Changes</button>
              <button class="button button-primary" type="submit">Approve and Continue</button>
              <button class="button" formaction="/content/<%= draft._id %>/reject" type="submit">Reject</button>
            <% } else { %>
              <span class="workflow-approved-message">Approved and ready for distribution.</span>
            <% } %>
          </div>
        </form>
      </section>

      <div class="workflow-step-actions">
        <button class="button" type="button" data-workflow-next="visual">Back: Visual</button>
        <% if (['approved', 'published_manually'].includes(draft.status)) { %>
          <button class="button button-primary" type="button" data-workflow-next="distribute">Next: Distribute</button>
        <% } else { %>
          <span>Approve this asset to unlock distribution.</span>
        <% } %>
      </div>
    </div>

    <div class="content-workflow-panel" id="workflow-distribute" data-workflow-panel="distribute" hidden>
      <div class="workflow-step-heading">
        <div><p class="eyebrow">Step 4 of 4</p><h2>Choose where it goes</h2></div>
        <p>Create channel drafts, send an approved CMS draft, export, or record work published elsewhere.</p>
      </div>

      <% if (publishError) { %>
        <section class="panel notice-panel">
          <h2>Publish failed</h2>
          <p class="empty"><%= publishError %></p>
        </section>
      <% } %>

      <% if (publishSuccess) { %>
        <section class="panel">
          <h2>Publish action complete</h2>
          <p class="empty"><%= publishSuccess %></p>
        </section>
      <% } %>

      <% if (webhookStatus === 'sent') { %>
        <section class="panel">
          <h2>Webhook delivered</h2>
          <p class="empty">The approved draft was sent to the project webhook endpoint.</p>
        </section>
      <% } %>

      <% if (webhookStatus === 'failed') { %>
        <section class="panel notice-panel">
          <h2>Webhook delivery failed</h2>
          <p class="empty">The draft was approved, but the external webhook endpoint did not accept the payload. Check the endpoint logs and signature verification.</p>
        </section>
      <% } %>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>CMS publishing</h2>
          <p class="empty">Publishing stays minimal and safe. Only approved article-style assets can be sent as drafts.</p>
        </div>
        <span class="status">CMS</span>
      </div>

      <div class="status-actions">
        <% if (draft.status === 'approved' && postDraftTypes.includes(draft.type) && wordpressIntegration) { %>
          <form action="/content/<%= draft._id %>/publish/wordpress-draft" method="post">
            <button class="button button-primary" type="submit">Create WordPress Draft</button>
          </form>
        <% } %>
        <% if (draft.status === 'approved' && postDraftTypes.includes(draft.type) && webflowIntegration) { %>
          <form action="/content/<%= draft._id %>/publish/webflow-draft" method="post">
            <button class="button button-primary" type="submit">Create Webflow Draft</button>
          </form>
        <% } %>
        <% if (draft.status === 'approved' && postDraftTypes.includes(draft.type) && shopifyIntegration) { %>
          <form action="/content/<%= draft._id %>/publish/shopify-draft" method="post">
            <button class="button button-primary" type="submit">Create Shopify Draft</button>
          </form>
        <% } %>
        <% if (draft.status === 'approved' && !postDraftTypes.includes(draft.type)) { %>
          <form action="/content/<%= draft._id %>/publish/wordpress-draft" method="post">
            <button class="button" type="submit">Record Export Only</button>
          </form>
        <% } %>
        <button class="button copy-button" type="button" data-copy-target="draft-body">Copy Content</button>
        <button class="button export-button" type="button" data-export-target="draft-body" data-export-title="<%= (draft.title || draft.type).replace(/"/g, '&quot;') %>">Export</button>
        <% if (!wordpressIntegration) { %>
          <a class="button" href="/projects/<%= project._id %>/integrations/wordpress">Connect WordPress</a>
        <% } %>
        <% if (!webflowIntegration) { %>
          <a class="button" href="/projects/<%= project._id %>/integrations/webflow">Connect Webflow</a>
        <% } %>
        <% if (!shopifyIntegration) { %>
          <a class="button" href="/projects/<%= project._id %>/integrations/shopify">Connect Shopify</a>
        <% } %>
      </div>

      <% if (!['approved', 'published_manually'].includes(draft.status)) { %>
        <p class="empty">Approve this asset before sending it to a CMS.</p>
      <% } %>
      <% if (draft.status === 'approved' && !postDraftTypes.includes(draft.type)) { %>
        <p class="empty">This asset is brief or implementation guidance, so it should be copied or exported manually.</p>
      <% } %>
      <% if (draft.status === 'approved' && postDraftTypes.includes(draft.type)) { %>
        <p class="empty">Connected CMS platforms receive this as a draft or unpublished article only. It is not published live.</p>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-title">
        <div>
          <h2>Campaign planning</h2>
          <p class="empty">Create ethical social/email drafts from approved content. Nothing auto-posts.</p>
        </div>
        <a href="/projects/<%= project._id %>/calendar">Open Calendar</a>
      </div>
      <div class="status-actions">
        <% if (['approved', 'published_manually'].includes(draft.status)) { %>
          <form action="/content/<%= draft._id %>/create-social-drafts" method="post">
            <button class="button button-primary" type="submit">Create Social Drafts</button>
          </form>
        <% } %>
        <a class="button" href="/projects/<%= project._id %>/campaigns">Plan Campaign</a>
      </div>
      <% if (!['approved', 'published_manually'].includes(draft.status)) { %>
        <p class="empty">Approve this content draft before creating campaign posts.</p>
      <% } %>
    </section>

    <section class="panel">
      <h2>Publish history</h2>
      <% if (!publishActions.length) { %>
        <p class="empty">No publish or export actions recorded yet.</p>
      <% } else { %>
        <div class="table-scroll">
          <table class="data-table compact-table">
            <thead><tr><th>Integration</th><th>Action</th><th>Status</th><th>External ID</th><th>Error</th><th>Date</th></tr></thead>
            <tbody>
              <% publishActions.forEach((action) => { %>
                <tr>
                  <td><%= action.integrationType %></td>
                  <td><%= action.actionType.replace(/_/g, ' ') %></td>
                  <td><span class="status"><%= action.status %></span></td>
                  <td><%= action.externalId || '-' %></td>
                  <td><%= action.errorMessage || '-' %></td>
                  <td><%= action.createdAt.toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

      <% if (draft.status === 'approved') { %>
        <section class="manual-publication-band">
          <div><strong>Already published somewhere else?</strong><span>Record it in Moyi after the external publication is complete.</span></div>
          <form action="/content/<%= draft._id %>/mark-published" method="post">
            <button class="button" type="submit">Record Manual Publication</button>
          </form>
        </section>
      <% } %>

      <div class="workflow-step-actions">
        <button class="button" type="button" data-workflow-next="review">Back: Review</button>
        <a class="button button-primary" href="/projects/<%= project._id %>/calendar">Open Content Calendar</a>
      </div>
    </div>
  </section>
</div>

<script>
  const workflowNav = document.querySelector('.content-workflow-nav');
  const workflowTabs = Array.from(document.querySelectorAll('[data-workflow-tab]'));
  const workflowPanels = Array.from(document.querySelectorAll('[data-workflow-panel]'));
  const workflowSteps = new Set(['write', 'visual', 'review', 'distribute']);

  function showWorkflowStep(step, updateUrl = true, scroll = false) {
    if (!workflowSteps.has(step)) return;
    workflowPanels.forEach((panel) => {
      panel.hidden = panel.dataset.workflowPanel !== step;
    });
    workflowTabs.forEach((tab) => {
      const active = tab.dataset.workflowTab === step;
      tab.classList.toggle('is-active', active);
      if (active) tab.setAttribute('aria-current', 'step');
      else tab.removeAttribute('aria-current');
    });
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('workspace', step);
      window.history.replaceState({}, '', url);
    }
    if (scroll && workflowNav) workflowNav.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  workflowTabs.forEach((tab) => {
    tab.addEventListener('click', () => showWorkflowStep(tab.dataset.workflowTab, true, true));
  });
  document.querySelectorAll('[data-workflow-next]').forEach((button) => {
    button.addEventListener('click', () => showWorkflowStep(button.dataset.workflowNext, true, true));
  });
  showWorkflowStep('<%= typeof workspaceStep !== 'undefined' ? workspaceStep : 'write' %>', false);

  document.querySelectorAll('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const target = document.getElementById(button.dataset.copyTarget);
      if (!target) return;
      await navigator.clipboard.writeText(target.value || target.textContent || '');
      button.textContent = 'Copied';
      setTimeout(() => { button.textContent = 'Copy'; }, 1200);
    });
  });

  document.querySelectorAll('.export-button').forEach((button) => {
    button.addEventListener('click', () => {
      const target = document.getElementById(button.dataset.exportTarget);
      if (!target) return;
      const filename = `${button.dataset.exportTitle || 'content-draft'}.txt`
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
      const blob = new Blob([target.value || target.textContent || ''], { type: 'text/plain' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `${filename || 'content-draft'}.txt`;
      link.click();
      URL.revokeObjectURL(link.href);
    });
  });

  const uploadForm = document.getElementById('content-image-upload');
  if (uploadForm) {
    uploadForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = uploadForm.querySelector('button[type="submit"]');
      const csrfInput = uploadForm.querySelector('input[name="_csrf"]');
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Uploading...';
      }
      try {
        const response = await fetch(uploadForm.action, {
          method: 'POST',
          body: new FormData(uploadForm),
          headers: csrfInput ? { 'x-csrf-token': csrfInput.value } : {}
        });
        window.location.assign(response.url);
      } catch (error) {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Upload Candidate';
        }
      }
    });
  }

  const postPreview = document.getElementById('post-composition-preview');
  const previewImage = postPreview ? postPreview.querySelector('[data-post-preview-image]') : null;
  const previewCaption = postPreview ? postPreview.querySelector('[data-post-preview-caption]') : null;
  const previewStatus = postPreview ? postPreview.querySelector('[data-post-preview-status]') : null;
  document.querySelectorAll('.post-preview-button').forEach((button) => {
    button.addEventListener('click', () => {
      if (!previewImage) return;
      previewImage.src = button.dataset.previewImage;
      previewImage.alt = button.dataset.previewAlt || 'Content image preview';
      if (previewCaption) {
        previewCaption.textContent = button.dataset.previewCaption || '';
        previewCaption.hidden = !button.dataset.previewCaption;
      }
      if (previewStatus) {
        previewStatus.textContent = button.dataset.previewSelected === '1' ? 'Selected image' : 'Candidate preview';
      }
      document.querySelectorAll('.post-preview-button').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
      postPreview.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<%- include('../partials/footer') %>
