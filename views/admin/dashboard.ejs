<%- include('../partials/header') %>

<%
  const nativePublishFailures = typeof failedPublishJobs !== 'undefined' ? failedPublishJobs : [];
  const socialReconnectAccounts = typeof reconnectAccounts !== 'undefined' ? reconnectAccounts : [];
%>

<div class="app-layout">
  <aside class="app-sidebar">
    <strong>Operator</strong>
    <a class="active" href="/admin">Dashboard</a>
    <a href="#intello-daily">Intello Daily Queue</a>
    <a href="/dashboard">Workspace</a>
    <a href="/account">Account</a>
  </aside>

  <section class="app-main">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Platform Operations</p>
        <h1>Operator Dashboard</h1>
      </div>
      <span class="status"><%= health.status %></span>
    </div>

    <section class="metric-grid">
      <article><span>Users</span><strong><%= userCount %></strong></article>
      <article><span>Projects</span><strong><%= projectCount %></strong></article>
      <article><span>AI ops</span><strong><%= usageTotals.aiOperationsUsed %></strong></article>
      <article><span>AI failures</span><strong><%= usageTotals.aiOperationFailures %></strong></article>
    </section>

    <section class="panel notice-panel">
      <div class="panel-title">
        <div>
          <h2>Incident Command</h2>
          <p>Fast operator view for current platform risk.</p>
        </div>
        <span class="status <%= incidentSummary.severity === 'normal' ? 'status-success' : (incidentSummary.severity === 'incident' ? 'publish-status-failed' : '') %>"><%= incidentSummary.severity %></span>
      </div>
      <div class="metric-grid compact-metric-grid">
        <article><span>Open items</span><strong><%= incidentSummary.openItemCount %></strong></article>
        <article><span>Blocking checks</span><strong><%= incidentSummary.blockingChecks.length %></strong></article>
        <article><span>Recent errors</span><strong><%= incidentSummary.recentErrorCount %></strong></article>
        <article><span>Public status</span><strong><%= enterpriseHardening.statusPage.status %></strong></article>
      </div>
      <% if (!incidentSummary.openItems.length) { %>
        <p class="empty">No active incident signals.</p>
      <% } else { %>
        <div class="content-card-grid">
          <% incidentSummary.openItems.forEach((item) => { %>
            <article class="content-card">
              <span class="status"><%= item.type.replace(/_/g, ' ') %></span>
              <strong><%= item.label %></strong>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Intello Daily Operator Approval Queue -->
    <section class="panel" id="intello-daily" style="border: 1px solid rgba(99, 102, 241, 0.35); background: linear-gradient(180deg, rgba(15, 23, 42, 0.9) 0%, rgba(11, 12, 16, 0.95) 100%);">
      <div class="panel-title">
        <div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <h2 style="margin: 0;">🌅 Intello Daily Approval Queue</h2>
            <span style="background: linear-gradient(135deg, #6366f1, #10b981); color: #fff; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 999px; text-transform: uppercase;">Operator Governance</span>
          </div>
          <p>Daily content packages, Swiss-grid carousels, and social suites awaiting human operator review.</p>
        </div>
        <span class="status <%= (typeof intelloDailyQueue !== 'undefined' && intelloDailyQueue.length > 0) ? 'status-connected' : 'status-success' %>">
          <%= (typeof intelloDailyQueue !== 'undefined') ? intelloDailyQueue.length : 0 %> pending
        </span>
      </div>

      <% if (typeof intelloDailyQueue === 'undefined' || !intelloDailyQueue.length) { %>
        <p class="empty">No Intello Daily packages are currently awaiting operator approval. All caught up! 🎉</p>
      <% } else { %>
        <div style="display: grid; gap: 20px; margin-top: 16px;">
          <% intelloDailyQueue.forEach((draft) => { %>
            <article class="panel" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 20px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                <div>
                  <span style="color: #818cf8; font-size: 12px; font-weight: 800; text-transform: uppercase;">Project: <%= draft.projectId ? draft.projectId.name : 'Unknown' %></span>
                  <h3 style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 4px 0;"><%= draft.title %></h3>
                  <span style="color: #94a3b8; font-size: 12px;">Keyword: <strong><%= draft.keyword || 'SEO Opportunity' %></strong> &bull; Created: <%= new Date(draft.createdAt).toLocaleString() %></span>
                </div>
                <div style="display: flex; gap: 8px;">
                  <form action="/admin/intello-daily/<%= draft._id %>/approve" method="post" onsubmit="return confirm('Approve this Intello Daily package for publication/scheduling?');">
                    <button class="button button-primary" type="submit" style="font-size: 12px; padding: 6px 16px; background: #10b981; border-color: #10b981;">&check; Approve & Schedule</button>
                  </form>
                  <form action="/admin/intello-daily/<%= draft._id %>/reject" method="post" onsubmit="return confirm('Reject this Intello Daily draft?');">
                    <button class="button" type="submit" style="font-size: 12px; padding: 6px 14px; color: #ef4444;">&cross; Reject</button>
                  </form>
                  <% if (draft.projectId) { %>
                    <a class="button button-small" href="/projects/<%= draft.projectId._id %>/content" target="_blank">Open Studio &rarr;</a>
                  <% } %>
                </div>
              </div>

              <!-- Content Preview -->
              <div style="background: rgba(11, 12, 16, 0.6); border-radius: 8px; padding: 14px; margin-bottom: 14px; font-size: 13px; color: #cbd5e1; line-height: 1.6; max-height: 120px; overflow-y: auto;">
                <%= draft.body ? draft.body.slice(0, 400) : '' %>...
              </div>

              <!-- Social Suite Preview -->
              <% if (draft.socialDrafts && draft.socialDrafts.length) { %>
                <div style="margin-top: 10px;">
                  <strong style="font-size: 12px; color: #94a3b8; text-transform: uppercase;">Accompanying Social Distribution Suite (<%= draft.socialDrafts.length %> channels):</strong>
                  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 8px;">
                    <% draft.socialDrafts.forEach((social) => { %>
                      <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 6px; padding: 10px; font-size: 12px;">
                        <span style="color: #60a5fa; font-weight: 700; text-transform: uppercase;"><%= social.channel %></span>
                        <p style="color: #cbd5e1; margin: 4px 0 0; line-height: 1.4;"><%= social.body ? social.body.slice(0, 120) : '' %>...</p>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <div class="dashboard-grid">
      <section class="panel">
        <div class="panel-title">
          <div><h2>Security Review</h2><p>Phase 8 trust controls and remaining operator work.</p></div>
          <span class="status"><%= enterpriseHardening.securityReview.needsReviewCount %> review</span>
        </div>
        <div class="content-card-grid">
          <% enterpriseHardening.securityReview.items.forEach((item) => { %>
            <article class="content-card">
              <span class="status <%= item.status === 'implemented' ? 'status-success' : '' %>"><%= item.status.replace(/_/g, ' ') %></span>
              <strong><%= item.title %></strong>
              <p><%= item.detail %></p>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="panel">
        <div class="panel-title">
          <div><h2>Backups & Monitoring</h2><p>Enterprise readiness checklist for operations.</p></div>
          <span class="status"><%= enterpriseHardening.backupMonitoring.needsSetupCount %> setup</span>
        </div>
        <div class="content-card-grid">
          <% enterpriseHardening.backupMonitoring.items.forEach((item) => { %>
            <article class="content-card">
              <span class="status <%= ['configured', 'documented'].includes(item.status) ? 'status-success' : '' %>"><%= item.status.replace(/_/g, ' ') %></span>
              <strong><%= item.title %></strong>
              <p><%= item.detail %></p>
            </article>
          <% }) %>
        </div>
      </section>
    </div>

    <section class="panel notice-panel">
      <div class="panel-title">
        <div><h2>Native Publishing Recovery</h2><p>Jobs waiting for an automatic retry or held for operator review.</p></div>
        <span class="status"><%= nativePublishFailures.length %></span>
      </div>
      <% if (!nativePublishFailures.length) { %>
        <p class="empty">No native publishing jobs need recovery.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Platform</th><th>Client</th><th>Account</th><th>Status</th><th>Attempts</th><th>Error</th><th>Action</th></tr></thead>
            <tbody>
              <% nativePublishFailures.forEach((job) => { %>
                <tr>
                  <td><strong><%= job.platform %></strong></td>
                  <td><%= job.destinationProjectId ? job.destinationProjectId.name : (job.projectId ? job.projectId.name : '') %></td>
                  <td><%= job.accountId ? job.accountId.accountName : '' %></td>
                  <td><span class="status publish-status-<%= job.status %>"><%= job.status.replace(/_/g, ' ') %></span><% if (job.nextRetryAt) { %><br><small><%= new Date(job.nextRetryAt).toLocaleString() %></small><% } %></td>
                  <td><%= job.attempts %>/<%= job.maxAttempts %></td>
                  <td><strong><%= job.failureKind || job.errorCode %></strong><br><small><%= job.errorMessage %></small></td>
                  <td>
                    <% if (['dead_letter', 'failed'].includes(job.status)) { %>
                      <form action="/admin/publish-jobs/<%= job._id %>/retry" method="post" onsubmit="return confirm('<%= job.errorCode === 'provider_outcome_unknown' ? 'The provider outcome is unknown. Check the live account first because retrying could create a duplicate. Continue?' : 'Retry this failed publishing job?' %>');">
                        <button class="button button-small" type="submit">Retry</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel notice-panel">
      <div class="panel-title"><div><h2>Reconnect Required</h2><p>Publishing and metrics stay paused for these accounts until OAuth is completed again.</p></div><span class="status"><%= socialReconnectAccounts.length %></span></div>
      <% if (!socialReconnectAccounts.length) { %>
        <p class="empty">No social accounts need reconnection.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Platform</th><th>Account</th><th>Client</th><th>User</th><th>Detected</th><th>Reason</th><th></th></tr></thead>
            <tbody>
              <% socialReconnectAccounts.forEach((account) => { %>
                <tr>
                  <td><strong><%= account.platform %></strong></td>
                  <td><%= account.accountName %></td>
                  <td><%= account.projectId ? account.projectId.name : '' %></td>
                  <td><%= account.userId ? account.userId.email : '' %></td>
                  <td><%= account.reconnectRequiredAt ? new Date(account.reconnectRequiredAt).toLocaleString() : '' %></td>
                  <td><%= account.statusMessage %></td>
                  <td><% if (account.projectId) { %><a class="button button-small" href="/projects/<%= account.projectId._id %>/integrations/social">Open</a><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-title">
        <h2>User Management</h2>
        <span class="status"><%= activeUsers.length %> recent</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>User</th><th>Role</th><th>Plan</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% activeUsers.forEach((user) => { %>
              <tr>
                <td><%= user.email %></td>
                <td colspan="4">
                  <form class="inline-form" action="/admin/users/<%= user._id %>" method="post">
                    <select name="role">
                      <% ['owner', 'admin', 'member'].forEach((role) => { %>
                        <option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= role %></option>
                      <% }) %>
                    </select>
                    <select name="plan">
                      <% ['free', 'starter', 'pro', 'agency'].forEach((plan) => { %>
                        <option value="<%= plan %>" <%= user.plan === plan ? 'selected' : '' %>><%= plan %></option>
                      <% }) %>
                    </select>
                    <input name="subscriptionStatus" value="<%= user.subscriptionStatus || 'inactive' %>">
                    <button class="button" type="submit">Update</button>
                  </form>
                  <form class="inline-form" action="/admin/users/<%= user._id %>/social-post-credits" method="post">
                    <input type="number" name="credits" min="1" max="10000" placeholder="Extra posts" required>
                    <input name="reason" placeholder="Reason">
                    <button class="button" type="submit">Add Credits</button>
                  </form>
                  <form class="inline-form" action="/admin/users/<%= user._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to permanently delete and ban <%= user.email %>? All associated data will be erased.');">
                    <button class="button danger-button" type="submit">Ban & Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="dashboard-grid">
      <section class="panel">
        <h2>Customer Email</h2>
        <form class="form" action="/admin/email/customer" method="post">
          <label>To <input type="email" name="to" required></label>
          <label>Subject <input name="subject" required></label>
          <label>Heading <input name="heading" required></label>
          <label class="full">Message <textarea name="message" rows="5" required></textarea></label>
          <button class="button button-primary" type="submit">Send Customer Email</button>
        </form>
      </section>

      <section class="panel">
        <h2>Newsletter</h2>
        <form class="form" action="/admin/email/newsletter" method="post">
          <label class="full">Recipients <textarea name="recipients" rows="3" required></textarea></label>
          <label>Subject <input name="subject" required></label>
          <label>Heading <input name="heading" required></label>
          <label class="full">Summary <textarea name="summary" rows="5" required></textarea></label>
          <button class="button button-primary" type="submit">Send Newsletter</button>
        </form>
      </section>
    </div>

    <section class="panel">
      <div class="panel-title">
        <h2>Runtime Health</h2>
        <span class="status"><%= health.blockingChecks && health.blockingChecks.length ? `${health.blockingChecks.length} blocking` : 'ready path' %></span>
      </div>
      <div class="content-card-grid">
        <% Object.keys(health.checks || {}).forEach((key) => { const check = health.checks[key]; %>
          <article class="content-card">
            <span class="status"><%= check.status %></span>
            <strong><%= key.replace(/_/g, ' ') %></strong>
            <p><%= check.detail || '' %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <div class="dashboard-grid">
      <section class="panel">
        <div class="panel-title">
          <h2>Active Jobs</h2>
          <span class="status"><%= runningJobs.length %></span>
        </div>
        <% if (!runningJobs.length) { %>
          <p class="empty">No queued or running jobs.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Type</th><th>Status</th><th>Project</th><th>Step</th></tr></thead>
              <tbody>
                <% runningJobs.forEach((job) => { %>
                  <tr>
                    <td><%= job.type %></td>
                    <td><%= job.status %></td>
                    <td><%= job.projectId ? job.projectId.name : '' %></td>
                    <td><%= job.currentStep || '' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="panel notice-panel">
        <div class="panel-title">
          <h2>Failed Jobs</h2>
          <span class="status"><%= failedJobs.length %></span>
        </div>
        <% if (!failedJobs.length) { %>
          <p class="empty">No failed background jobs.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Type</th><th>Project</th><th>User</th><th>Error</th></tr></thead>
              <tbody>
                <% failedJobs.forEach((job) => { %>
                  <tr>
                    <td><%= job.type %></td>
                    <td><%= job.projectId ? job.projectId.name : '' %></td>
                    <td><%= job.userId ? job.userId.email : '' %></td>
                    <td><%= job.errorMessage || '' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </div>

    <section class="panel notice-panel">
      <div class="panel-title">
        <h2>Failed Publishing</h2>
        <span class="status"><%= failedPublishActions.length %></span>
      </div>
      <% if (!failedPublishActions.length) { %>
        <p class="empty">No failed publishing actions.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Integration</th><th>Project</th><th>Draft</th><th>Error</th><th>Action</th></tr></thead>
            <tbody>
              <% failedPublishActions.forEach((action) => { %>
                <tr>
                  <td><%= action.integrationType %></td>
                  <td><%= action.projectId ? action.projectId.name : '' %></td>
                  <td><%= action.contentDraftId ? action.contentDraftId.title : '' %></td>
                  <td><%= action.errorMessage || '' %></td>
                  <td>
                    <form action="/admin/publish-actions/<%= action._id %>/retry" method="post">
                      <button class="button" type="submit">Retry</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel notice-panel">
      <div class="panel-title">
        <h2>Failed Webhooks</h2>
        <span class="status"><%= failedWebhookDeliveries.length %></span>
      </div>
      <% if (!failedWebhookDeliveries.length) { %>
        <p class="empty">No failed webhook deliveries.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Project</th><th>Draft</th><th>Status</th><th>Error</th><th>Action</th></tr></thead>
            <tbody>
              <% failedWebhookDeliveries.forEach((delivery) => { %>
                <tr>
                  <td><%= delivery.projectId ? delivery.projectId.name : '' %></td>
                  <td><%= delivery.contentDraftId ? delivery.contentDraftId.title : '' %></td>
                  <td><%= delivery.statusCode || '' %></td>
                  <td><%= delivery.errorMessage || '' %></td>
                  <td>
                    <form action="/admin/webhook-deliveries/<%= delivery._id %>/retry" method="post">
                      <button class="button" type="submit">Retry</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-title">
        <h2>Usage This Month</h2>
        <span class="status"><%= new Date(periodStart).toLocaleDateString() %> - <%= new Date(periodEnd).toLocaleDateString() %></span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>User</th><th>Plan</th><th>Scans</th><th>Reports</th><th>Drafts</th><th>Social posts</th><th>Extra credits</th><th>AI ops</th><th>AI failures</th></tr></thead>
          <tbody>
            <% usageRows.forEach((row) => { %>
              <tr>
                <td><%= row.userId ? row.userId.email : row.userId %></td>
                <td><%= row.userId && row.userId.plan ? row.userId.plan : '' %></td>
                <td><%= row.scansUsed || 0 %></td>
                <td><%= row.aiReportsUsed || 0 %></td>
                <td><%= row.contentDraftsUsed || 0 %></td>
                <td><%= row.socialPostsUsed || 0 %></td>
                <td><%= row.extraSocialPostCredits || 0 %></td>
                <td><%= row.aiOperationsUsed || 0 %></td>
                <td><%= row.aiOperationFailures || 0 %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-title">
        <h2>Application Logs</h2>
        <span class="status"><%= recentAppLogs.length %></span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Level</th><th>Status</th><th>Path</th><th>Message</th><th>When</th></tr></thead>
          <tbody>
            <% recentAppLogs.forEach((log) => { %>
              <tr>
                <td><%= log.level %></td>
                <td><%= log.statusCode || '' %></td>
                <td><%= log.path || '' %></td>
                <td><%= log.message %></td>
                <td><%= log.createdAt ? new Date(log.createdAt).toLocaleString() : '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-title">
        <h2>Recent Audit Events</h2>
        <span class="status"><%= recentAuditLogs.length %></span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Event</th><th>Status</th><th>Actor</th><th>Project</th><th>When</th></tr></thead>
          <tbody>
            <% recentAuditLogs.forEach((log) => { %>
              <tr>
                <td><%= log.eventType.replace(/_/g, ' ') %></td>
                <td><%= log.status %></td>
                <td><%= log.actorEmailSnapshot || '' %></td>
                <td><%= log.projectId ? log.projectId.name : '' %></td>
                <td><%= log.createdAt ? new Date(log.createdAt).toLocaleString() : '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</div>

<%- include('../partials/footer') %>
